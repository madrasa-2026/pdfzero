---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');
const sortedTools = tools.sort((a, b) => (a.data.order || 100) - (b.data.order || 100));

const categories = [
  { id: 'all', name: 'All Tools', count: tools.length },
  { id: 'organize', name: 'Organize', count: tools.filter((t) => t.data.category === 'organize').length },
  { id: 'optimize', name: 'Optimize', count: tools.filter((t) => t.data.category === 'optimize').length },
  { id: 'security', name: 'Security', count: tools.filter((t) => t.data.category === 'security').length },
  { id: 'convert', name: 'Convert', count: tools.filter((t) => t.data.category === 'convert').length },
];

const categoryIcons: Record<string, string> = {
  merge: 'M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2',
  compress: 'M19 14l-7 7m0 0l-7-7m7 7V3',
  split: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  rotate: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  lock: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  unlock: 'M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z',
  key: 'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z',
  numbers: 'M7 20l4-16m2 16l4-16M6 9h14M4 15h14',
  image: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  'file-image': 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  'file-text': 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  edit: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
  wrench: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  sparkles: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  contrast: 'M12 3v18a9 9 0 100-18z',
  'book-open': 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  columns: 'M9 4.5v15m6-15v15m-10.5-15h15a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5h-15a1.5 1.5 0 01-1.5-1.5v-12a1.5 1.5 0 011.5-1.5z',
  scissors: 'M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879a3 3 0 11-4.242-4.242 3 3 0 014.242 0zM12 12L9.121 9.121a3 3 0 10-4.242 4.242 3 3 0 004.242 0z',
  bookmark: 'M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z',
  layout: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 11a1 1 0 011-1h14a1 1 0 011 1v8a1 1 0 01-1 1H5a1 1 0 01-1-1v-8z',
  maximize: 'M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5',
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  zap: 'M13 10V3L4 14h7v7l9-11h-7z',
  'refresh-cw': 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  'volume-2': 'M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 4.663 12 5.109 12 6v12c0 .891-1.077 1.337-1.707.707L5.586 15z',
  moon: 'M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z',
  layers: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  table: 'M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  grid: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'AirPDF',
  'url': 'https://airpdf.pages.dev',
  'description': 'Free client-side PDF tools. Merge, compress, split, and convert PDFs directly in your browser with zero server uploads.',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': 'https://airpdf.pages.dev/#tools',
    'query-input': 'required name=search_term_string'
  }
};
---

<BaseLayout
  title="AirPDF — 100% Free & Ad-Free In-Browser PDF Tools (Zero Uploads)"
  description="Every PDF tool you need, 100% client-side in your browser. 100% free, 100% ad-free, zero uploads, zero tracking. Merge, compress, split, rotate, convert, and protect PDF documents privately on AirPDF."
>
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} slot="schema" />

  <!-- Hero Section -->
  <section class="relative pt-16 pb-12 sm:pt-24 sm:pb-16 border-b border-slate-200/80 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-[-0.035em] max-w-4xl mx-auto leading-[1.08]">
        Professional PDF tools.<br class="hidden sm:inline" />
        <span class="text-slate-500">Processed entirely on your device.</span>
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Merge, compress, split, and convert documents locally in your browser. 100% free, completely ad-free, no registration, no queues, and zero bytes uploaded to external servers.
      </p>

      <!-- Quick Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/tools/merge-pdf"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-sm text-white bg-slate-900 hover:bg-slate-800 active:scale-[0.98] shadow-button transition duration-150"
        >
          <span>Merge PDF Files</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
        <a
          href="/tools/compress-pdf"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-sm text-slate-700 bg-white hover:bg-slate-50 active:scale-[0.98] border border-slate-200/90 shadow-sm transition duration-150"
        >
          <span>Compress PDF</span>
        </a>
        <a
          href="#tools"
          class="px-4 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:text-slate-900 transition"
        >
          View all tools ↓
        </a>
      </div>
    </div>
  </section>

  <!-- Top Compliant Ad Unit Placeholder -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdSlot format="leaderboard" slotId="top-home" />
  </div>

  <!-- Tools Directory Section -->
  <section id="tools" class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2.5 mb-1">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-[-0.025em]">Tools Directory</h2>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-900 text-white shadow-sm">
            {sortedTools.length} Free Tools
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500">100% private, client-side WebAssembly utilities. Zero cloud uploads.</p>
      </div>

      <!-- Live Search Box -->
      <div class="relative w-full md:w-80">
        <input
          type="text"
          id="tools-search-input"
          placeholder="Filter tools by keyword (e.g. ocr, dark, bates)..."
          class="w-full pl-9 pr-8 py-2.5 bg-white border border-slate-200/90 rounded-xl text-xs font-medium text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-slate-900 shadow-sm transition"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <button type="button" id="clear-search-btn" class="hidden absolute right-3 top-2.5 text-xs text-slate-400 hover:text-slate-700 font-bold p-0.5">
          ✕
        </button>
      </div>
    </div>

    <!-- Category Filter Bar with Counts -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-8 pb-4 border-b border-slate-100">
      <div class="flex flex-wrap items-center gap-1.5 p-1 bg-slate-100 rounded-xl border border-slate-200" id="category-filter-bar">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category-filter={cat.id}
            class={`category-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer select-none flex items-center gap-1.5 ${
              idx === 0
                ? 'bg-slate-900 text-white shadow-sm'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/60'
            }`}
          >
            <span>{cat.name}</span>
            <span class={`cat-badge text-[10px] font-mono px-1.5 py-0.5 rounded-md ${idx === 0 ? 'bg-slate-700 text-white' : 'bg-slate-200 text-slate-600'}`}>
              {cat.count}
            </span>
          </button>
        ))}
      </div>

      <div class="text-xs text-slate-400 font-mono" id="tools-counter">
        Showing <span id="tools-showing-count" class="font-bold text-slate-700">{sortedTools.length}</span> of {sortedTools.length} tools
      </div>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="tools-grid">
      {sortedTools.map((tool) => (
        <a
          href={`/tools/${tool.slug}`}
          data-tool-category={tool.data.category}
          data-tool-search={`${tool.data.title} ${tool.data.shortDescription} ${tool.slug} ${(tool.data.keywords || []).join(' ')}`.toLowerCase()}
          class="group tool-card relative flex flex-col justify-between bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm hover:shadow-panel-hover hover:border-slate-300 transition-all duration-200"
        >
          <div>
            <!-- Card Header & Icon -->
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-slate-900 text-slate-700 group-hover:text-white flex items-center justify-center transition duration-200 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={categoryIcons[tool.data.icon] || categoryIcons.merge} />
                </svg>
              </div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold">
                {tool.data.category}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition mb-1.5">
              {tool.data.title}
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              {tool.data.shortDescription}
            </p>
          </div>

          <!-- Footer Action -->
          <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-400 group-hover:text-slate-700 transition">
            <span>Launch tool</span>
            <span class="transform group-hover:translate-x-1 transition duration-150">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty State for Search / Filter -->
    <div id="no-tools-match" class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200 p-8 my-6">
      <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-slate-800 mb-1">No matching PDF tools found</h3>
      <p class="text-xs text-slate-500 mb-4">Try searching with another keyword or pick a different category.</p>
      <button type="button" id="reset-filter-btn" class="px-4 py-2 bg-slate-900 text-white text-xs font-semibold rounded-lg hover:bg-slate-800 transition">
        Reset Search & Filters
      </button>
    </div>
  </section>

  <!-- Value Proposition: Why Client-Side? -->
  <section class="bg-white border-y border-slate-200/80 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-[-0.025em]">Engineered for Total Data Privacy</h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
          Conventional cloud converters force you to transmit confidential contracts, tax records, and private paperwork across the internet. AirPDF processes everything directly on your device.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">Zero Cloud Uploads</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Your files remain inside your local browser memory sandbox. They are never transmitted over network cables or stored on remote databases.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80">
          <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center font-bold mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">Zero Network Latency</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            No waiting for massive files to transfer across slow connections. Client-side WebAssembly manipulates document streams instantly.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="p-6 rounded-2xl bg-slate-50/70 border border-slate-200/80">
          <div class="w-8 h-8 rounded-lg bg-slate-200 text-slate-800 flex items-center justify-center font-bold mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1.5">Air-Gap Capable</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Once loaded, you can disconnect your computer from WiFi or ethernet, and all PDF tools continue to operate with 100% functionality.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom Ad Unit -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdSlot format="horizontal" slotId="bottom-home" />
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.category-filter-btn');
      const cards = document.querySelectorAll('.tool-card');
      const searchInput = document.getElementById('tools-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      const resetBtn = document.getElementById('reset-filter-btn');
      const showingCountEl = document.getElementById('tools-showing-count');
      const noMatchEl = document.getElementById('no-tools-match');

      let currentCategory = 'all';
      let currentQuery = '';

      function filterTools() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-tool-category');
          const searchData = card.getAttribute('data-tool-search') || '';

          const matchesCat = currentCategory === 'all' || cardCat === currentCategory;
          const matchesQuery = !currentQuery || searchData.includes(currentQuery);

          if (matchesCat && matchesQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (showingCountEl) {
          showingCountEl.textContent = visibleCount.toString();
        }

        if (noMatchEl) {
          if (visibleCount === 0) {
            noMatchEl.classList.remove('hidden');
          } else {
            noMatchEl.classList.add('hidden');
          }
        }
      }

      // Category filter buttons
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCategory = btn.getAttribute('data-category-filter') || 'all';

          buttons.forEach((b) => {
            b.classList.remove('bg-slate-900', 'text-white', 'shadow-sm');
            b.classList.add('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-200/60');
            const badge = b.querySelector('.cat-badge');
            if (badge) {
              badge.classList.remove('bg-slate-700', 'text-white');
              badge.classList.add('bg-slate-200', 'text-slate-600');
            }
          });

          btn.classList.add('bg-slate-900', 'text-white', 'shadow-sm');
          btn.classList.remove('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-200/60');
          const activeBadge = btn.querySelector('.cat-badge');
          if (activeBadge) {
            activeBadge.classList.remove('bg-slate-200', 'text-slate-600');
            activeBadge.classList.add('bg-slate-700', 'text-white');
          }

          filterTools();
        });
      });

      // Search input listener
      searchInput?.addEventListener('input', (e) => {
        currentQuery = (e.target.value || '').trim().toLowerCase();
        if (clearBtn) {
          if (currentQuery.length > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
        filterTools();
      });

      // Clear search button
      clearBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        clearBtn.classList.add('hidden');
        filterTools();
      });

      // Reset all filters button
      resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        clearBtn?.classList.add('hidden');
        currentCategory = 'all';

        buttons.forEach((b) => {
          const isAll = b.getAttribute('data-category-filter') === 'all';
          const badge = b.querySelector('.cat-badge');
          if (isAll) {
            b.classList.add('bg-slate-900', 'text-white', 'shadow-sm');
            b.classList.remove('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-200/60');
            if (badge) {
              badge.classList.remove('bg-slate-200', 'text-slate-600');
              badge.classList.add('bg-slate-700', 'text-white');
            }
          } else {
            b.classList.remove('bg-slate-900', 'text-white', 'shadow-sm');
            b.classList.add('text-slate-600', 'hover:text-slate-900', 'hover:bg-slate-200/60');
            if (badge) {
              badge.classList.remove('bg-slate-700', 'text-white');
              badge.classList.add('bg-slate-200', 'text-slate-600');
            }
          }
        });

        filterTools();
      });
    });
  </script>
</BaseLayout>
