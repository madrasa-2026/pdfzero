---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPlaceholderIsland from '../../components/tools/ToolPlaceholderIsland.astro';
import MergePdfIsland from '../../components/tools/MergePdfIsland.astro';
import CompressPdfIsland from '../../components/tools/CompressPdfIsland.astro';
import SplitPdfIsland from '../../components/tools/SplitPdfIsland.astro';
import RotatePdfIsland from '../../components/tools/RotatePdfIsland.astro';
import PageNumbersIsland from '../../components/tools/PageNumbersIsland.astro';
import JpgToPdfIsland from '../../components/tools/JpgToPdfIsland.astro';
import PdfToJpgIsland from '../../components/tools/PdfToJpgIsland.astro';
import PdfToWordIsland from '../../components/tools/PdfToWordIsland.astro';
import ProtectPdfIsland from '../../components/tools/ProtectPdfIsland.astro';
import UnlockPdfIsland from '../../components/tools/UnlockPdfIsland.astro';
import AdSlot from '../../components/layout/AdSlot.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const { Content } = await tool.render();

// JSON-LD WebApplication schema
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': tool.data.title,
  'url': `https://pdfzero.pages.dev/tools/${tool.slug}`,
  'description': tool.data.description,
  'applicationCategory': 'UtilitiesApplication',
  'operatingSystem': 'Any',
  'isAccessibleForFree': true,
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'USD'
  },
  'featureList': tool.data.howToSteps.map((s) => s.title).join(', ')
};

// JSON-LD FAQPage schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': tool.data.faqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer
    }
  }))
};

// Fetch related tools data
const allTools = await getCollection('tools');
const relatedToolCards = allTools
  .filter((t) => tool.data.relatedTools.includes(t.slug))
  .slice(0, 3);
---

<BaseLayout
  title={tool.data.title}
  description={tool.data.description}
  canonicalUrl={`https://pdfzero.pages.dev/tools/${tool.slug}`}
>
  <!-- Inject Structured Data in schema slot -->
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Top Ad Slot (Compliant, distinct from download buttons) -->
  <div class="max-w-4xl mx-auto px-4 pt-6">
    <AdSlot format="leaderboard" slotId={`tool-top-${tool.slug}`} />
  </div>

  <!-- Main Tool Header & Intro -->
  <section class="max-w-4xl mx-auto px-4 py-8 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200/90 mb-4 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      100% In-Browser · Files Never Uploaded
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-[-0.03em] mb-4 leading-tight">
      {tool.data.title}
    </h1>

    <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
      {tool.data.description}
    </p>

    <!-- Honesty Disclaimer if applicable -->
    {tool.data.disclaimer && (
      <div class="mt-4 max-w-2xl mx-auto p-3.5 bg-amber-50/80 border border-amber-200/90 rounded-xl text-xs text-amber-900 flex items-start gap-2.5 text-left">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span><strong>Note:</strong> {tool.data.disclaimer}</span>
      </div>
    )}

    <!-- Interactive Island Component -->
    {tool.slug === 'merge-pdf' ? (
      <MergePdfIsland />
    ) : tool.slug === 'compress-pdf' ? (
      <CompressPdfIsland />
    ) : tool.slug === 'split-pdf' ? (
      <SplitPdfIsland />
    ) : tool.slug === 'rotate-pdf' ? (
      <RotatePdfIsland />
    ) : tool.slug === 'page-numbers' ? (
      <PageNumbersIsland />
    ) : tool.slug === 'jpg-to-pdf' ? (
      <JpgToPdfIsland />
    ) : tool.slug === 'pdf-to-jpg' ? (
      <PdfToJpgIsland />
    ) : tool.slug === 'pdf-to-word' ? (
      <PdfToWordIsland />
    ) : tool.slug === 'protect-pdf' ? (
      <ProtectPdfIsland />
    ) : tool.slug === 'unlock-pdf' ? (
      <UnlockPdfIsland />
    ) : (
      <ToolPlaceholderIsland toolSlug={tool.slug} toolTitle={tool.data.title} />
    )}
  </section>

  <!-- Mid-Page Ad Slot -->
  <div class="max-w-4xl mx-auto px-4">
    <AdSlot format="horizontal" slotId={`tool-mid-${tool.slug}`} />
  </div>

  <!-- How-To Guide Steps -->
  <section class="max-w-4xl mx-auto px-4 py-12 border-t border-slate-200/80">
    <h2 class="text-2xl font-bold text-slate-900 tracking-[-0.025em] text-center mb-8">
      How to use {tool.data.title}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {tool.data.howToSteps.map((step, index) => (
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm relative">
          <div class="w-7 h-7 rounded-lg bg-slate-900 text-white font-mono font-bold text-xs flex items-center justify-center mb-3 shadow-sm">
            {index + 1}
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1.5">{step.title}</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Deep Explanatory Article & Content -->
  <section class="max-w-4xl mx-auto px-4 py-12 border-t border-slate-200/80">
    <div class="article-content max-w-3xl mx-auto text-slate-700 leading-relaxed">
      <Content />
    </div>
  </section>

  <style is:global>
    .article-content h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: #0f172a;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      letter-spacing: -0.02em;
    }
    .article-content h3:first-child {
      margin-top: 0;
    }
    .article-content p {
      margin-bottom: 1.15rem;
      line-height: 1.75;
      color: #334155;
      font-size: 0.95rem;
    }
    .article-content ul, .article-content ol {
      margin-top: 0.75rem;
      margin-bottom: 1.25rem;
      padding-left: 1.5rem;
    }
    .article-content ul {
      list-style-type: disc;
    }
    .article-content ol {
      list-style-type: decimal;
    }
    .article-content li {
      margin-bottom: 0.5rem;
      line-height: 1.6;
      color: #334155;
      font-size: 0.95rem;
    }
    .article-content strong {
      font-weight: 700;
      color: #0f172a;
    }
  </style>

  <!-- FAQs Section -->
  <section class="max-w-4xl mx-auto px-4 py-12 border-t border-slate-200/80">
    <h2 class="text-2xl font-bold text-slate-900 tracking-[-0.025em] text-center mb-8">
      Frequently Asked Questions
    </h2>

    <div class="space-y-3.5 max-w-3xl mx-auto">
      {tool.data.faqs.map((faq) => (
        <details class="group bg-white rounded-xl border border-slate-200/80 p-5 shadow-sm open:border-blue-400/60 open:shadow transition-all">
          <summary class="font-semibold text-sm text-slate-900 cursor-pointer list-none flex items-center justify-between">
            <span>{faq.question}</span>
            <span class="text-slate-400 group-open:rotate-180 transition transform duration-150 text-xs">▼</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- Related Tools -->
  {relatedToolCards.length > 0 && (
    <section class="max-w-4xl mx-auto px-4 py-12 border-t border-slate-200/80">
      <h2 class="text-xl font-bold text-slate-900 tracking-[-0.02em] text-center mb-6">
        Other Useful PDF Tools
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {relatedToolCards.map((relTool) => (
          <a
            href={`/tools/${relTool.slug}`}
            class="block p-4 rounded-xl bg-white border border-slate-200/80 hover:border-slate-300 hover:shadow-panel-hover transition-all"
          >
            <h4 class="font-bold text-slate-900 text-sm mb-1">{relTool.data.title}</h4>
            <p class="text-xs text-slate-500 line-clamp-2">{relTool.data.shortDescription}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Bottom Ad Slot -->
  <div class="max-w-4xl mx-auto px-4 pb-12">
    <AdSlot format="horizontal" slotId={`tool-bottom-${tool.slug}`} />
  </div>
</BaseLayout>
