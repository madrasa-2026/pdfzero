---
// MergePdfIsland.astro - Interactive client-side PDF merger
---

<div id="merge-island-app" class="w-full max-w-3xl mx-auto my-8 font-sans">
  

  <!-- Error Alert Container -->
  <div id="error-banner" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5" id="error-title">Upload Error</h4>
      <p id="error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active when no files or appending) -->
  <div
    id="drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition shadow-sm hover:shadow-md cursor-pointer group"
  >
    <input
      type="file"
      id="file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
      multiple
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-slate-100 group-hover:bg-slate-900 flex items-center justify-center text-slate-700 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-brand-600 transition">
      Select PDF files
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop multiple PDFs here, or click to browse from your device.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose PDF Files
    </div>

    <div class="mt-6 flex items-center justify-center gap-4 text-xs text-slate-400">
      <span>Cap: Max 100MB per file</span>
      <span>•</span>
      <span>Multi-file support</span>
    </div>
  </div>

  <!-- 2. File Queue Management (Visible once files are chosen) -->
  <div id="queue-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-4 border-b border-slate-200 mb-6">
      <div>
        <h3 class="text-lg font-bold text-slate-900">
          Documents to Merge (<span id="file-count">0</span>)
        </h3>
        <p class="text-xs text-slate-500 mt-0.5">
          Use the arrow buttons to arrange documents in the exact order you want them merged.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <label class="cursor-pointer px-3 py-1.5 rounded-lg text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 transition border border-brand-200">
          <span>+ Add More</span>
          <input type="file" id="add-more-input" class="hidden" accept=".pdf,application/pdf" multiple />
        </label>
        <button
          type="button"
          id="clear-all-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:text-red-600 hover:bg-red-50 transition border border-slate-200"
        >
          Clear All
        </button>
      </div>
    </div>

    <!-- Reorderable List Container -->
    <div id="file-list" class="space-y-2.5 max-h-96 overflow-y-auto pr-1">
      <!-- File cards rendered dynamically via JavaScript -->
    </div>

    <!-- Action Bar -->
    <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-slate-500 text-left">
        <span class="font-medium text-slate-700">Total size:</span> <span id="total-size">0 KB</span>
      </div>

      <button
        type="button"
        id="merge-action-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-xs text-white bg-slate-900 hover:bg-slate-800 active:scale-[0.98] shadow-button disabled:opacity-50 disabled:cursor-not-allowed transition flex items-center justify-center gap-2"
      >
        <span>Merge PDF Files</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 3. Progress State -->
  <div id="progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600">
      <svg class="animate-spin w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
    </div>

    <h3 class="text-lg font-bold text-slate-800 mb-1">Merging Your Documents...</h3>
    <p id="progress-message" class="text-xs text-slate-500 mb-6 font-medium">Processing pages in browser memory...</p>

    <!-- Progress Bar -->
    <div class="w-full max-w-md mx-auto bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200">
      <div id="progress-bar-fill" class="bg-blue-600 h-full w-0 rounded-full transition-all duration-300"></div>
    </div>
    <span id="progress-percent" class="block text-xs font-semibold text-slate-700 mt-2">0%</span>
  </div>

  <!-- 4. Success & Download State -->
  <div id="success-section" class="hidden bg-white rounded-2xl border border-emerald-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
    </div>

    <h3 class="text-2xl font-extrabold text-slate-900 mb-1">PDFs Merged Successfully!</h3>
    <p class="text-sm text-slate-600 mb-6">
      Your combined PDF is ready. Output size: <span id="output-size" class="font-bold text-slate-800">--</span>
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <button
        type="button"
        id="download-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 shadow-md shadow-emerald-500/20 transition flex items-center justify-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download Merged PDF</span>
      </button>

      <button
        type="button"
        id="reset-btn"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition"
      >
        Merge Another Set
      </button>
    </div>
  </div>
</div>

<script>
  import { mergePdfFiles, MAX_FILE_SIZE_BYTES } from '../../lib/pdf/merge';

  let selectedFiles: File[] = [];
  let mergedPdfBlobUrl: string | null = null;

  // DOM Elements
  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const addMoreInput = document.getElementById('add-more-input') as HTMLInputElement;
  const queueSection = document.getElementById('queue-section') as HTMLDivElement;
  const fileList = document.getElementById('file-list') as HTMLDivElement;
  const fileCountEl = document.getElementById('file-count') as HTMLSpanElement;
  const totalSizeEl = document.getElementById('total-size') as HTMLSpanElement;
  const clearAllBtn = document.getElementById('clear-all-btn') as HTMLButtonElement;
  const mergeActionBtn = document.getElementById('merge-action-btn') as HTMLButtonElement;
  const errorBanner = document.getElementById('error-banner') as HTMLDivElement;
  const errorMessage = document.getElementById('error-message') as HTMLParagraphElement;
  const dismissErrorBtn = document.getElementById('dismiss-error') as HTMLButtonElement;

  const progressSection = document.getElementById('progress-section') as HTMLDivElement;
  const progressMessage = document.getElementById('progress-message') as HTMLParagraphElement;
  const progressBarFill = document.getElementById('progress-bar-fill') as HTMLDivElement;
  const progressPercent = document.getElementById('progress-percent') as HTMLSpanElement;

  const successSection = document.getElementById('success-section') as HTMLDivElement;
  const outputSizeEl = document.getElementById('output-size') as HTMLSpanElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function showError(msg: string) {
    if (errorMessage && errorBanner) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function clearError() {
    if (errorBanner) errorBanner.classList.add('hidden');
  }

  dismissErrorBtn?.addEventListener('click', clearError);

  function handleFilesAdded(newFiles: FileList | File[]) {
    clearError();
    const incoming = Array.from(newFiles);

    // Validate 100MB cap per file
    for (const f of incoming) {
      if (f.size > MAX_FILE_SIZE_BYTES) {
        showError(
          `The file "${f.name}" (${formatBytes(f.size)}) exceeds the 100MB in-browser limit. Please select files under 100MB to avoid browser memory crash.`
        );
        return;
      }
    }

    selectedFiles = [...selectedFiles, ...incoming];
    renderQueue();
  }

  function renderQueue() {
    if (selectedFiles.length === 0) {
      dropZone?.classList.remove('hidden');
      queueSection?.classList.add('hidden');
      return;
    }

    dropZone?.classList.add('hidden');
    queueSection?.classList.remove('hidden');
    fileCountEl.textContent = selectedFiles.length.toString();

    const totalBytes = selectedFiles.reduce((acc, f) => acc + f.size, 0);
    totalSizeEl.textContent = formatBytes(totalBytes);

    mergeActionBtn.disabled = selectedFiles.length < 2;

    fileList.innerHTML = '';
    selectedFiles.forEach((file, index) => {
      const card = document.createElement('div');
      card.className = 'flex items-center justify-between p-3.5 bg-slate-50 hover:bg-slate-100/80 rounded-xl border border-slate-200 transition';
      card.dataset.index = index.toString();

      card.innerHTML = `
        <div class="flex items-center gap-3 min-w-0 pr-2">
          <span class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 text-xs font-bold flex items-center justify-center flex-shrink-0">
            ${index + 1}
          </span>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-slate-800 truncate" title="${file.name}">
              ${file.name}
            </p>
            <p class="text-xs text-slate-400">
              ${formatBytes(file.size)}
            </p>
          </div>
        </div>

        <div class="flex items-center gap-1.5 flex-shrink-0">
          <button
            type="button"
            class="move-up-btn w-8 h-8 rounded-lg bg-white border border-slate-200 hover:border-brand-400 hover:text-brand-600 text-slate-600 text-xs font-bold flex items-center justify-center transition disabled:opacity-30 disabled:cursor-not-allowed"
            ${index === 0 ? 'disabled' : ''}
            title="Move Up"
          >
            ↑
          </button>
          <button
            type="button"
            class="move-down-btn w-8 h-8 rounded-lg bg-white border border-slate-200 hover:border-brand-400 hover:text-brand-600 text-slate-600 text-xs font-bold flex items-center justify-center transition disabled:opacity-30 disabled:cursor-not-allowed"
            ${index === selectedFiles.length - 1 ? 'disabled' : ''}
            title="Move Down"
          >
            ↓
          </button>
          <button
            type="button"
            class="remove-btn w-8 h-8 rounded-lg bg-white border border-slate-200 hover:bg-red-50 hover:border-red-300 hover:text-red-600 text-slate-400 text-xs font-bold flex items-center justify-center transition"
            title="Remove File"
          >
            ✕
          </button>
        </div>
      `;

      // Attach button events
      card.querySelector('.move-up-btn')?.addEventListener('click', () => {
        if (index > 0) {
          const temp = selectedFiles[index - 1];
          selectedFiles[index - 1] = selectedFiles[index];
          selectedFiles[index] = temp;
          renderQueue();
        }
      });

      card.querySelector('.move-down-btn')?.addEventListener('click', () => {
        if (index < selectedFiles.length - 1) {
          const temp = selectedFiles[index + 1];
          selectedFiles[index + 1] = selectedFiles[index];
          selectedFiles[index] = temp;
          renderQueue();
        }
      });

      card.querySelector('.remove-btn')?.addEventListener('click', () => {
        selectedFiles.splice(index, 1);
        renderQueue();
      });

      fileList.appendChild(card);
    });
  }

  // File Inputs
  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFilesAdded(target.files);
      target.value = '';
    }
  });

  addMoreInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFilesAdded(target.files);
      target.value = '';
    }
  });

  clearAllBtn?.addEventListener('click', () => {
    selectedFiles = [];
    renderQueue();
  });

  // Drag and Drop
  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.add('border-brand-500', 'bg-brand-50/40');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-brand-500', 'bg-brand-50/40');
    });
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer && e.dataTransfer.files) {
      handleFilesAdded(e.dataTransfer.files);
    }
  });

  // Start Merge Processing
  mergeActionBtn?.addEventListener('click', async () => {
    if (selectedFiles.length < 2) return;

    queueSection.classList.add('hidden');
    progressSection.classList.remove('hidden');
    clearError();

    try {
      const mergedBytes = await mergePdfFiles(selectedFiles, (prog) => {
        progressMessage.textContent = prog.message;
        progressBarFill.style.width = `${prog.percent}%`;
        progressPercent.textContent = `${prog.percent}%`;
      });

      // Create download blob
      const blob = new Blob([mergedBytes], { type: 'application/pdf' });
      if (mergedPdfBlobUrl) URL.revokeObjectURL(mergedPdfBlobUrl);
      mergedPdfBlobUrl = URL.createObjectURL(blob);

      outputSizeEl.textContent = formatBytes(mergedBytes.byteLength);

      // Auto trigger download
      triggerDownload();

      progressSection.classList.add('hidden');
      successSection.classList.remove('hidden');
    } catch (err: any) {
      progressSection.classList.add('hidden');
      queueSection.classList.remove('hidden');
      showError(err.message || 'An unexpected error occurred during merging.');
    }
  });

  function triggerDownload() {
    if (!mergedPdfBlobUrl) return;
    const a = document.createElement('a');
    a.href = mergedPdfBlobUrl;
    a.download = 'airpdf-merged.pdf';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  downloadBtn?.addEventListener('click', triggerDownload);

  resetBtn?.addEventListener('click', () => {
    selectedFiles = [];
    if (mergedPdfBlobUrl) {
      URL.revokeObjectURL(mergedPdfBlobUrl);
      mergedPdfBlobUrl = null;
    }
    successSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });
</script>
