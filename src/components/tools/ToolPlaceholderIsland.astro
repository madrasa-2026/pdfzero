---
interface Props {
  toolSlug: string;
  toolTitle: string;
}

const { toolSlug, toolTitle } = Astro.props;
---

<div id="tool-island-container" class="w-full max-w-3xl mx-auto my-8 bg-white rounded-2xl border-2 border-dashed border-brand-200 hover:border-brand-400 p-8 sm:p-12 text-center shadow-sm hover:shadow-md transition">
  <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-slate-100 group-hover:bg-slate-900 flex items-center justify-center text-slate-700 group-hover:text-white shadow-sm transition">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
    </svg>
  </div>

  <h3 class="text-xl font-bold text-slate-800 mb-2">Upload your PDF file</h3>
  <p class="text-sm text-slate-500 mb-6 max-w-md mx-auto">
    Drag & drop documents here, or click to choose from your device.
  </p>

  <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
    <label class="cursor-pointer inline-flex items-center justify-center px-6 py-3.5 text-base font-semibold text-white bg-brand-600 hover:bg-brand-700 active:bg-brand-800 rounded-xl shadow-sm hover:shadow transition">
      <span>Choose Files</span>
      <input type="file" class="hidden" accept=".pdf,application/pdf" multiple />
    </label>
  </div>

  <!-- Privacy & Cap notices -->
  <div class="mt-8 pt-6 border-t border-slate-100 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-500">
    <span class="inline-flex items-center gap-1.5 text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full font-medium border border-emerald-200/60">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      Files processed in your browser and never uploaded
    </span>
    <span class="text-slate-400">Max size: 100MB per file</span>
  </div>
</div>
