---
// src/components/tools/HtmlToPdfIsland.astro
---

<div class="w-full max-w-5xl mx-auto p-4 sm:p-6 bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl backdrop-blur-md">
  <!-- Header / Action bar -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
        HTML to PDF Converter & Vector Printer
      </h2>
      <p class="text-xs text-slate-400 mt-1">Transform HTML, CSS, and invoice templates into print-ready vector PDF files with zero cloud uploads.</p>
    </div>

    <!-- Template & File Upload Buttons -->
    <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
      <select
        id="template-select"
        class="bg-slate-800 border border-slate-700 text-white text-xs rounded-xl px-3 py-2 focus:ring-1 focus:ring-emerald-500 focus:outline-none"
      >
        <option value="invoice" selected>Template: Commercial Invoice</option>
        <option value="resume">Template: Executive Resume</option>
        <option value="report">Template: Technical Whitepaper</option>
        <option value="blank">Blank Workspace</option>
      </select>

      <label
        class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-xl border border-slate-700 cursor-pointer transition"
      >
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Load .html
        <input id="html-file-input" type="file" accept=".html,.htm,.txt" class="hidden" />
      </label>
    </div>
  </div>

  <!-- Layout Settings Bar -->
  <div class="my-4 p-3 bg-slate-950/60 rounded-xl border border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-xs">
    <div class="flex flex-wrap items-center gap-4">
      <div class="flex items-center gap-2">
        <label for="paper-size" class="text-slate-400 font-medium">Size:</label>
        <select id="paper-size" class="bg-slate-800 border border-slate-700 text-white rounded-lg px-2 py-1 text-xs">
          <option value="a4" selected>A4 (210 × 297 mm)</option>
          <option value="letter">US Letter (8.5 × 11 in)</option>
          <option value="legal">US Legal (8.5 × 14 in)</option>
        </select>
      </div>

      <div class="flex items-center gap-2">
        <label for="orientation" class="text-slate-400 font-medium">Orientation:</label>
        <select id="orientation" class="bg-slate-800 border border-slate-700 text-white rounded-lg px-2 py-1 text-xs">
          <option value="portrait" selected>Portrait</option>
          <option value="landscape">Landscape</option>
        </select>
      </div>

      <div class="flex items-center gap-2">
        <label for="margin-select" class="text-slate-400 font-medium">Margin:</label>
        <select id="margin-select" class="bg-slate-800 border border-slate-700 text-white rounded-lg px-2 py-1 text-xs">
          <option value="none">None (0mm)</option>
          <option value="compact">Compact (10mm)</option>
          <option value="normal" selected>Standard (20mm)</option>
          <option value="wide">Wide (30mm)</option>
        </select>
      </div>

      <label class="flex items-center gap-2 text-slate-300 cursor-pointer">
        <input id="print-bg" type="checkbox" checked class="rounded border-slate-700 text-emerald-500 focus:ring-emerald-500" />
        <span>Print Background Colors</span>
      </label>
    </div>

    <!-- Quick Insert Page Break -->
    <button
      id="insert-break-btn"
      type="button"
      class="text-xs text-emerald-400 hover:text-emerald-300 font-medium transition"
      title="Insert a page break in the HTML"
    >
      + Insert Page Break
    </button>
  </div>

  <!-- Split-Pane Workspace: Code Editor on Left, Live Preview on Right -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 my-4">
    <!-- Left: Code Tabs & Editor -->
    <div class="flex flex-col h-[520px] bg-slate-950 rounded-xl border border-slate-800 overflow-hidden">
      <!-- Tabs -->
      <div class="flex items-center justify-between px-3 py-2 border-b border-slate-800 bg-slate-900/50 text-xs">
        <div class="flex items-center gap-2">
          <button id="tab-html" type="button" class="px-2.5 py-1 rounded bg-slate-800 text-white font-semibold transition">HTML</button>
          <button id="tab-css" type="button" class="px-2.5 py-1 rounded text-slate-400 hover:text-white transition">CSS</button>
        </div>
        <span class="text-[11px] font-mono text-slate-500">Live Sync</span>
      </div>

      <!-- Textareas -->
      <div class="flex-1 relative">
        <textarea
          id="editor-html"
          class="w-full h-full p-3 font-mono text-xs bg-transparent text-emerald-300 resize-none focus:outline-none leading-relaxed"
          spellcheck="false"
          placeholder="Paste or write raw HTML markup here..."
        ></textarea>

        <textarea
          id="editor-css"
          class="hidden w-full h-full p-3 font-mono text-xs bg-transparent text-cyan-300 resize-none focus:outline-none leading-relaxed"
          spellcheck="false"
          placeholder="/* Custom CSS styling */"
        ></textarea>
      </div>
    </div>

    <!-- Right: Sandboxed Live Preview Frame -->
    <div class="flex flex-col h-[520px] bg-slate-950 rounded-xl border border-slate-800 overflow-hidden">
      <div class="flex items-center justify-between px-3 py-2 border-b border-slate-800 bg-slate-900/50 text-xs">
        <span class="text-white font-medium flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Live Print Preview
        </span>
        <span id="preview-aspect-label" class="text-[11px] font-mono text-slate-400">A4 Portrait</span>
      </div>

      <div class="flex-1 bg-slate-900/60 p-4 overflow-auto flex items-start justify-center">
        <!-- Scaled Document Sheet -->
        <div id="preview-sheet" class="w-full max-w-[420px] min-h-[500px] bg-white rounded shadow-2xl overflow-hidden border border-slate-700/50 transition-all">
          <iframe id="preview-frame" sandbox="allow-same-origin" class="w-full h-full min-h-[500px] border-0"></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Export Actions -->
  <div class="pt-4 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-xs text-slate-400 flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>100% Client-Side Engine. Your markup never leaves your browser.</span>
    </div>

    <div class="flex items-center gap-3 w-full sm:w-auto">
      <button
        id="print-vector-btn"
        type="button"
        class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl transition shadow-lg shadow-emerald-900/30"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        Save as Vector PDF
      </button>
    </div>
  </div>

  <!-- Hidden Print Frame -->
  <iframe id="print-sandbox-frame" class="hidden"></iframe>
</div>

<script>
  import {
    generatePrintHtml,
    HTML_TEMPLATES,
    type PaperSize,
    type Orientation,
    type MarginOption
  } from '../../lib/pdf/htmlEngine';

  // Elements
  const templateSelect = document.getElementById('template-select') as HTMLSelectElement;
  const htmlFileInput = document.getElementById('html-file-input') as HTMLInputElement;
  const paperSizeSelect = document.getElementById('paper-size') as HTMLSelectElement;
  const orientationSelect = document.getElementById('orientation') as HTMLSelectElement;
  const marginSelect = document.getElementById('margin-select') as HTMLSelectElement;
  const printBgCheckbox = document.getElementById('print-bg') as HTMLInputElement;
  const insertBreakBtn = document.getElementById('insert-break-btn')!;
  const tabHtml = document.getElementById('tab-html')!;
  const tabCss = document.getElementById('tab-css')!;
  const editorHtml = document.getElementById('editor-html') as HTMLTextAreaElement;
  const editorCss = document.getElementById('editor-css') as HTMLTextAreaElement;
  const previewFrame = document.getElementById('preview-frame') as HTMLIFrameElement;
  const printSandboxFrame = document.getElementById('print-sandbox-frame') as HTMLIFrameElement;
  const previewAspectLabel = document.getElementById('preview-aspect-label')!;
  const printVectorBtn = document.getElementById('print-vector-btn')!;

  // Tab switching
  tabHtml.addEventListener('click', () => {
    tabHtml.className = 'px-2.5 py-1 rounded bg-slate-800 text-white font-semibold transition';
    tabCss.className = 'px-2.5 py-1 rounded text-slate-400 hover:text-white transition';
    editorHtml.classList.remove('hidden');
    editorCss.classList.add('hidden');
  });

  tabCss.addEventListener('click', () => {
    tabCss.className = 'px-2.5 py-1 rounded bg-slate-800 text-white font-semibold transition';
    tabHtml.className = 'px-2.5 py-1 rounded text-slate-400 hover:text-white transition';
    editorCss.classList.remove('hidden');
    editorHtml.classList.add('hidden');
  });

  // Load Initial Template (Invoice)
  editorHtml.value = HTML_TEMPLATES.invoice.html;
  editorCss.value = HTML_TEMPLATES.invoice.css;

  function updatePreview() {
    const paper = paperSizeSelect.value as PaperSize;
    const orient = orientationSelect.value as Orientation;
    const margin = marginSelect.value as MarginOption;
    const printBg = printBgCheckbox.checked;

    previewAspectLabel.textContent = `${paper.toUpperCase()} ${orient.charAt(0).toUpperCase() + orient.slice(1)}`;

    const fullDoc = generatePrintHtml(editorHtml.value, editorCss.value, {
      paperSize: paper,
      orientation: orient,
      margin: margin,
      printBackground: printBg,
      title: 'Document'
    });

    previewFrame.srcdoc = fullDoc;
  }

  // Update on editor input
  let syncTimeout: any;
  function triggerSync() {
    clearTimeout(syncTimeout);
    syncTimeout = setTimeout(updatePreview, 150);
  }

  editorHtml.addEventListener('input', triggerSync);
  editorCss.addEventListener('input', triggerSync);
  paperSizeSelect.addEventListener('change', updatePreview);
  orientationSelect.addEventListener('change', updatePreview);
  marginSelect.addEventListener('change', updatePreview);
  printBgCheckbox.addEventListener('change', updatePreview);

  // Template change
  templateSelect.addEventListener('change', () => {
    const val = templateSelect.value;
    if (val === 'invoice') {
      editorHtml.value = HTML_TEMPLATES.invoice.html;
      editorCss.value = HTML_TEMPLATES.invoice.css;
    } else if (val === 'resume') {
      editorHtml.value = HTML_TEMPLATES.resume.html;
      editorCss.value = HTML_TEMPLATES.resume.css;
    } else if (val === 'report') {
      editorHtml.value = HTML_TEMPLATES.report.html;
      editorCss.value = HTML_TEMPLATES.report.css;
    } else {
      editorHtml.value = '<div style="padding: 20px;">\n  <h1>New Document</h1>\n  <p>Start typing your content here...</p>\n</div>';
      editorCss.value = 'body { font-family: sans-serif; }';
    }
    updatePreview();
  });

  // Load .html file
  htmlFileInput.addEventListener('change', () => {
    const file = htmlFileInput.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (e) => {
      const content = e.target?.result as string;
      editorHtml.value = content;
      updatePreview();
    };
    reader.readAsText(file);
  });

  // Insert page break snippet
  insertBreakBtn.addEventListener('click', () => {
    const snippet = '\n<div class="page-break"></div>\n';
    const start = editorHtml.selectionStart;
    const end = editorHtml.selectionEnd;
    editorHtml.value = editorHtml.value.substring(0, start) + snippet + editorHtml.value.substring(end);
    editorHtml.selectionStart = editorHtml.selectionEnd = start + snippet.length;
    editorHtml.focus();
    updatePreview();
  });

  // Print / Save Vector PDF action
  printVectorBtn.addEventListener('click', () => {
    const paper = paperSizeSelect.value as PaperSize;
    const orient = orientationSelect.value as Orientation;
    const margin = marginSelect.value as MarginOption;
    const printBg = printBgCheckbox.checked;

    const fullDoc = generatePrintHtml(editorHtml.value, editorCss.value, {
      paperSize: paper,
      orientation: orient,
      margin: margin,
      printBackground: printBg,
      title: 'Document'
    });

    const iframeDoc = printSandboxFrame.contentWindow?.document;
    if (iframeDoc) {
      iframeDoc.open();
      iframeDoc.write(fullDoc);
      iframeDoc.close();

      setTimeout(() => {
        printSandboxFrame.contentWindow?.focus();
        printSandboxFrame.contentWindow?.print();
      }, 250);
    }
  });

  // Initial preview render
  updatePreview();
</script>
