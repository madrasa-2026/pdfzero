---
// PdfToJpgIsland.astro - Interactive client-side PDF to JPG/PNG image converter
---

<div id="pdftojpg-island-app" class="w-full max-w-4xl mx-auto my-8 font-sans">
  

  <!-- Error Alert Container -->
  <div id="pdfimg-error-banner" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">Conversion Error</h4>
      <p id="pdfimg-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-pdfimg-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active before file selected) -->
  <div
    id="pdfimg-drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition shadow-sm hover:shadow-md cursor-pointer group"
  >
    <input
      type="file"
      id="pdfimg-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-slate-100 group-hover:bg-slate-900 flex items-center justify-center text-slate-700 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-brand-600 transition">
      Select PDF to convert to images
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop your PDF file here, or click to choose from your device.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose PDF File
    </div>

    <div class="mt-6 flex items-center justify-center gap-4 text-xs text-slate-400">
      <span>Cap: Max 100MB</span>
      <span>•</span>
      <span>Up to 300 DPI</span>
      <span>•</span>
      <span>Instant ZIP download</span>
    </div>
  </div>

  <!-- 2. Settings Section -->
  <div id="pdfimg-settings-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm text-left">
    <!-- Selected File Header -->
    <div class="flex items-center justify-between pb-6 border-b border-slate-200 mb-6">
      <div class="flex items-center gap-3 min-w-0 pr-2">
        <div class="w-10 h-10 rounded-lg bg-brand-100 text-slate-700 flex items-center justify-center flex-shrink-0 font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p id="pdfimg-file-name" class="text-sm font-bold text-slate-900 truncate">document.pdf</p>
          <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-500">
            <span id="pdfimg-file-size">0 KB</span>
            <span>•</span>
            <span id="pdfimg-page-count" class="font-semibold text-slate-700 bg-brand-50 px-2 py-0.5 rounded border border-brand-200">
              0 pages
            </span>
          </div>
        </div>
      </div>

      <button
        type="button"
        id="pdfimg-change-file-btn"
        class="text-xs font-semibold text-slate-500 hover:text-red-600 transition flex-shrink-0"
      >
        Change File
      </button>
    </div>

    <!-- Configuration Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Format Selection -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Image Format
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="pdfimg-format-card flex flex-col p-4 rounded-xl border-2 border-brand-600 bg-brand-50/50 cursor-pointer transition">
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-slate-900 text-sm">JPG</span>
              <input type="radio" name="pdfimg-format" value="jpeg" checked class="text-brand-600 focus:ring-brand-500" />
            </div>
            <span class="text-slate-500 text-xs leading-relaxed">
              Standard photo format. Smaller file size, ideal for web and sharing.
            </span>
          </label>

          <label class="pdfimg-format-card flex flex-col p-4 rounded-xl border border-slate-200 bg-white hover:border-brand-300 cursor-pointer transition">
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-slate-900 text-sm">PNG</span>
              <input type="radio" name="pdfimg-format" value="png" class="text-brand-600 focus:ring-brand-500" />
            </div>
            <span class="text-slate-500 text-xs leading-relaxed">
              Lossless compression. Sharpest text and vector graphics.
            </span>
          </label>
        </div>
      </div>

      <!-- Quality / Resolution Selection -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Resolution (DPI)
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="pdfimg-quality-card flex flex-col p-4 rounded-xl border-2 border-brand-600 bg-brand-50/50 cursor-pointer transition">
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-slate-900 text-sm">Standard (150 DPI)</span>
              <input type="radio" name="pdfimg-quality" value="standard" checked class="text-brand-600 focus:ring-brand-500" />
            </div>
            <span class="text-slate-500 text-xs leading-relaxed">
              Fast rendering, balanced quality and compact file size.
            </span>
          </label>

          <label class="pdfimg-quality-card flex flex-col p-4 rounded-xl border border-slate-200 bg-white hover:border-brand-300 cursor-pointer transition">
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-slate-900 text-sm">High (300 DPI)</span>
              <input type="radio" name="pdfimg-quality" value="high" class="text-brand-600 focus:ring-brand-500" />
            </div>
            <span class="text-slate-500 text-xs leading-relaxed">
              Ultra-crisp resolution for printing and high-res displays.
            </span>
          </label>
        </div>
      </div>
    </div>

    <!-- Packaging Note -->
    <div id="pdfimg-packaging-note" class="mt-6 p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-600 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
      </svg>
      <span id="pdfimg-note-text">Multi-page PDFs will be packaged into a single ZIP archive containing all page images.</span>
    </div>

    <!-- Action Bar -->
    <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-end">
      <button
        type="button"
        id="start-pdfimg-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-xs text-white bg-slate-900 hover:bg-slate-800 active:scale-[0.98] shadow-button transition flex items-center justify-center gap-2"
      >
        <span>Convert to Images & Download</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 3. Progress State -->
  <div id="pdfimg-progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600">
      <svg class="animate-spin w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
    </div>

    <h3 class="text-lg font-bold text-slate-800 mb-1">Converting PDF Pages to Images...</h3>
    <p id="pdfimg-progress-message" class="text-xs text-slate-500 mb-6 font-medium">Rendering canvas pixels in browser...</p>

    <!-- Progress Bar -->
    <div class="w-full max-w-md mx-auto bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200">
      <div id="pdfimg-progress-bar-fill" class="bg-blue-600 h-full w-0 rounded-full transition-all duration-300"></div>
    </div>
    <span id="pdfimg-progress-percent" class="block text-xs font-semibold text-slate-700 mt-2">0%</span>
  </div>

  <!-- 4. Success State -->
  <div id="pdfimg-success-section" class="hidden bg-white rounded-2xl border border-emerald-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
    </div>

    <h3 class="text-2xl font-extrabold text-slate-900 mb-2">Conversion Complete!</h3>
    <p class="text-sm text-slate-600 mb-6">
      File ready for download: <span id="pdfimg-output-info" class="font-bold text-slate-800">--</span>
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <button
        type="button"
        id="pdfimg-download-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 shadow-md shadow-emerald-500/20 transition flex items-center justify-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span id="pdfimg-download-btn-text">Download Images</span>
      </button>

      <button
        type="button"
        id="pdfimg-reset-btn"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition"
      >
        Convert Another Document
      </button>
    </div>
  </div>
</div>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  import { convertPdfToImages, type ImageOutputFormat, type ImageQuality, type ConvertResult } from '../../lib/pdf/pdfToImages';
  import { MAX_FILE_SIZE_BYTES } from '../../lib/pdf/merge';

  if (typeof window !== 'undefined' && !pdfjsLib.GlobalWorkerOptions.workerSrc) {
    pdfjsLib.GlobalWorkerOptions.workerSrc = '/pdf.worker.min.mjs';
  }

  let selectedFile: File | null = null;
  let totalDocPages = 1;
  let activeResult: ConvertResult | null = null;
  let downloadedBlobUrl: string | null = null;

  // DOM Elements
  const dropZone = document.getElementById('pdfimg-drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('pdfimg-file-input') as HTMLInputElement;
  const settingsSection = document.getElementById('pdfimg-settings-section') as HTMLDivElement;
  const fileNameEl = document.getElementById('pdfimg-file-name') as HTMLParagraphElement;
  const fileSizeEl = document.getElementById('pdfimg-file-size') as HTMLSpanElement;
  const pageCountEl = document.getElementById('pdfimg-page-count') as HTMLSpanElement;
  const changeFileBtn = document.getElementById('pdfimg-change-file-btn') as HTMLButtonElement;
  const noteText = document.getElementById('pdfimg-note-text') as HTMLSpanElement;

  const formatCards = document.querySelectorAll('.pdfimg-format-card');
  const formatRadios = document.querySelectorAll<HTMLInputElement>('input[name="pdfimg-format"]');
  const qualityCards = document.querySelectorAll('.pdfimg-quality-card');
  const qualityRadios = document.querySelectorAll<HTMLInputElement>('input[name="pdfimg-quality"]');
  const startBtn = document.getElementById('start-pdfimg-btn') as HTMLButtonElement;

  const errorBanner = document.getElementById('pdfimg-error-banner') as HTMLDivElement;
  const errorMessage = document.getElementById('pdfimg-error-message') as HTMLParagraphElement;
  const dismissErrorBtn = document.getElementById('dismiss-pdfimg-error') as HTMLButtonElement;

  const progressSection = document.getElementById('pdfimg-progress-section') as HTMLDivElement;
  const progressMessage = document.getElementById('pdfimg-progress-message') as HTMLParagraphElement;
  const progressBarFill = document.getElementById('pdfimg-progress-bar-fill') as HTMLDivElement;
  const progressPercent = document.getElementById('pdfimg-progress-percent') as HTMLSpanElement;

  const successSection = document.getElementById('pdfimg-success-section') as HTMLDivElement;
  const outputInfoEl = document.getElementById('pdfimg-output-info') as HTMLSpanElement;
  const downloadBtn = document.getElementById('pdfimg-download-btn') as HTMLButtonElement;
  const downloadBtnText = document.getElementById('pdfimg-download-btn-text') as HTMLSpanElement;
  const resetBtn = document.getElementById('pdfimg-reset-btn') as HTMLButtonElement;

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function showError(msg: string) {
    if (errorMessage && errorBanner) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function clearError() {
    if (errorBanner) errorBanner.classList.add('hidden');
  }

  dismissErrorBtn?.addEventListener('click', clearError);

  // Format selection toggle
  formatRadios.forEach((radio) => {
    radio.addEventListener('change', () => {
      formatCards.forEach((card) => {
        const inp = card.querySelector('input');
        if (inp && inp.checked) {
          card.className = 'pdfimg-format-card flex flex-col p-4 rounded-xl border-2 border-brand-600 bg-brand-50/50 cursor-pointer transition';
        } else {
          card.className = 'pdfimg-format-card flex flex-col p-4 rounded-xl border border-slate-200 bg-white hover:border-brand-300 cursor-pointer transition';
        }
      });
    });
  });

  // Quality selection toggle
  qualityRadios.forEach((radio) => {
    radio.addEventListener('change', () => {
      qualityCards.forEach((card) => {
        const inp = card.querySelector('input');
        if (inp && inp.checked) {
          card.className = 'pdfimg-quality-card flex flex-col p-4 rounded-xl border-2 border-brand-600 bg-brand-50/50 cursor-pointer transition';
        } else {
          card.className = 'pdfimg-quality-card flex flex-col p-4 rounded-xl border border-slate-200 bg-white hover:border-brand-300 cursor-pointer transition';
        }
      });
    });
  });

  async function handleFileSelected(file: File) {
    clearError();
    if (file.size > MAX_FILE_SIZE_BYTES) {
      showError(`The file "${file.name}" (${formatBytes(file.size)}) exceeds the 100MB in-browser limit.`);
      return;
    }

    selectedFile = file;
    fileNameEl.textContent = file.name;
    fileSizeEl.textContent = formatBytes(file.size);

    try {
      const buffer = await file.arrayBuffer();
      const loadingTask = pdfjsLib.getDocument({ data: new Uint8Array(buffer) });
      const pdf = await loadingTask.promise;
      totalDocPages = pdf.numPages;

      pageCountEl.textContent = `${totalDocPages} ${totalDocPages === 1 ? 'page' : 'pages'}`;
      if (totalDocPages === 1) {
        noteText.textContent = 'Single page PDF will be downloaded directly as an individual image file.';
      } else {
        noteText.textContent = `All ${totalDocPages} pages will be packaged into a single ZIP archive containing every page image.`;
      }

      dropZone.classList.add('hidden');
      settingsSection.classList.remove('hidden');
    } catch (err: any) {
      showError(`Could not read PDF document: ${err.message}`);
    }
  }

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFileSelected(target.files[0]);
      target.value = '';
    }
  });

  changeFileBtn?.addEventListener('click', () => {
    selectedFile = null;
    settingsSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  // Drag and drop handlers
  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.add('border-brand-500', 'bg-brand-50/40');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-brand-500', 'bg-brand-50/40');
    });
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      handleFileSelected(e.dataTransfer.files[0]);
    }
  });

  // Execute Conversion
  startBtn?.addEventListener('click', async () => {
    if (!selectedFile) return;

    settingsSection.classList.add('hidden');
    progressSection.classList.remove('hidden');
    clearError();

    const selectedFormat = (document.querySelector('input[name="pdfimg-format"]:checked') as HTMLInputElement)?.value as ImageOutputFormat || 'jpeg';
    const selectedQuality = (document.querySelector('input[name="pdfimg-quality"]:checked') as HTMLInputElement)?.value as ImageQuality || 'standard';

    try {
      const result = await convertPdfToImages(
        selectedFile,
        { format: selectedFormat, quality: selectedQuality },
        (prog) => {
          progressMessage.textContent = prog.message;
          progressBarFill.style.width = `${prog.percent}%`;
          progressPercent.textContent = `${prog.percent}%`;
        }
      );

      activeResult = result;
      if (downloadedBlobUrl) URL.revokeObjectURL(downloadedBlobUrl);
      downloadedBlobUrl = URL.createObjectURL(result.blob);

      outputInfoEl.textContent = `${result.filename} (${formatBytes(result.blob.size)})`;
      downloadBtnText.textContent = result.isZip ? 'Download Images (.ZIP)' : 'Download Image';

      // Auto trigger download
      triggerDownload();

      progressSection.classList.add('hidden');
      successSection.classList.remove('hidden');
    } catch (err: any) {
      progressSection.classList.add('hidden');
      settingsSection.classList.remove('hidden');
      showError(err.message || 'An error occurred during conversion.');
    }
  });

  function triggerDownload() {
    if (!downloadedBlobUrl || !activeResult) return;
    const a = document.createElement('a');
    a.href = downloadedBlobUrl;
    a.download = activeResult.filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  downloadBtn?.addEventListener('click', triggerDownload);

  resetBtn?.addEventListener('click', () => {
    selectedFile = null;
    activeResult = null;
    if (downloadedBlobUrl) {
      URL.revokeObjectURL(downloadedBlobUrl);
      downloadedBlobUrl = null;
    }
    successSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });
</script>
