---
// GrayscalePdfIsland.astro - 100% in-browser PDF Grayscale & Ink Saver Converter
---

<div id="grayscale-island-app" class="w-full max-w-4xl mx-auto my-8 font-sans">
  <!-- Error Alert Container -->
  <div
    id="grayscale-error-banner"
    class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">Conversion Notice</h4>
      <p id="grayscale-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-grayscale-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active before file selection) -->
  <div
    id="grayscale-drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition cursor-pointer group"
  >
    <input
      type="file"
      id="grayscale-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-zinc-100 group-hover:bg-zinc-800 flex items-center justify-center text-zinc-700 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-zinc-900 transition">
      Select PDF to Convert to Grayscale
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop your color PDF here, or click to browse.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose Color PDF
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400">
      <span>100% In-Browser</span>
      <span>•</span>
      <span>Vector Preserving</span>
      <span>•</span>
      <span>Toner & Ink Saver</span>
    </div>
  </div>

  <!-- 2. Configure Conversion Options Card -->
  <div id="grayscale-config-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6 text-left">
    <!-- File Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-zinc-100 text-zinc-800 flex items-center justify-center font-bold text-sm">
          PDF
        </div>
        <div>
          <h4 id="grayscale-file-name" class="font-bold text-slate-900 text-sm truncate max-w-xs sm:max-w-md">document.pdf</h4>
          <p id="grayscale-file-meta" class="text-xs text-slate-500">Detecting document metadata...</p>
        </div>
      </div>
      <button type="button" id="change-grayscale-file-btn" class="text-xs font-medium text-slate-500 hover:text-slate-800 hover:underline">
        Change File
      </button>
    </div>

    <!-- Optimization Profiles -->
    <div>
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-3">
        Select Conversion Profile
      </label>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Standard -->
        <label class="cursor-pointer border-2 border-slate-900 bg-slate-50 rounded-xl p-4 flex flex-col justify-between transition hover:border-slate-800 relative group grayscale-profile-label" data-mode="standard">
          <input type="radio" name="grayscale-mode" value="standard" checked class="sr-only" />
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-sm text-slate-900">Standard Grayscale</span>
            <div class="w-3.5 h-3.5 rounded-full border-2 border-slate-900 flex items-center justify-center profile-indicator">
              <div class="w-2 h-2 rounded-full bg-slate-900"></div>
            </div>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Balanced ITU-R BT.601 luminance weights. Optimal for photos, presentations, and charts.
          </p>
        </label>

        <!-- Eco Ink Saver -->
        <label class="cursor-pointer border-2 border-slate-200 bg-white rounded-xl p-4 flex flex-col justify-between transition hover:border-slate-400 relative group grayscale-profile-label" data-mode="ink-saver">
          <input type="radio" name="grayscale-mode" value="ink-saver" class="sr-only" />
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-sm text-slate-900">Eco Ink Saver</span>
            <div class="w-3.5 h-3.5 rounded-full border-2 border-slate-300 flex items-center justify-center profile-indicator">
              <div class="w-2 h-2 rounded-full bg-transparent"></div>
            </div>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Lightens dark fills by 15% to conserve printer ink and cartridge life without hurting text clarity.
          </p>
        </label>

        <!-- High Contrast -->
        <label class="cursor-pointer border-2 border-slate-200 bg-white rounded-xl p-4 flex flex-col justify-between transition hover:border-slate-400 relative group grayscale-profile-label" data-mode="high-contrast">
          <input type="radio" name="grayscale-mode" value="high-contrast" class="sr-only" />
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-sm text-slate-900">High Contrast B&W</span>
            <div class="w-3.5 h-3.5 rounded-full border-2 border-slate-300 flex items-center justify-center profile-indicator">
              <div class="w-2 h-2 rounded-full bg-transparent"></div>
            </div>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Binarizes text and faded scans into clean black on pure white. Perfect for photocopies and receipts.
          </p>
        </label>
      </div>
    </div>

    <!-- Image Options -->
    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-slate-800 block">Convert Embedded Images</span>
        <span class="text-xs text-slate-500">Desaturates embedded photographs and scans to 8-bit DeviceGray</span>
      </div>
      <input
        type="checkbox"
        id="grayscale-convert-images"
        checked
        class="w-4 h-4 text-slate-900 rounded border-slate-300 focus:ring-slate-900 cursor-pointer"
      />
    </div>

    <!-- Action Button -->
    <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
      <button
        type="button"
        id="execute-grayscale-btn"
        class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-button transition duration-150"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Convert to Grayscale</span>
      </button>
    </div>
  </div>

  <!-- 3. Processing State -->
  <div id="grayscale-progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 shadow-sm text-center space-y-5">
    <div class="w-16 h-16 mx-auto relative flex items-center justify-center">
      <div class="w-16 h-16 rounded-full border-4 border-zinc-200 border-t-zinc-800 animate-spin"></div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-zinc-800 absolute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
    </div>

    <div>
      <h3 class="text-base font-bold text-slate-900 mb-1">Converting to Grayscale...</h3>
      <p id="grayscale-progress-text" class="text-xs text-slate-500">
        Transforming color streams into single-channel DeviceGray...
      </p>
    </div>
  </div>

  <!-- 4. Success & Download State -->
  <div id="grayscale-success-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm text-center space-y-6">
    <div class="w-14 h-14 mx-auto rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <div>
      <h3 class="text-lg font-bold text-slate-900 mb-1">PDF Converted to Grayscale Successfully!</h3>
      <p class="text-xs text-slate-500 max-w-md mx-auto">
        All vector artwork and pages have been desaturated for print toner optimization.
      </p>
    </div>

    <!-- Metrics Details -->
    <div id="grayscale-metrics-container" class="max-w-md mx-auto p-4 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-600 space-y-2 text-left">
      <!-- Injected dynamically -->
    </div>

    <!-- Download Action -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <button
        type="button"
        id="download-grayscale-pdf-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-500 rounded-xl shadow-button transition duration-150"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download Grayscale PDF</span>
      </button>

      <button
        type="button"
        id="convert-another-grayscale-btn"
        class="w-full sm:w-auto px-5 py-3 text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition"
      >
        Convert Another Document
      </button>
    </div>
  </div>
</div>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { convertToGrayscale, type GrayscaleMode } from '../../lib/pdf/grayscale';

  let currentFile: File | null = null;
  let fileBuffer: ArrayBuffer | null = null;
  let convertedPdfBytes: Uint8Array | null = null;
  let selectedMode: GrayscaleMode = 'standard';

  const dropZone = document.getElementById('grayscale-drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('grayscale-file-input') as HTMLInputElement;
  const configSection = document.getElementById('grayscale-config-section') as HTMLDivElement;
  const progressSection = document.getElementById('grayscale-progress-section') as HTMLDivElement;
  const successSection = document.getElementById('grayscale-success-section') as HTMLDivElement;

  const errorBanner = document.getElementById('grayscale-error-banner') as HTMLDivElement;
  const errorMessage = document.getElementById('grayscale-error-message') as HTMLElement;
  const dismissErrorBtn = document.getElementById('dismiss-grayscale-error') as HTMLButtonElement;

  const fileNameLabel = document.getElementById('grayscale-file-name') as HTMLElement;
  const fileMetaLabel = document.getElementById('grayscale-file-meta') as HTMLElement;
  const changeFileBtn = document.getElementById('change-grayscale-file-btn') as HTMLButtonElement;
  const executeBtn = document.getElementById('execute-grayscale-btn') as HTMLButtonElement;
  const convertImagesCheckbox = document.getElementById('grayscale-convert-images') as HTMLInputElement;

  const metricsContainer = document.getElementById('grayscale-metrics-container') as HTMLDivElement;
  const downloadBtn = document.getElementById('download-grayscale-pdf-btn') as HTMLButtonElement;
  const convertAnotherBtn = document.getElementById('convert-another-grayscale-btn') as HTMLButtonElement;
  const profileLabels = document.querySelectorAll('.grayscale-profile-label');

  function showError(msg: string) {
    if (errorMessage && errorBanner) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function hideError() {
    if (errorBanner) {
      errorBanner.classList.add('hidden');
    }
  }

  dismissErrorBtn?.addEventListener('click', hideError);

  // Profile radio toggle styling
  profileLabels.forEach((label) => {
    label.addEventListener('click', () => {
      const mode = (label.getAttribute('data-mode') || 'standard') as GrayscaleMode;
      selectedMode = mode;

      profileLabels.forEach((other) => {
        other.classList.remove('border-slate-900', 'bg-slate-50');
        other.classList.add('border-slate-200', 'bg-white');
        const dot = other.querySelector('.profile-indicator div');
        if (dot) dot.classList.replace('bg-slate-900', 'bg-transparent');
        const circle = other.querySelector('.profile-indicator');
        if (circle) circle.classList.replace('border-slate-900', 'border-slate-300');
      });

      label.classList.remove('border-slate-200', 'bg-white');
      label.classList.add('border-slate-900', 'bg-slate-50');
      const activeDot = label.querySelector('.profile-indicator div');
      if (activeDot) activeDot.classList.replace('bg-transparent', 'bg-slate-900');
      const activeCircle = label.querySelector('.profile-indicator');
      if (activeCircle) activeCircle.classList.replace('border-slate-300', 'border-slate-900');
    });
  });

  async function handleSelectedFile(file: File) {
    if (!file || file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
      showError('Please select a valid PDF file.');
      return;
    }

    hideError();
    currentFile = file;

    try {
      fileBuffer = await file.arrayBuffer();
      const doc = await PDFDocument.load(new Uint8Array(fileBuffer), { ignoreEncryption: true });
      const pages = doc.getPageCount();

      if (fileNameLabel) fileNameLabel.textContent = file.name;
      if (fileMetaLabel) {
        const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
        fileMetaLabel.textContent = `${pages} page${pages === 1 ? '' : 's'} · ${sizeMb} MB`;
      }

      dropZone.classList.add('hidden');
      configSection.classList.remove('hidden');
      successSection.classList.add('hidden');
    } catch (err: any) {
      showError(err?.message || 'Failed to parse PDF document. It may be corrupt or password-protected.');
    }
  }

  fileInput?.addEventListener('change', (e: any) => {
    if (e.target.files && e.target.files[0]) {
      handleSelectedFile(e.target.files[0]);
    }
  });

  changeFileBtn?.addEventListener('click', () => {
    currentFile = null;
    fileBuffer = null;
    convertedPdfBytes = null;
    fileInput.value = '';
    configSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  convertAnotherBtn?.addEventListener('click', () => {
    currentFile = null;
    fileBuffer = null;
    convertedPdfBytes = null;
    fileInput.value = '';
    successSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  executeBtn?.addEventListener('click', async () => {
    if (!fileBuffer || !currentFile) return;

    try {
      configSection.classList.add('hidden');
      progressSection.classList.remove('hidden');

      const shouldConvertImages = convertImagesCheckbox ? convertImagesCheckbox.checked : true;
      const result = await convertToGrayscale(new Uint8Array(fileBuffer), {
        mode: selectedMode,
        lightenPercent: selectedMode === 'ink-saver' ? 15 : 0,
        convertImages: shouldConvertImages,
      });

      convertedPdfBytes = result.convertedBytes;

      if (metricsContainer) {
        metricsContainer.innerHTML = `
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-500">Pages Processed:</span>
            <span class="font-bold text-slate-800">${result.pagesProcessed}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-500">Optimization Profile:</span>
            <span class="font-bold text-slate-800 capitalize">${selectedMode}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-500">Vector Operators Converted:</span>
            <span class="font-bold text-slate-800">${result.vectorOperatorsConverted}</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-500">Embedded Images Desaturated:</span>
            <span class="font-bold text-slate-800">${result.imagesDesaturated}</span>
          </div>
        `;
      }

      progressSection.classList.add('hidden');
      successSection.classList.remove('hidden');
    } catch (err: any) {
      progressSection.classList.add('hidden');
      configSection.classList.remove('hidden');
      showError(err?.message || 'An error occurred during grayscale conversion.');
    }
  });

  downloadBtn?.addEventListener('click', () => {
    if (!convertedPdfBytes || !currentFile) return;

    const blob = new Blob([convertedPdfBytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    const baseName = currentFile.name.replace(/\.pdf$/i, '');
    link.href = url;
    link.download = `${baseName}-grayscale.pdf`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setTimeout(() => URL.revokeObjectURL(url), 10000);
  });
</script>
