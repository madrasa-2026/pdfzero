---
// RemoveWatermarkIsland.astro - 100% client-side PDF Watermark & Stamp Remover
---

<div id="watermark-island-app" class="w-full max-w-4xl mx-auto my-8 font-sans">
  <!-- Error Alert Container -->
  <div
    id="watermark-error-banner"
    class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">Watermark Removal Notice</h4>
      <p id="watermark-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-watermark-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active before file selection) -->
  <div
    id="watermark-drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition cursor-pointer group"
  >
    <input
      type="file"
      id="watermark-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-violet-50 group-hover:bg-violet-600 flex items-center justify-center text-violet-600 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-violet-600 transition">
      Select PDF with Watermark or Stamp
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop your PDF here, or click to choose from your computer.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose PDF Document
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400">
      <span>100% In-Browser</span>
      <span>•</span>
      <span>Zero Rasterization</span>
      <span>•</span>
      <span>Selectable Text Preserved</span>
    </div>
  </div>

  <!-- 2. Configure & Removal Options Card -->
  <div id="watermark-options-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6 text-left">
    <!-- File Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-violet-50 text-violet-600 flex items-center justify-center font-bold text-sm">
          PDF
        </div>
        <div>
          <h4 id="file-name-label" class="font-bold text-slate-900 text-sm truncate max-w-xs sm:max-w-md">filename.pdf</h4>
          <p id="file-meta-label" class="text-xs text-slate-500">Scanning document...</p>
        </div>
      </div>
      <button type="button" id="change-file-btn" class="text-xs font-medium text-slate-500 hover:text-slate-800 hover:underline">
        Change File
      </button>
    </div>

    <!-- Scan Results Card -->
    <div class="p-4 rounded-xl bg-violet-50/70 border border-violet-100 space-y-2.5">
      <div class="flex items-center gap-2 text-violet-900 font-bold text-xs uppercase tracking-wider">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-violet-600" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        <span>Automatic Scanner Diagnosis</span>
      </div>
      <div id="scan-badges-container" class="flex flex-wrap gap-2 text-xs">
        <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-white border border-violet-200 text-violet-800 font-medium">
          Scanning...
        </span>
      </div>
    </div>

    <!-- Removal Options Checkboxes -->
    <div class="space-y-3 pt-2">
      <h5 class="text-xs font-bold uppercase tracking-wider text-slate-700">Select Removal Strategies</h5>

      <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200/90 hover:bg-slate-50/50 cursor-pointer transition">
        <input type="checkbox" id="opt-remove-annots" checked class="mt-0.5 rounded text-violet-600 focus:ring-violet-500 w-4 h-4" />
        <div class="text-xs">
          <span class="font-bold text-slate-800 block mb-0.5">Strip Watermark & Stamp Annotations (Recommended)</span>
          <span class="text-slate-500">Removes dedicated watermark objects, draft stamps, and overlay annotations without altering underlying content.</span>
        </div>
      </label>

      <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200/90 hover:bg-slate-50/50 cursor-pointer transition">
        <input type="checkbox" id="opt-remove-xobjects" checked class="mt-0.5 rounded text-violet-600 focus:ring-violet-500 w-4 h-4" />
        <div class="text-xs">
          <span class="font-bold text-slate-800 block mb-0.5">Detach Background Form XObjects</span>
          <span class="text-slate-500">Strips repeating background watermark templates, diagonal banners, and logo forms referenced in page resources.</span>
        </div>
      </label>

      <div class="p-3.5 rounded-xl border border-slate-200/90 space-y-2.5">
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" id="opt-remove-keywords" checked class="mt-0.5 rounded text-violet-600 focus:ring-violet-500 w-4 h-4" />
          <div class="text-xs">
            <span class="font-bold text-slate-800 block mb-0.5">Filter Specific Watermark Keywords</span>
            <span class="text-slate-500">Safely filters out text watermarks drawn directly into the page streams without affecting body paragraphs.</span>
          </div>
        </label>

        <div id="keywords-input-wrapper" class="pl-7 pt-1 space-y-2">
          <input
            type="text"
            id="custom-keywords-input"
            placeholder="e.g. DRAFT, CONFIDENTIAL, SAMPLE, www.example.com"
            class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-violet-500/20 focus:border-violet-500"
          />
          <div id="suggested-keywords" class="flex flex-wrap gap-1.5 text-xs text-slate-500">
            <!-- Chips injected dynamically -->
          </div>
        </div>
      </div>
    </div>

    <!-- Action Button -->
    <div class="pt-4 flex flex-col sm:flex-row items-center gap-3">
      <button
        type="button"
        id="execute-removal-btn"
        class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-button transition duration-150"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span>Remove Watermark & Clean PDF</span>
      </button>
    </div>
  </div>

  <!-- 3. Processing State -->
  <div id="watermark-progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 shadow-sm text-center space-y-5">
    <div class="w-16 h-16 mx-auto relative flex items-center justify-center">
      <div class="w-16 h-16 rounded-full border-4 border-violet-100 border-t-violet-600 animate-spin"></div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-violet-600 absolute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
      </svg>
    </div>

    <div>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Removing Watermark...</h3>
      <p id="watermark-progress-message" class="text-xs text-slate-500">Parsing content streams and detaching watermark layers...</p>
    </div>
  </div>

  <!-- 4. Success & Download State -->
  <div id="watermark-success-section" class="hidden bg-white rounded-2xl border border-emerald-200 p-6 sm:p-8 shadow-sm text-center space-y-6">
    <div class="w-14 h-14 mx-auto rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <div>
      <h3 class="text-xl font-bold text-slate-900 mb-1">Watermark Cleaned Successfully!</h3>
      <p class="text-xs text-slate-600">Your PDF was cleaned with 100% vector fidelity preserved.</p>
    </div>

    <!-- Diagnostic Details Breakdown -->
    <div class="bg-slate-50 rounded-xl p-4 border border-slate-200/80 text-left space-y-2 max-w-lg mx-auto">
      <div class="flex items-center justify-between text-xs pb-2 border-b border-slate-200">
        <span class="text-slate-500">Pages Processed:</span>
        <span id="res-pages-count" class="font-bold text-slate-800">1</span>
      </div>
      <div class="flex items-center justify-between text-xs pb-2 border-b border-slate-200">
        <span class="text-slate-500">File Size:</span>
        <span id="res-file-size" class="font-bold text-slate-800">100 KB</span>
      </div>
      <div class="text-xs pt-1">
        <span class="text-slate-500 block mb-1">Clean Actions Applied:</span>
        <ul id="res-actions-list" class="space-y-1 text-slate-700 list-disc list-inside text-[11px]">
          <li>Removed watermark annotations</li>
        </ul>
      </div>
    </div>

    <!-- Vector Quality Notice -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      <span>Zero Rasterization — High Quality Vector Text Preserved</span>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <button
        type="button"
        id="download-cleaned-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-button transition duration-150"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download Clean PDF</span>
      </button>

      <button
        type="button"
        id="clean-another-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition duration-150"
      >
        Clean Another PDF
      </button>
    </div>
  </div>
</div>

<script>
  import { detectWatermarks, removeWatermarks, type WatermarkDetectionResult, type WatermarkRemovalResult } from '../../lib/pdf/watermark';

  let currentFile: File | null = null;
  let rawFileBytes: Uint8Array | null = null;
  let detectionResult: WatermarkDetectionResult | null = null;
  let cleanedResultBytes: Uint8Array | null = null;

  const dropZone = document.getElementById('watermark-drop-zone')!;
  const fileInput = document.getElementById('watermark-file-input') as HTMLInputElement;
  const optionsSection = document.getElementById('watermark-options-section')!;
  const progressSection = document.getElementById('watermark-progress-section')!;
  const successSection = document.getElementById('watermark-success-section')!;
  const errorBanner = document.getElementById('watermark-error-banner')!;
  const errorMessage = document.getElementById('watermark-error-message')!;
  const dismissError = document.getElementById('dismiss-watermark-error')!;

  const fileNameLabel = document.getElementById('file-name-label')!;
  const fileMetaLabel = document.getElementById('file-meta-label')!;
  const scanBadgesContainer = document.getElementById('scan-badges-container')!;
  const suggestedKeywordsContainer = document.getElementById('suggested-keywords')!;
  const customKeywordsInput = document.getElementById('custom-keywords-input') as HTMLInputElement;

  const optRemoveAnnots = document.getElementById('opt-remove-annots') as HTMLInputElement;
  const optRemoveXObjects = document.getElementById('opt-remove-xobjects') as HTMLInputElement;
  const optRemoveKeywords = document.getElementById('opt-remove-keywords') as HTMLInputElement;

  const executeBtn = document.getElementById('execute-removal-btn')!;
  const downloadBtn = document.getElementById('download-cleaned-btn')!;
  const cleanAnotherBtn = document.getElementById('clean-another-btn')!;
  const changeFileBtn = document.getElementById('change-file-btn')!;

  const resPagesCount = document.getElementById('res-pages-count')!;
  const resFileSize = document.getElementById('res-file-size')!;
  const resActionsList = document.getElementById('res-actions-list')!;

  function showError(msg: string) {
    errorMessage.textContent = msg;
    errorBanner.classList.remove('hidden');
  }

  function hideError() {
    errorBanner.classList.add('hidden');
  }

  dismissError?.addEventListener('click', hideError);

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  async function handleFile(file: File) {
    hideError();
    currentFile = file;

    fileNameLabel.textContent = file.name;
    fileMetaLabel.textContent = `${formatBytes(file.size)} • Loading and scanning...`;

    dropZone.classList.add('hidden');
    optionsSection.classList.remove('hidden');
    successSection.classList.add('hidden');

    try {
      rawFileBytes = new Uint8Array(await file.arrayBuffer());
      detectionResult = await detectWatermarks(rawFileBytes);

      fileMetaLabel.textContent = `${formatBytes(file.size)} • ${detectionResult.pagesScanned} page(s)`;

      // Render scan badges
      scanBadgesContainer.innerHTML = '';
      const badges: { text: string; highlight: boolean }[] = [];

      if (detectionResult.watermarkAnnotationsCount > 0) {
        badges.push({
          text: `Found ${detectionResult.watermarkAnnotationsCount} Watermark/Stamp Annotation(s)`,
          highlight: true,
        });
      } else {
        badges.push({ text: `0 Watermark Annotations`, highlight: false });
      }

      if (detectionResult.watermarkXObjectsCount > 0) {
        badges.push({
          text: `Found ${detectionResult.watermarkXObjectsCount} Watermark Form XObject(s)`,
          highlight: true,
        });
      } else {
        badges.push({ text: `0 Watermark Form XObjects`, highlight: false });
      }

      if (detectionResult.hasLowOpacityArtifacts) {
        badges.push({ text: `Detected Semi-Transparent Overlays`, highlight: true });
      }

      if (detectionResult.detectedKeywords.length > 0) {
        badges.push({
          text: `Detected Keywords: ${detectionResult.detectedKeywords.join(', ')}`,
          highlight: true,
        });
      }

      badges.forEach((b) => {
        const span = document.createElement('span');
        span.className = b.highlight
          ? 'inline-flex items-center px-2.5 py-1 rounded-md bg-violet-100/80 border border-violet-200 text-violet-900 font-semibold'
          : 'inline-flex items-center px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-500';
        span.textContent = b.text;
        scanBadgesContainer.appendChild(span);
      });

      // Render suggested keywords chips
      suggestedKeywordsContainer.innerHTML = '';
      if (detectionResult.detectedKeywords.length > 0) {
        const label = document.createElement('span');
        label.className = 'text-slate-400 self-center mr-1';
        label.textContent = 'Detected:';
        suggestedKeywordsContainer.appendChild(label);

        detectionResult.detectedKeywords.forEach((kw) => {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'px-2 py-0.5 rounded bg-violet-100 hover:bg-violet-200 text-violet-800 text-[11px] font-medium transition';
          chip.textContent = `+ ${kw}`;
          chip.addEventListener('click', () => {
            const current = customKeywordsInput.value.trim();
            if (!current) {
              customKeywordsInput.value = kw;
            } else if (!current.includes(kw)) {
              customKeywordsInput.value = `${current}, ${kw}`;
            }
          });
          suggestedKeywordsContainer.appendChild(chip);
        });

        // Auto pre-fill with detected keywords
        customKeywordsInput.value = detectionResult.detectedKeywords.join(', ');
      }
    } catch (err: any) {
      showError(err.message || 'Failed to scan PDF document.');
    }
  }

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFile(target.files[0]);
    }
  });

  changeFileBtn?.addEventListener('click', () => {
    dropZone.classList.remove('hidden');
    optionsSection.classList.add('hidden');
    successSection.classList.add('hidden');
    fileInput.value = '';
    currentFile = null;
    rawFileBytes = null;
  });

  cleanAnotherBtn?.addEventListener('click', () => {
    dropZone.classList.remove('hidden');
    optionsSection.classList.add('hidden');
    successSection.classList.add('hidden');
    fileInput.value = '';
    currentFile = null;
    rawFileBytes = null;
  });

  executeBtn?.addEventListener('click', async () => {
    if (!rawFileBytes || !currentFile) return;

    optionsSection.classList.add('hidden');
    progressSection.classList.remove('hidden');

    try {
      const customKeywords = customKeywordsInput.value
        .split(',')
        .map((k) => k.trim())
        .filter((k) => k.length > 0);

      const removalResult: WatermarkRemovalResult = await removeWatermarks(rawFileBytes, {
        removeAnnotations: optRemoveAnnots.checked,
        removeXObjects: optRemoveXObjects.checked,
        textKeywordsToRemove: optRemoveKeywords.checked ? customKeywords : [],
      });

      cleanedResultBytes = removalResult.cleanedBytes;

      // Fill success details
      resPagesCount.textContent = `${removalResult.pagesProcessed} page(s)`;
      resFileSize.textContent = `${formatBytes(removalResult.originalSize)} → ${formatBytes(removalResult.cleanedSize)}`;

      resActionsList.innerHTML = '';
      removalResult.details.forEach((d) => {
        const li = document.createElement('li');
        li.textContent = d;
        resActionsList.appendChild(li);
      });

      progressSection.classList.add('hidden');
      successSection.classList.remove('hidden');
    } catch (err: any) {
      progressSection.classList.add('hidden');
      optionsSection.classList.remove('hidden');
      showError(err.message || 'Failed to remove watermark from document.');
    }
  });

  downloadBtn?.addEventListener('click', () => {
    if (!cleanedResultBytes || !currentFile) return;

    const baseName = currentFile.name.replace(/\.pdf$/i, '');
    const cleanFileName = `${baseName}_clean.pdf`;

    const blob = new Blob([cleanedResultBytes as any], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = cleanFileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>
