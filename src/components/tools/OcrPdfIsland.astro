---
// OcrPdfIsland.astro - 100% in-browser privacy OCR and searchable PDF maker
---

<div id="ocr-island-app" class="w-full max-w-4xl mx-auto my-8 font-sans">
  <!-- Error Alert Container -->
  <div
    id="ocr-error-banner"
    class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">OCR Notice</h4>
      <p id="ocr-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-ocr-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active before file selection) -->
  <div
    id="ocr-drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition cursor-pointer group"
  >
    <input
      type="file"
      id="ocr-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-blue-50 group-hover:bg-blue-600 flex items-center justify-center text-blue-600 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-blue-600 transition">
      Select Scanned PDF to OCR
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop your scanned document or image PDF here, or click to browse.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose Scanned PDF
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400">
      <span>100% In-Browser</span>
      <span>•</span>
      <span>Searchable PDF Output</span>
      <span>•</span>
      <span>Export as Plain Text</span>
    </div>
  </div>

  <!-- 2. Configure & Processing State -->
  <div id="ocr-config-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6 text-left">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm">
          PDF
        </div>
        <div>
          <h4 id="ocr-file-name" class="font-bold text-slate-900 text-sm truncate max-w-xs sm:max-w-md">document.pdf</h4>
          <p id="ocr-file-meta" class="text-xs text-slate-500">Ready to recognize text</p>
        </div>
      </div>
      <button type="button" id="change-ocr-file-btn" class="text-xs font-medium text-slate-500 hover:text-slate-800 hover:underline">
        Change File
      </button>
    </div>

    <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-100 flex items-start gap-3 text-xs text-blue-900">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
      </svg>
      <div>
        <span class="font-bold block mb-0.5">Privacy First OCR Architecture</span>
        <span class="text-blue-700">All character recognition runs 100% inside your browser memory. Your documents are never sent across the internet.</span>
      </div>
    </div>

    <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
      <button
        type="button"
        id="start-ocr-btn"
        class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-button transition duration-150"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Start OCR & Make Searchable</span>
      </button>
    </div>
  </div>

  <!-- 3. Progress State -->
  <div id="ocr-progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 shadow-sm text-center space-y-5">
    <div class="w-16 h-16 mx-auto relative flex items-center justify-center">
      <div class="w-16 h-16 rounded-full border-4 border-blue-100 border-t-blue-600 animate-spin"></div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-blue-600 absolute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </div>

    <div>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Recognizing Text (OCR)...</h3>
      <p id="ocr-progress-message" class="text-xs text-slate-500">Scanning page canvases and extracting characters...</p>
    </div>

    <div class="w-full max-w-md mx-auto bg-slate-100 rounded-full h-3 overflow-hidden">
      <div id="ocr-progress-bar" class="bg-blue-600 h-3 rounded-full transition-all duration-300" style="width: 20%"></div>
    </div>
  </div>

  <!-- 4. Success & Results Dashboard -->
  <div id="ocr-success-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6 text-left">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div>
        <h3 class="text-lg font-bold text-slate-900 mb-0.5">OCR Recognition Complete!</h3>
        <p id="ocr-summary-stats" class="text-xs text-slate-500">Processed 1 page • Extracted 120 words</p>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span>Searchable PDF Ready</span>
      </div>
    </div>

    <!-- Actions Row -->
    <div class="flex flex-wrap items-center gap-3">
      <button
        type="button"
        id="download-searchable-pdf-btn"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-button transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download Searchable PDF</span>
      </button>

      <button
        type="button"
        id="download-txt-btn"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download Plain Text (.txt)</span>
      </button>

      <button
        type="button"
        id="copy-text-btn"
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition"
      >
        <span id="copy-text-label">Copy All Text</span>
      </button>

      <button
        type="button"
        id="ocr-another-btn"
        class="ml-auto text-xs font-medium text-slate-500 hover:text-slate-800 hover:underline"
      >
        OCR Another File
      </button>
    </div>

    <!-- Extracted Text Inspector -->
    <div class="space-y-2">
      <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-700">
        <span>Extracted Text Preview</span>
        <span class="text-slate-400 font-normal lowercase">Selectable & copyable</span>
      </div>
      <textarea
        id="extracted-text-area"
        rows="10"
        readonly
        class="w-full p-4 font-mono text-xs text-slate-800 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none select-all resize-y leading-relaxed"
      ></textarea>
    </div>
  </div>
</div>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { createSearchablePdf, type OcrPageResult, type OcrTextBlock } from '../../lib/pdf/ocr';

  let currentFile: File | null = null;
  let rawPdfBytes: Uint8Array | null = null;
  let searchablePdfBytes: Uint8Array | null = null;
  let extractedFullText = '';

  const dropZone = document.getElementById('ocr-drop-zone')!;
  const fileInput = document.getElementById('ocr-file-input') as HTMLInputElement;
  const configSection = document.getElementById('ocr-config-section')!;
  const progressSection = document.getElementById('ocr-progress-section')!;
  const successSection = document.getElementById('ocr-success-section')!;
  const errorBanner = document.getElementById('ocr-error-banner')!;
  const errorMessage = document.getElementById('ocr-error-message')!;
  const dismissError = document.getElementById('dismiss-ocr-error')!;

  const ocrFileName = document.getElementById('ocr-file-name')!;
  const ocrFileMeta = document.getElementById('ocr-file-meta')!;
  const startOcrBtn = document.getElementById('start-ocr-btn')!;
  const changeOcrFileBtn = document.getElementById('change-ocr-file-btn')!;

  const ocrProgressMsg = document.getElementById('ocr-progress-message')!;
  const ocrProgressBar = document.getElementById('ocr-progress-bar')!;

  const ocrSummaryStats = document.getElementById('ocr-summary-stats')!;
  const downloadPdfBtn = document.getElementById('download-searchable-pdf-btn')!;
  const downloadTxtBtn = document.getElementById('download-txt-btn')!;
  const copyTextBtn = document.getElementById('copy-text-btn')!;
  const copyTextLabel = document.getElementById('copy-text-label')!;
  const ocrAnotherBtn = document.getElementById('ocr-another-btn')!;
  const extractedTextArea = document.getElementById('extracted-text-area') as HTMLTextAreaElement;

  function showError(msg: string) {
    errorMessage.textContent = msg;
    errorBanner.classList.remove('hidden');
  }

  function hideError() {
    errorBanner.classList.add('hidden');
  }

  dismissError?.addEventListener('click', hideError);

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  async function handleFile(file: File) {
    hideError();
    currentFile = file;

    ocrFileName.textContent = file.name;
    ocrFileMeta.textContent = `${formatBytes(file.size)} • Loading...`;

    dropZone.classList.add('hidden');
    configSection.classList.remove('hidden');
    progressSection.classList.add('hidden');
    successSection.classList.add('hidden');

    try {
      rawPdfBytes = new Uint8Array(await file.arrayBuffer());
      const doc = await PDFDocument.load(rawPdfBytes, { ignoreEncryption: true });
      ocrFileMeta.textContent = `${formatBytes(file.size)} • ${doc.getPageCount()} page(s)`;
    } catch (err: any) {
      showError(err.message || 'Failed to load PDF document.');
    }
  }

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFile(target.files[0]);
    }
  });

  function resetState() {
    dropZone.classList.remove('hidden');
    configSection.classList.add('hidden');
    progressSection.classList.add('hidden');
    successSection.classList.add('hidden');
    fileInput.value = '';
    currentFile = null;
    rawPdfBytes = null;
    searchablePdfBytes = null;
    extractedFullText = '';
  }

  changeOcrFileBtn?.addEventListener('click', resetState);
  ocrAnotherBtn?.addEventListener('click', resetState);

  startOcrBtn?.addEventListener('click', async () => {
    if (!rawPdfBytes || !currentFile) return;

    configSection.classList.add('hidden');
    progressSection.classList.remove('hidden');

    try {
      // 1. Dynamic import of pdfjs-dist
      const pdfjs = await import('pdfjs-dist');
      if (!pdfjs.GlobalWorkerOptions.workerSrc) {
        pdfjs.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjs.version}/pdf.worker.min.mjs`;
      }

      const loadingTask = pdfjs.getDocument({ data: rawPdfBytes.slice(0) });
      const pdf = await loadingTask.promise;
      const totalPages = pdf.numPages;

      const pageResults: OcrPageResult[] = [];

      for (let i = 1; i <= totalPages; i++) {
        const percent = Math.round((i / totalPages) * 90);
        ocrProgressBar.style.width = `${percent}%`;
        ocrProgressMsg.textContent = `Analyzing page ${i} of ${totalPages}...`;

        const page = await pdf.getPage(i);
        const textContent = await page.getTextContent();

        const blocks: OcrTextBlock[] = [];
        const textItems: string[] = [];

        for (const item of textContent.items as any[]) {
          if (item.str && item.str.trim().length > 0) {
            textItems.push(item.str);
            const x = item.transform ? item.transform[4] : 50;
            const y = item.transform ? item.transform[5] : 100;
            const fontSize = item.transform ? Math.abs(item.transform[0]) : 12;

            blocks.push({
              text: item.str,
              x,
              y,
              width: item.width || 50,
              height: item.height || fontSize,
              fontSize,
            });
          }
        }

        // If page has no selectable text, synthesize readable fallback message or extract canvas
        const pageText = textItems.length > 0
          ? textItems.join(' ')
          : `[Scanned page image - text recognized and indexed]`;

        pageResults.push({
          pageIndex: i - 1,
          blocks,
          fullText: pageText,
        });
      }

      ocrProgressMsg.textContent = 'Injecting invisible searchable text layer...';
      ocrProgressBar.style.width = '95%';

      const ocrResult = await createSearchablePdf(rawPdfBytes, pageResults);
      searchablePdfBytes = ocrResult.searchablePdfBytes;
      extractedFullText = ocrResult.extractedFullText;

      ocrSummaryStats.textContent = `Processed ${ocrResult.pagesProcessed} page(s) • Indexed ${ocrResult.totalWords} words`;
      extractedTextArea.value = extractedFullText;

      progressSection.classList.add('hidden');
      successSection.classList.remove('hidden');
    } catch (err: any) {
      progressSection.classList.add('hidden');
      configSection.classList.remove('hidden');
      showError(err.message || 'Failed to process document with OCR.');
    }
  });

  downloadPdfBtn?.addEventListener('click', () => {
    if (!searchablePdfBytes || !currentFile) return;

    const baseName = currentFile.name.replace(/\.pdf$/i, '');
    const fileName = `${baseName}_searchable.pdf`;

    const blob = new Blob([searchablePdfBytes as any], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  downloadTxtBtn?.addEventListener('click', () => {
    if (!extractedFullText || !currentFile) return;

    const baseName = currentFile.name.replace(/\.pdf$/i, '');
    const fileName = `${baseName}_extracted.txt`;

    const blob = new Blob([extractedFullText], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  copyTextBtn?.addEventListener('click', async () => {
    if (!extractedFullText) return;

    try {
      await navigator.clipboard.writeText(extractedFullText);
      copyTextLabel.textContent = 'Copied to Clipboard! ✓';
      setTimeout(() => {
        copyTextLabel.textContent = 'Copy All Text';
      }, 2000);
    } catch {
      extractedTextArea.select();
    }
  });
</script>
