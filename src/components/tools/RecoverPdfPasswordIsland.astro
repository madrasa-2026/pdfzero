---
// RecoverPdfPasswordIsland.astro - Interactive client-side PDF password recovery
---

<div id="recover-island-app" class="w-full max-w-4xl mx-auto my-8 font-sans">
  <!-- Error Alert Container -->
  <div
    id="recover-error-banner"
    class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">Notice</h4>
      <p id="recover-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-recover-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active before file selection) -->
  <div
    id="recover-drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition cursor-pointer group"
  >
    <input
      type="file"
      id="recover-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-slate-100 group-hover:bg-slate-900 flex items-center justify-center text-slate-700 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-brand-600 transition">
      Select locked PDF to recover password
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop your password-protected PDF, or click to choose from your device.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose Protected PDF
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400">
      <span>Zero cloud uploads</span>
      <span>•</span>
      <span>In-browser Web Worker search</span>
      <span>•</span>
      <span>No file size limit</span>
    </div>
  </div>

  <!-- 2. Dashboard & Strategy Selector -->
  <div id="recover-settings-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm text-left">
    <!-- Selected File Header -->
    <div class="flex items-center justify-between pb-6 border-b border-slate-200 mb-6">
      <div class="flex items-center gap-3 min-w-0 pr-2">
        <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center flex-shrink-0 font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p id="recover-file-name" class="text-sm font-bold text-slate-900 truncate">document.pdf</p>
          <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-500">
            <span id="recover-file-size">0 KB</span>
            <span>•</span>
            <span id="recover-status-badge" class="font-semibold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
              Password Protected
            </span>
          </div>
        </div>
      </div>
      <button type="button" id="recover-change-file-btn" class="text-xs font-semibold text-slate-500 hover:text-red-600 transition flex-shrink-0">
        Change File
      </button>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="flex border-b border-slate-200 mb-6 gap-2 overflow-x-auto text-xs font-semibold">
      <button type="button" id="tab-smart" class="tab-btn px-4 py-2.5 border-b-2 border-brand-600 text-brand-600 font-bold whitespace-nowrap">
        ⚡ Smart Auto-Recovery
      </button>
      <button type="button" id="tab-pin4" class="tab-btn px-4 py-2.5 border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap">
        🔢 4-Digit PINs (0000–9999)
      </button>
      <button type="button" id="tab-clues" class="tab-btn px-4 py-2.5 border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap">
        💡 Memory Clues
      </button>
      <button type="button" id="tab-custom" class="tab-btn px-4 py-2.5 border-b-2 border-transparent text-slate-500 hover:text-slate-800 whitespace-nowrap">
        📋 Custom Wordlist
      </button>
    </div>

    <!-- Mode 1: Smart Recovery Tab Content -->
    <div id="content-smart" class="tab-content space-y-4">
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-600 leading-relaxed">
        <p class="font-bold text-slate-800 mb-1">Recommended for completely forgotten passwords</p>
        <p>
          Smart Recovery systematically executes a multi-phase search:
          <span class="block mt-1">1. Top defaults & common keywords (instant)</span>
          <span class="block">2. All 10,000 4-digit PINs (0000–9999, ~30–60s)</span>
          <span class="block">3. Common 6-digit PIN patterns & years (1940–2030)</span>
        </p>
      </div>
      <button
        type="button"
        id="start-smart-btn"
        class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-white bg-brand-600 hover:bg-brand-700 active:bg-brand-800 transition shadow-sm hover:shadow"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Start Smart Auto-Recovery
      </button>
    </div>

    <!-- Mode 2: 4-Digit PIN Tab Content -->
    <div id="content-pin4" class="tab-content hidden space-y-4">
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-600 leading-relaxed">
        <p class="font-bold text-slate-800 mb-1">Targeted 4-Digit Numeric PIN Sweep</p>
        <p>Sweeps through all combinations from <code>0000</code> to <code>9999</code>. Ideal for financial slips, salary statements, mobile bills, or personal PIN locks.</p>
      </div>
      <button
        type="button"
        id="start-pin4-btn"
        class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 transition shadow-sm"
      >
        Sweep All 10,000 PINs (0000–9999)
      </button>
    </div>

    <!-- Mode 3: Memory Clues Tab Content -->
    <div id="content-clues" class="tab-content hidden space-y-4">
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-600 leading-relaxed">
        <p class="font-bold text-slate-800 mb-1">Guided Memory Permutations</p>
        <p>Enter any words, names, or numbers you typically use. Our generator will automatically test lowercase, uppercase, TitleCase, and combinations with suffixes.</p>
      </div>
      <div class="space-y-3 text-xs">
        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">Keywords / Names (comma separated)</label>
          <input
            type="text"
            id="clues-keywords"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none"
            placeholder="e.g. book, secret, john, novel, hamlet"
          />
        </div>
        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">Numbers / Years (comma separated)</label>
          <input
            type="text"
            id="clues-numbers"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none"
            placeholder="e.g. 123, 2024, 007, 1995"
          />
        </div>
      </div>
      <button
        type="button"
        id="start-clues-btn"
        class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-white bg-brand-600 hover:bg-brand-700 transition shadow-sm"
      >
        Generate Permutations & Scan
      </button>
    </div>

    <!-- Mode 4: Custom Wordlist Tab Content -->
    <div id="content-custom" class="tab-content hidden space-y-4">
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-600 leading-relaxed">
        <p class="font-bold text-slate-800 mb-1">Paste Suspected Passwords</p>
        <p>Enter any passwords you want to test, one per line.</p>
      </div>
      <div>
        <textarea
          id="custom-wordlist-input"
          rows="5"
          class="w-full p-3 font-mono text-xs rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:outline-none"
          placeholder="password123&#10;welcome&#10;mypassword&#10;2024"
        ></textarea>
      </div>
      <button
        type="button"
        id="start-custom-btn"
        class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-white bg-slate-900 hover:bg-slate-800 transition shadow-sm"
      >
        Scan Custom List
      </button>
    </div>
  </div>

  <!-- 3. Live Scanning Dashboard -->
  <div id="recover-progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm text-center space-y-5">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="recover-stage-title" class="text-xs font-bold text-slate-700 uppercase tracking-wider">
          Testing Candidate Passwords...
        </span>
      </div>
      <span id="recover-speed-badge" class="font-mono text-xs font-bold text-brand-700 bg-brand-50 px-2.5 py-1 rounded-lg border border-brand-200">
        0 tests/sec
      </span>
    </div>

    <!-- Candidate Preview Card -->
    <div class="py-4 bg-slate-50 rounded-xl border border-slate-200">
      <span class="text-xs text-slate-400 uppercase tracking-wider block mb-1">Currently Testing</span>
      <span id="recover-candidate-preview" class="font-mono font-bold text-xl text-slate-900">••••</span>
    </div>

    <!-- Progress Bar -->
    <div class="space-y-1.5 text-left">
      <div class="flex justify-between text-xs text-slate-500">
        <span id="recover-counter-text">0 / 0 candidates</span>
        <span id="recover-percent-text">0%</span>
      </div>
      <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden">
        <div id="recover-progress-bar" class="bg-brand-600 h-3 rounded-full transition-all duration-200" style="width: 0%"></div>
      </div>
      <div class="flex justify-between text-[11px] text-slate-400 pt-1">
        <span id="recover-elapsed-time">Elapsed: 0s</span>
        <span id="recover-eta-time">ETA: calculating...</span>
      </div>
    </div>

    <!-- Control Buttons -->
    <div class="flex items-center justify-center gap-3 pt-2">
      <button
        type="button"
        id="pause-resume-btn"
        class="px-5 py-2.5 text-xs font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 rounded-xl transition"
      >
        Pause
      </button>
      <button
        type="button"
        id="cancel-scan-btn"
        class="px-5 py-2.5 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded-xl transition"
      >
        Cancel
      </button>
    </div>
  </div>

  <!-- 4. Success State (Password Found!) -->
  <div id="recover-success-section" class="hidden bg-white rounded-2xl border border-emerald-200 p-8 shadow-sm text-center space-y-6">
    <div class="w-16 h-16 mx-auto rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>

    <div>
      <h3 class="text-2xl font-extrabold text-slate-900 mb-1">Password Successfully Recovered!</h3>
      <p class="text-sm text-slate-600">The correct decryption key was found for your document.</p>
    </div>

    <!-- Password Card -->
    <div class="max-w-md mx-auto p-5 bg-emerald-50/70 border border-emerald-200 rounded-xl text-center space-y-3">
      <span class="text-xs uppercase tracking-wider text-emerald-800 font-bold block">Document Password</span>
      <div class="flex items-center justify-center gap-2">
        <input
          type="text"
          id="found-password-text"
          readonly
          class="font-mono font-extrabold text-xl sm:text-2xl text-slate-900 bg-white px-4 py-2 rounded-lg border border-emerald-300 text-center select-all shadow-inner"
          value=""
        />
        <button
          type="button"
          id="copy-password-btn"
          class="px-3.5 py-2 text-xs font-bold text-emerald-700 bg-white hover:bg-emerald-100 rounded-lg border border-emerald-300 transition"
        >
          Copy
        </button>
      </div>
      <p id="copy-feedback-msg" class="text-[11px] text-emerald-700 font-medium hidden">✓ Copied to clipboard</p>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <button
        type="button"
        id="download-unlocked-btn"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition shadow-sm hover:shadow"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download Clean Unlocked PDF
      </button>

      <button
        type="button"
        id="recover-another-btn"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition"
      >
        Recover Another File
      </button>
    </div>
  </div>

  <!-- 5. Exhausted State (Not found) -->
  <div id="recover-exhausted-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 shadow-sm text-center space-y-5">
    <div class="w-14 h-14 mx-auto rounded-full bg-slate-100 text-slate-500 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    </div>

    <div>
      <h3 class="text-xl font-bold text-slate-900 mb-1">No Matching Password Found in Selected Modes</h3>
      <p class="text-sm text-slate-600 max-w-md mx-auto">
        All tested combinations were evaluated. Try using the <strong>Memory Clues</strong> mode to enter words, names, or numbers you often use.
      </p>
    </div>

    <div class="flex items-center justify-center gap-3 pt-2">
      <button
        type="button"
        id="switch-to-clues-btn"
        class="px-6 py-2.5 rounded-xl font-bold text-white bg-brand-600 hover:bg-brand-700 transition"
      >
        Try Memory Clues Mode
      </button>
      <button
        type="button"
        id="exhausted-restart-btn"
        class="px-5 py-2.5 rounded-xl font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition"
      >
        Choose Different File
      </button>
    </div>
  </div>
</div>

<script>
  import { RecoveryWorkerClient } from '../../lib/pdf/recoveryWorkerClient';
  import {
    generate4DigitPins,
    generateSmartRecoveryBatches,
    generateCluePermutations,
  } from '../../lib/pdf/recover';
  import { checkIfEncrypted, unlockPdf } from '../../lib/pdf/unlock';

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  let selectedFile: File | null = null;
  let discoveredPassword = '';
  let workerClient: RecoveryWorkerClient | null = null;
  let isPausedState = false;

  // DOM Elements
  const dropZone = document.getElementById('recover-drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('recover-file-input') as HTMLInputElement;
  const settingsSection = document.getElementById('recover-settings-section') as HTMLDivElement;
  const progressSection = document.getElementById('recover-progress-section') as HTMLDivElement;
  const successSection = document.getElementById('recover-success-section') as HTMLDivElement;
  const exhaustedSection = document.getElementById('recover-exhausted-section') as HTMLDivElement;

  const errorBanner = document.getElementById('recover-error-banner') as HTMLDivElement;
  const errorMessage = document.getElementById('recover-error-message') as HTMLParagraphElement;
  const dismissErrorBtn = document.getElementById('dismiss-recover-error') as HTMLButtonElement;

  const fileNameEl = document.getElementById('recover-file-name') as HTMLParagraphElement;
  const fileSizeEl = document.getElementById('recover-file-size') as HTMLSpanElement;
  const changeFileBtn = document.getElementById('recover-change-file-btn') as HTMLButtonElement;

  // Tabs
  const tabSmart = document.getElementById('tab-smart') as HTMLButtonElement;
  const tabPin4 = document.getElementById('tab-pin4') as HTMLButtonElement;
  const tabClues = document.getElementById('tab-clues') as HTMLButtonElement;
  const tabCustom = document.getElementById('tab-custom') as HTMLButtonElement;

  const contentSmart = document.getElementById('content-smart') as HTMLDivElement;
  const contentPin4 = document.getElementById('content-pin4') as HTMLDivElement;
  const contentClues = document.getElementById('content-clues') as HTMLDivElement;
  const contentCustom = document.getElementById('content-custom') as HTMLDivElement;

  // Action Buttons
  const startSmartBtn = document.getElementById('start-smart-btn') as HTMLButtonElement;
  const startPin4Btn = document.getElementById('start-pin4-btn') as HTMLButtonElement;
  const startCluesBtn = document.getElementById('start-clues-btn') as HTMLButtonElement;
  const startCustomBtn = document.getElementById('start-custom-btn') as HTMLButtonElement;

  // Progress Elements
  const stageTitleEl = document.getElementById('recover-stage-title') as HTMLSpanElement;
  const speedBadgeEl = document.getElementById('recover-speed-badge') as HTMLSpanElement;
  const candidatePreviewEl = document.getElementById('recover-candidate-preview') as HTMLSpanElement;
  const counterTextEl = document.getElementById('recover-counter-text') as HTMLSpanElement;
  const percentTextEl = document.getElementById('recover-percent-text') as HTMLSpanElement;
  const progressBarEl = document.getElementById('recover-progress-bar') as HTMLDivElement;
  const elapsedEl = document.getElementById('recover-elapsed-time') as HTMLSpanElement;
  const etaEl = document.getElementById('recover-eta-time') as HTMLSpanElement;
  const pauseResumeBtn = document.getElementById('pause-resume-btn') as HTMLButtonElement;
  const cancelScanBtn = document.getElementById('cancel-scan-btn') as HTMLButtonElement;

  // Success Elements
  const foundPasswordInput = document.getElementById('found-password-text') as HTMLInputElement;
  const copyPasswordBtn = document.getElementById('copy-password-btn') as HTMLButtonElement;
  const copyFeedbackMsg = document.getElementById('copy-feedback-msg') as HTMLParagraphElement;
  const downloadUnlockedBtn = document.getElementById('download-unlocked-btn') as HTMLButtonElement;
  const recoverAnotherBtn = document.getElementById('recover-another-btn') as HTMLButtonElement;

  // Exhausted Elements
  const switchToCluesBtn = document.getElementById('switch-to-clues-btn') as HTMLButtonElement;
  const exhaustedRestartBtn = document.getElementById('exhausted-restart-btn') as HTMLButtonElement;

  function showError(msg: string) {
    if (errorMessage && errorBanner) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function hideError() {
    if (errorBanner) {
      errorBanner.classList.add('hidden');
    }
  }

  dismissErrorBtn?.addEventListener('click', hideError);

  function resetToDropzone() {
    workerClient?.stop();
    selectedFile = null;
    discoveredPassword = '';
    dropZone.classList.remove('hidden');
    settingsSection.classList.add('hidden');
    progressSection.classList.add('hidden');
    successSection.classList.add('hidden');
    exhaustedSection.classList.add('hidden');
    fileInput.value = '';
    hideError();
  }

  changeFileBtn?.addEventListener('click', resetToDropzone);
  recoverAnotherBtn?.addEventListener('click', resetToDropzone);
  exhaustedRestartBtn?.addEventListener('click', resetToDropzone);

  // Tab switching logic
  const tabs = [
    { btn: tabSmart, content: contentSmart },
    { btn: tabPin4, content: contentPin4 },
    { btn: tabClues, content: contentClues },
    { btn: tabCustom, content: contentCustom },
  ];

  function switchTab(activeBtn: HTMLButtonElement) {
    tabs.forEach(({ btn, content }) => {
      if (btn === activeBtn) {
        btn.classList.add('border-brand-600', 'text-brand-600', 'font-bold');
        btn.classList.remove('border-transparent', 'text-slate-500');
        content.classList.remove('hidden');
      } else {
        btn.classList.remove('border-brand-600', 'text-brand-600', 'font-bold');
        btn.classList.add('border-transparent', 'text-slate-500');
        content.classList.add('hidden');
      }
    });
  }

  tabSmart?.addEventListener('click', () => switchTab(tabSmart));
  tabPin4?.addEventListener('click', () => switchTab(tabPin4));
  tabClues?.addEventListener('click', () => switchTab(tabClues));
  tabCustom?.addEventListener('click', () => switchTab(tabCustom));
  switchToCluesBtn?.addEventListener('click', () => {
    exhaustedSection.classList.add('hidden');
    settingsSection.classList.remove('hidden');
    switchTab(tabClues);
  });

  // Drag and drop handlers
  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.add('border-brand-500', 'bg-brand-50/30');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.remove('border-brand-500', 'bg-brand-50/30');
    });
  });

  dropZone?.addEventListener('drop', (e) => {
    const files = e.dataTransfer?.files;
    if (files && files.length > 0) {
      handleFileSelected(files[0]);
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length > 0) {
      handleFileSelected(fileInput.files[0]);
    }
  });

  async function handleFileSelected(file: File) {
    hideError();

    if (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf') {
      showError('Please select a valid PDF file.');
      return;
    }

    selectedFile = file;
    fileNameEl.textContent = file.name;
    fileSizeEl.textContent = formatBytes(file.size);

    try {
      const probe = await checkIfEncrypted(file);
      if (!probe.isEncrypted) {
        showError('This PDF document is already unencrypted and does not have a password.');
        return;
      }
    } catch {
      // Proceed if probe throws (indicates password requirement)
    }

    dropZone.classList.add('hidden');
    progressSection.classList.add('hidden');
    successSection.classList.add('hidden');
    exhaustedSection.classList.add('hidden');
    settingsSection.classList.remove('hidden');
  }

  async function launchRecovery(batches: { stageId: string; label: string; candidates: string[] }[]) {
    if (!selectedFile) return;

    settingsSection.classList.add('hidden');
    exhaustedSection.classList.add('hidden');
    progressSection.classList.remove('hidden');
    isPausedState = false;
    pauseResumeBtn.textContent = 'Pause';

    if (!workerClient) {
      workerClient = new RecoveryWorkerClient();
    }

    await workerClient.setPdfFile(selectedFile);

    const startTime = Date.now();

    workerClient.start(batches, {
      onProgress: (p) => {
        stageTitleEl.textContent = `${p.stageLabel} (${p.stageIndex + 1}/${p.totalStages})`;
        speedBadgeEl.textContent = `⚡ ${p.speed} tests/sec`;
        candidatePreviewEl.textContent = p.currentCandidate || '••••';
        counterTextEl.textContent = `${p.overallTested.toLocaleString()} / ${p.overallTotal.toLocaleString()} candidates`;
        percentTextEl.textContent = `${p.percent}%`;
        progressBarEl.style.width = `${p.percent}%`;

        const elapsedSec = Math.round((Date.now() - startTime) / 1000);
        elapsedEl.textContent = `Elapsed: ${elapsedSec}s`;
        etaEl.textContent = p.estimatedRemainingSeconds > 0 ? `ETA: ~${p.estimatedRemainingSeconds}s` : 'ETA: finalizing...';
      },
      onFound: (password) => {
        discoveredPassword = password;
        progressSection.classList.add('hidden');
        successSection.classList.remove('hidden');
        foundPasswordInput.value = password;
      },
      onAllExhausted: () => {
        progressSection.classList.add('hidden');
        exhaustedSection.classList.remove('hidden');
      },
      onError: (err) => {
        progressSection.classList.add('hidden');
        settingsSection.classList.remove('hidden');
        showError(err || 'An error occurred during recovery.');
      },
    });
  }

  // Button Listeners
  startSmartBtn?.addEventListener('click', () => {
    const batches = generateSmartRecoveryBatches();
    launchRecovery(batches);
  });

  startPin4Btn?.addEventListener('click', () => {
    const batches = [
      {
        stageId: 'pin4',
        label: '4-Digit Numeric PIN Sweep (0000–9999)',
        candidates: generate4DigitPins(),
      },
    ];
    launchRecovery(batches);
  });

  startCluesBtn?.addEventListener('click', () => {
    const keywordsInput = (document.getElementById('clues-keywords') as HTMLInputElement)?.value || '';
    const numbersInput = (document.getElementById('clues-numbers') as HTMLInputElement)?.value || '';

    const keywords = keywordsInput.split(',').map((s) => s.trim()).filter(Boolean);
    const numbers = numbersInput.split(',').map((s) => s.trim()).filter(Boolean);

    if (keywords.length === 0 && numbers.length === 0) {
      showError('Please enter at least one keyword or number to generate permutations.');
      return;
    }

    const permutations = generateCluePermutations({ keywords, numbers, symbols: ['!', '@', '#'] });
    const batches = [
      {
        stageId: 'custom-clues',
        label: `Memory Clues (${permutations.length} permutations)`,
        candidates: permutations,
      },
    ];
    launchRecovery(batches);
  });

  startCustomBtn?.addEventListener('click', () => {
    const textarea = (document.getElementById('custom-wordlist-input') as HTMLTextAreaElement)?.value || '';
    const lines = textarea
      .split('\n')
      .map((l) => l.trim())
      .filter((l) => l.length > 0);

    if (lines.length === 0) {
      showError('Please paste at least one password candidate into the wordlist box.');
      return;
    }

    const batches = [
      {
        stageId: 'custom-wordlist',
        label: `Custom Wordlist (${lines.length} items)`,
        candidates: Array.from(new Set(lines)),
      },
    ];
    launchRecovery(batches);
  });

  pauseResumeBtn?.addEventListener('click', () => {
    if (!workerClient) return;
    if (isPausedState) {
      workerClient.resume();
      isPausedState = false;
      pauseResumeBtn.textContent = 'Pause';
    } else {
      workerClient.pause();
      isPausedState = true;
      pauseResumeBtn.textContent = 'Resume';
    }
  });

  cancelScanBtn?.addEventListener('click', () => {
    workerClient?.stop();
    progressSection.classList.add('hidden');
    settingsSection.classList.remove('hidden');
  });

  copyPasswordBtn?.addEventListener('click', () => {
    if (foundPasswordInput.value) {
      navigator.clipboard.writeText(foundPasswordInput.value);
      copyFeedbackMsg?.classList.remove('hidden');
      setTimeout(() => copyFeedbackMsg?.classList.add('hidden'), 2500);
    }
  });

  downloadUnlockedBtn?.addEventListener('click', async () => {
    if (!selectedFile || !discoveredPassword) return;

    downloadUnlockedBtn.disabled = true;
    downloadUnlockedBtn.textContent = 'Decrypting Clean PDF...';

    try {
      const cleanBytes = await unlockPdf(selectedFile, discoveredPassword);
      const blob = new Blob([cleanBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = selectedFile.name.replace(/\.pdf$/i, '_recovered.pdf');
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (err: any) {
      showError(err?.message || 'Failed to decrypt document with recovered password.');
    } finally {
      downloadUnlockedBtn.disabled = false;
      downloadUnlockedBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download Clean Unlocked PDF
      `;
    }
  });
</script>
