---
// src/components/tools/PdfToPdfaIsland.astro
---

<div class="w-full max-w-4xl mx-auto space-y-6">
  <!-- 1. Dropzone Section -->
  <div
    id="pdfa-dropzone"
    class="relative border-2 border-dashed border-slate-300 hover:border-indigo-500 bg-white/80 hover:bg-indigo-50/20 transition-all rounded-3xl p-8 sm:p-12 text-center cursor-pointer shadow-sm group"
  >
    <input
      type="file"
      id="pdfa-file-input"
      accept="application/pdf"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
    />
    <div class="flex flex-col items-center justify-center pointer-events-none">
      <div class="w-16 h-16 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-indigo-100 transition-all shadow-inner">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <polyline points="9 12 12 15 16 10"></polyline>
        </svg>
      </div>
      <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">
        Drop PDF to convert to certified ISO 19005 PDF/A
      </h3>
      <p class="text-xs sm:text-sm text-slate-500 max-w-md mb-4">
        Guarantees long-term archival preservation for court submissions (PACER / e-Courts), tax filings, and institutional repositories.
      </p>
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold">
        <svg class="w-4 h-4 text-indigo-600" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        iLovePDF Premium Alternative • 100% Free &amp; Client-Side • ISO Certified
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400">
      <span>Zero Upload</span>
      <span>•</span>
      <span>PDF/A-1b</span>
      <span>•</span>
      <span>PDF/A-2b</span>
      <span>•</span>
      <span>PDF/A-3b</span>
      <span>•</span>
      <span>sRGB OutputIntent</span>
    </div>
  </div>

  <!-- 2. Loading State -->
  <div id="pdfa-loading" class="hidden bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm text-center space-y-4">
    <div class="w-12 h-12 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin mx-auto"></div>
    <h3 class="text-base font-bold text-slate-900">
      Parsing document structure and color dictionaries...
    </h3>
    <p class="text-xs text-slate-500 max-w-md mx-auto">
      Verifying document catalog and checking ISO conformance requirements.
    </p>
  </div>

  <!-- 3. Conversion Panel -->
  <div id="pdfa-panel" class="hidden space-y-6">
    <!-- File Header Card -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <div>
          <h4 id="pdfa-filename" class="text-base font-bold text-slate-900 truncate max-w-xs sm:max-w-md">document.pdf</h4>
          <p id="pdfa-meta" class="text-xs text-slate-500">Document loaded</p>
        </div>
      </div>

      <button
        type="button"
        id="btn-change-pdfa-file"
        class="text-xs text-slate-500 hover:text-slate-800 px-3 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 transition-colors cursor-pointer"
      >
        Change PDF
      </button>
    </div>

    <!-- Archival Profile Selector -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
      <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Select ISO Archival Standard</h4>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <!-- PDF/A-2b -->
        <label class="flex flex-col justify-between p-4 rounded-2xl border-2 border-indigo-600 bg-indigo-50/20 transition-all cursor-pointer profile-card" id="card-pdfa-2b">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-slate-900">PDF/A-2b</span>
              <span class="px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-800 text-[10px] font-bold">Recommended</span>
            </div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              ISO 19005-2:2011. Modern standard supporting vector transparencies, drop shadows, and modern image layers.
            </p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="radio" name="pdfa-profile" value="PDF/A-2b" checked class="w-4 h-4 text-indigo-600" />
            <span class="text-[11px] font-semibold text-slate-700">Universal Use</span>
          </div>
        </label>

        <!-- PDF/A-1b -->
        <label class="flex flex-col justify-between p-4 rounded-2xl border border-slate-200 hover:border-slate-300 transition-all cursor-pointer profile-card" id="card-pdfa-1b">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-slate-900">PDF/A-1b</span>
              <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[10px] font-semibold">Strict Courts</span>
            </div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              ISO 19005-1:2005. Legacy baseline format required by older judicial filing portals, US federal PACER, and conservative government systems.
            </p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="radio" name="pdfa-profile" value="PDF/A-1b" class="w-4 h-4 text-indigo-600" />
            <span class="text-[11px] font-semibold text-slate-700">Legacy E-Filing</span>
          </div>
        </label>

        <!-- PDF/A-3b -->
        <label class="flex flex-col justify-between p-4 rounded-2xl border border-slate-200 hover:border-slate-300 transition-all cursor-pointer profile-card" id="card-pdfa-3b">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-slate-900">PDF/A-3b</span>
              <span class="px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 text-[10px] font-semibold">Invoicing</span>
            </div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              ISO 19005-3:2012. Enterprise standard supporting embedded XML e-invoices (ZUGFeRD, Factur-X) and structured attachments.
            </p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="radio" name="pdfa-profile" value="PDF/A-3b" class="w-4 h-4 text-indigo-600" />
            <span class="text-[11px] font-semibold text-slate-700">Electronic Invoices</span>
          </div>
        </label>
      </div>
    </div>

    <!-- Metadata Configuration (Dublin Core) -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
      <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Archival Metadata (Dublin Core)</h4>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="pdfa-title" class="block text-xs font-semibold text-slate-700 mb-1">Document Title</label>
          <input
            type="text"
            id="pdfa-title"
            placeholder="e.g. Legal Brief Case No. 2026-CV"
            class="w-full text-xs px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
        </div>

        <div>
          <label for="pdfa-author" class="block text-xs font-semibold text-slate-700 mb-1">Author / Depositor</label>
          <input
            type="text"
            id="pdfa-author"
            placeholder="e.g. Legal Counsel / Research Institute"
            class="w-full text-xs px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          />
        </div>
      </div>
    </div>

    <!-- ISO Compliance Badges Checklist -->
    <div class="bg-indigo-50/60 rounded-3xl border border-indigo-100 p-6 shadow-sm space-y-3">
      <h5 class="text-xs font-bold text-indigo-950 uppercase tracking-wider">ISO 19005 Certification Checklist</h5>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700">
        <div class="flex items-center gap-2">
          <span class="text-emerald-600 font-bold">✓</span>
          <span>Device-independent sRGB OutputIntent injected</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-600 font-bold">✓</span>
          <span id="label-xmp-part">ISO 19005-2 Level B XMP packet embedded</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-600 font-bold">✓</span>
          <span>Password encryption locks sanitized</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-600 font-bold">✓</span>
          <span>Disallowed interactive launch actions purged</span>
        </div>
      </div>
    </div>

    <!-- Action Button -->
    <button
      type="button"
      id="btn-convert-pdfa"
      class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2 cursor-pointer text-xs"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        <polyline points="9 12 12 15 16 10"></polyline>
      </svg>
      <span id="btn-pdfa-text">Convert &amp; Download Certified PDF/A</span>
    </button>
  </div>
</div>

<script>
  import { convertToPdfA, type PdfAProfile, type PdfAResult } from '../../lib/pdf/pdfaEngine';

  let rawBytes: Uint8Array | null = null;
  let filename = 'document.pdf';

  // DOM
  const dropzone = document.getElementById('pdfa-dropzone') as HTMLElement;
  const fileInput = document.getElementById('pdfa-file-input') as HTMLInputElement;
  const loading = document.getElementById('pdfa-loading') as HTMLElement;
  const panel = document.getElementById('pdfa-panel') as HTMLElement;
  const filenameEl = document.getElementById('pdfa-filename') as HTMLElement;
  const metaEl = document.getElementById('pdfa-meta') as HTMLElement;
  const changeFileBtn = document.getElementById('btn-change-pdfa-file') as HTMLButtonElement;

  const profileRadios = document.querySelectorAll('input[name="pdfa-profile"]') as NodeListOf<HTMLInputElement>;
  const card2b = document.getElementById('card-pdfa-2b') as HTMLElement;
  const card1b = document.getElementById('card-pdfa-1b') as HTMLElement;
  const card3b = document.getElementById('card-pdfa-3b') as HTMLElement;
  const labelXmpPart = document.getElementById('label-xmp-part') as HTMLElement;

  const inputTitle = document.getElementById('pdfa-title') as HTMLInputElement;
  const inputAuthor = document.getElementById('pdfa-author') as HTMLInputElement;
  const btnConvert = document.getElementById('btn-convert-pdfa') as HTMLButtonElement;
  const btnPdfaText = document.getElementById('btn-pdfa-text') as HTMLElement;

  // Dropzone
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-indigo-500', 'bg-indigo-50/20');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-indigo-500', 'bg-indigo-50/20');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-indigo-500', 'bg-indigo-50/20');
    if (e.dataTransfer?.files?.[0]) {
      handleFile(e.dataTransfer.files[0]);
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.[0]) {
      handleFile(fileInput.files[0]);
    }
  });

  changeFileBtn?.addEventListener('click', () => {
    panel.classList.add('hidden');
    dropzone.classList.remove('hidden');
    fileInput.value = '';
    rawBytes = null;
  });

  // Profile cards styling
  profileRadios.forEach((r) => {
    r.addEventListener('change', () => {
      const val = r.value;
      [card2b, card1b, card3b].forEach(c => {
        c.className = 'flex flex-col justify-between p-4 rounded-2xl border border-slate-200 hover:border-slate-300 transition-all cursor-pointer profile-card';
      });

      if (val === 'PDF/A-2b') {
        card2b.className = 'flex flex-col justify-between p-4 rounded-2xl border-2 border-indigo-600 bg-indigo-50/20 transition-all cursor-pointer profile-card';
        labelXmpPart.textContent = 'ISO 19005-2 Level B XMP packet embedded';
      } else if (val === 'PDF/A-1b') {
        card1b.className = 'flex flex-col justify-between p-4 rounded-2xl border-2 border-indigo-600 bg-indigo-50/20 transition-all cursor-pointer profile-card';
        labelXmpPart.textContent = 'ISO 19005-1 Level B XMP packet embedded';
      } else if (val === 'PDF/A-3b') {
        card3b.className = 'flex flex-col justify-between p-4 rounded-2xl border-2 border-indigo-600 bg-indigo-50/20 transition-all cursor-pointer profile-card';
        labelXmpPart.textContent = 'ISO 19005-3 Level B XMP packet embedded';
      }
    });
  });

  async function handleFile(file: File) {
    if (!file.name.toLowerCase().endsWith('.pdf')) {
      alert('Please upload a PDF document.');
      return;
    }
    filename = file.name;
    dropzone.classList.add('hidden');
    loading.classList.remove('hidden');

    try {
      const buffer = await file.arrayBuffer();
      rawBytes = new Uint8Array(buffer);
      filenameEl.textContent = filename;
      metaEl.textContent = `${(file.size / 1024).toFixed(1)} KB • Ready for ISO 19005 conversion`;

      const baseName = filename.replace(/\.pdf$/i, '');
      inputTitle.value = baseName;

      loading.classList.add('hidden');
      panel.classList.remove('hidden');
    } catch (err: any) {
      alert('Error reading PDF: ' + err.message);
      loading.classList.add('hidden');
      dropzone.classList.remove('hidden');
    }
  }

  btnConvert?.addEventListener('click', async () => {
    if (!rawBytes) return;
    btnConvert.disabled = true;
    const origText = btnPdfaText.textContent;
    btnPdfaText.textContent = 'Injecting ISO 19005 OutputIntents & XMP...';

    const selectedProfile = ((document.querySelector('input[name="pdfa-profile"]:checked') as HTMLInputElement)?.value as PdfAProfile) || 'PDF/A-2b';

    try {
      const result: PdfAResult = await convertToPdfA(rawBytes, {
        profile: selectedProfile,
        title: inputTitle.value.trim() || undefined,
        author: inputAuthor.value.trim() || undefined
      });

      const blob = new Blob([result.pdfBytes as unknown as BlobPart], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const baseName = filename.replace(/\.pdf$/i, '');
      const profileSlug = selectedProfile.toLowerCase().replace(/[^a-z0-9]/g, '');
      a.href = url;
      a.download = `${baseName}-${profileSlug}.pdf`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (err: any) {
      alert('Failed to convert to PDF/A: ' + err.message);
    } finally {
      btnConvert.disabled = false;
      btnPdfaText.textContent = origText;
    }
  });
</script>
