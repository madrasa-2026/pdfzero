---
// src/components/tools/DuplexSortPdfIsland.astro
---

<div class="w-full max-w-4xl mx-auto space-y-6">
  <!-- Mode Switcher Tabs -->
  <div class="flex justify-center">
    <div class="bg-slate-100 p-1.5 rounded-2xl flex items-center gap-1.5 border border-slate-200">
      <button
        type="button"
        id="tab-btn-print"
        class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer bg-white text-indigo-700 shadow-sm"
        data-mode="print"
      >
        <span>🖨️</span>
        <span class="ml-1">Duplex Print Wizard</span>
      </button>
      <button
        type="button"
        id="tab-btn-interleave"
        class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all cursor-pointer text-slate-600 hover:text-slate-900"
        data-mode="interleave"
      >
        <span>🔄</span>
        <span class="ml-1">Scanner ADF Interleaver</span>
      </button>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODE 1: DUPLEX PRINT WIZARD                -->
  <!-- ========================================== -->
  <div id="section-print-mode" class="space-y-6">
    <!-- Dropzone -->
    <div
      id="print-dropzone"
      class="relative border-2 border-dashed border-slate-300 hover:border-indigo-500 bg-white/80 hover:bg-indigo-50/20 transition-all rounded-3xl p-8 sm:p-12 text-center cursor-pointer shadow-sm group"
    >
      <input
        type="file"
        id="print-file-input"
        accept="application/pdf"
        class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      />
      <div class="flex flex-col items-center justify-center pointer-events-none">
        <div class="w-16 h-16 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-indigo-100 transition-all shadow-inner">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">
          Drop PDF to prepare manual double-sided printing
        </h3>
        <p class="text-xs sm:text-sm text-slate-500 max-w-md mb-4">
          Splits into Step 1 (Fronts) and Step 2 (Backs) with automated reverse ordering and odd-page blank padding.
        </p>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold">
          <svg class="w-4 h-4 text-indigo-600" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          Zero Jam Traps • HP, Canon, Epson &amp; Brother Compatible • Zero Upload
        </div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="print-loading" class="hidden bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm text-center space-y-4">
      <div class="w-12 h-12 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin mx-auto"></div>
      <h3 class="text-base font-bold text-slate-900">
        Calculating printer tray feed geometry...
      </h3>
      <p class="text-xs text-slate-500 max-w-md mx-auto">
        Separating odd and even pages and checking page count parity.
      </p>
    </div>

    <!-- Print Results & Options Studio -->
    <div id="print-results" class="hidden space-y-6">
      <!-- File Metadata Banner -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="6" y="14" width="12" height="8"></rect>
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            </svg>
          </div>
          <div>
            <h4 id="print-filename" class="text-base font-bold text-slate-900 truncate max-w-xs sm:max-w-md">document.pdf</h4>
            <p id="print-meta" class="text-xs text-slate-500">24 pages • 12 paper sheets needed</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-download-both-zip"
            class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-4 rounded-xl text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center gap-2 cursor-pointer group"
          >
            <svg class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download Both Stacks (.ZIP)</span>
          </button>

          <button
            type="button"
            id="btn-change-print-file"
            class="text-xs text-slate-500 hover:text-slate-800 px-3 py-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 transition-colors cursor-pointer"
          >
            Change PDF
          </button>
        </div>
      </div>

      <!-- Printer Tray Configuration Card -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Printer Tray Settings</h4>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="flex items-start gap-3 p-3.5 rounded-2xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/20 transition-all cursor-pointer">
            <input
              type="checkbox"
              id="opt-reverse-evens"
              checked
              class="w-4 h-4 mt-0.5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500"
            />
            <div>
              <span class="text-xs font-bold text-slate-800 block">Reverse Even Stack Order</span>
              <span class="text-[11px] text-slate-500 leading-tight block mt-0.5">
                Recommended for standard desktop printers where printed sheets eject face-down.
              </span>
            </div>
          </label>

          <label class="flex items-start gap-3 p-3.5 rounded-2xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/20 transition-all cursor-pointer">
            <input
              type="checkbox"
              id="opt-pad-blank"
              checked
              class="w-4 h-4 mt-0.5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500"
            />
            <div>
              <span class="text-xs font-bold text-slate-800 block">Smart Blank Padding</span>
              <span class="text-[11px] text-slate-500 leading-tight block mt-0.5">
                Appends a blank page if page count is odd to prevent back-side page shift.
              </span>
            </div>
          </label>
        </div>

        <div id="padding-notice" class="hidden p-3 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-800 flex items-center gap-2">
          <span>⚠️</span>
          <span><strong>Odd Page Count Detected:</strong> A blank sheet has been added to Step 2 so your final page won't ruin double-sided alignment.</span>
        </div>
      </div>

      <!-- Step-by-Step Print Execution Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Step 1: Fronts / Odds -->
        <div class="bg-white rounded-3xl border-2 border-indigo-200 p-6 shadow-sm space-y-4 relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="px-3 py-1 rounded-full bg-indigo-600 text-white font-extrabold text-xs">
              STEP 1
            </span>
            <span id="step1-page-count" class="text-xs font-semibold text-indigo-900">12 pages</span>
          </div>

          <div>
            <h5 class="text-base font-bold text-slate-900">Print Front Sides (Odd Pages)</h5>
            <p class="text-xs text-slate-500 mt-1">
              Contains pages 1, 3, 5, 7, 9... Load fresh paper into your printer and print this file first.
            </p>
          </div>

          <div class="p-3 bg-slate-50 rounded-xl text-[11px] text-slate-600 border border-slate-100 flex items-center gap-2">
            <span>📄</span>
            <span>Takes printed sheets directly to output tray.</span>
          </div>

          <button
            type="button"
            id="btn-download-step1"
            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-4 rounded-xl text-xs shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download Step 1 (Fronts PDF)</span>
          </button>
        </div>

        <!-- Step 2: Backs / Evens -->
        <div class="bg-white rounded-3xl border-2 border-slate-200 p-6 shadow-sm space-y-4 relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="px-3 py-1 rounded-full bg-slate-800 text-white font-extrabold text-xs">
              STEP 2
            </span>
            <span id="step2-page-count" class="text-xs font-semibold text-slate-700">12 pages</span>
          </div>

          <div>
            <h5 class="text-base font-bold text-slate-900">Print Back Sides (Even Pages)</h5>
            <p class="text-xs text-slate-500 mt-1">
              Reload the printed stack from Step 1 into your paper tray without changing sheet order, then print this file.
            </p>
          </div>

          <div class="p-3 bg-slate-50 rounded-xl text-[11px] text-slate-600 border border-slate-100 flex items-center gap-2">
            <span>🔄</span>
            <span id="step2-reverse-label">Calibrated with reversed page order for face-down output.</span>
          </div>

          <button
            type="button"
            id="btn-download-step2"
            class="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-3 px-4 rounded-xl text-xs shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download Step 2 (Backs PDF)</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODE 2: SCANNER ADF INTERLEAVER            -->
  <!-- ========================================== -->
  <div id="section-interleave-mode" class="hidden space-y-6">
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6">
      <div class="text-center max-w-lg mx-auto">
        <h3 class="text-lg font-bold text-slate-900 mb-1">
          Re-Weave Two-Sided Scanner Feeder (ADF) Files
        </h3>
        <p class="text-xs text-slate-500">
          Upload the Front Sides scan and Back Sides scan. AirPDF automatically reverses the back stack and merges them into perfect 1, 2, 3, 4 sequence.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Fronts Dropzone -->
        <div
          id="dropzone-fronts"
          class="relative border-2 border-dashed border-slate-300 hover:border-indigo-500 rounded-2xl p-6 text-center cursor-pointer bg-slate-50/50 hover:bg-indigo-50/20 transition-all group"
        >
          <input type="file" id="input-fronts" accept="application/pdf" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto mb-2 group-hover:scale-110 transition-transform">
            <span>1️⃣</span>
          </div>
          <div class="text-xs font-bold text-slate-800" id="label-fronts-title">1. Drop Front Sides PDF</div>
          <p class="text-[11px] text-slate-500 mt-0.5" id="label-fronts-meta">Pages 1, 3, 5...</p>
        </div>

        <!-- Backs Dropzone -->
        <div
          id="dropzone-backs"
          class="relative border-2 border-dashed border-slate-300 hover:border-indigo-500 rounded-2xl p-6 text-center cursor-pointer bg-slate-50/50 hover:bg-indigo-50/20 transition-all group"
        >
          <input type="file" id="input-backs" accept="application/pdf" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto mb-2 group-hover:scale-110 transition-transform">
            <span>2️⃣</span>
          </div>
          <div class="text-xs font-bold text-slate-800" id="label-backs-title">2. Drop Back Sides PDF</div>
          <p class="text-[11px] text-slate-500 mt-0.5" id="label-backs-meta">Pages 6, 4, 2 (or 2, 4, 6)</p>
        </div>
      </div>

      <!-- Settings -->
      <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 flex items-center justify-between">
        <label class="flex items-center gap-2 cursor-pointer">
          <input
            type="checkbox"
            id="opt-reverse-backs-scan"
            checked
            class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500"
          />
          <span class="text-xs font-semibold text-slate-700">
            Back stack was scanned in reverse order (Standard automatic feeder behavior)
          </span>
        </label>
      </div>

      <!-- Interleave Action Button -->
      <button
        type="button"
        id="btn-run-interleave"
        disabled
        class="w-full bg-indigo-600 hover:bg-indigo-700 disabled:opacity-40 disabled:pointer-events-none text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2 cursor-pointer text-xs"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
        </svg>
        <span id="btn-interleave-text">Interleave &amp; Download Combined PDF</span>
      </button>
    </div>
  </div>
</div>

<script>
  import {
    splitForManualDuplex,
    interleavePdfStreams,
    bundleDuplexZip,
    type DuplexSplitResult
  } from '../../lib/pdf/duplexSortEngine';

  // State
  let currentMode: 'print' | 'interleave' = 'print';
  let printPdfBytes: Uint8Array | null = null;
  let printFilename = 'document.pdf';
  let splitResult: DuplexSplitResult | null = null;

  let scanFrontBytes: Uint8Array | null = null;
  let scanBackBytes: Uint8Array | null = null;
  let scanFrontName = 'fronts.pdf';

  // Tabs
  const tabBtnPrint = document.getElementById('tab-btn-print') as HTMLButtonElement;
  const tabBtnInterleave = document.getElementById('tab-btn-interleave') as HTMLButtonElement;
  const sectionPrint = document.getElementById('section-print-mode') as HTMLElement;
  const sectionInterleave = document.getElementById('section-interleave-mode') as HTMLElement;

  // Print Mode DOM
  const printDropzone = document.getElementById('print-dropzone') as HTMLElement;
  const printFileInput = document.getElementById('print-file-input') as HTMLInputElement;
  const printLoading = document.getElementById('print-loading') as HTMLElement;
  const printResults = document.getElementById('print-results') as HTMLElement;
  const printFilenameEl = document.getElementById('print-filename') as HTMLElement;
  const printMetaEl = document.getElementById('print-meta') as HTMLElement;
  const changePrintFileBtn = document.getElementById('btn-change-print-file') as HTMLButtonElement;

  const optReverseEvens = document.getElementById('opt-reverse-evens') as HTMLInputElement;
  const optPadBlank = document.getElementById('opt-pad-blank') as HTMLInputElement;
  const paddingNotice = document.getElementById('padding-notice') as HTMLElement;

  const step1PageCount = document.getElementById('step1-page-count') as HTMLElement;
  const step2PageCount = document.getElementById('step2-page-count') as HTMLElement;
  const step2ReverseLabel = document.getElementById('step2-reverse-label') as HTMLElement;

  const btnDownloadStep1 = document.getElementById('btn-download-step1') as HTMLButtonElement;
  const btnDownloadStep2 = document.getElementById('btn-download-step2') as HTMLButtonElement;
  const btnDownloadBothZip = document.getElementById('btn-download-both-zip') as HTMLButtonElement;

  // Interleave Mode DOM
  const dropzoneFronts = document.getElementById('dropzone-fronts') as HTMLElement;
  const inputFronts = document.getElementById('input-fronts') as HTMLInputElement;
  const labelFrontsTitle = document.getElementById('label-fronts-title') as HTMLElement;
  const labelFrontsMeta = document.getElementById('label-fronts-meta') as HTMLElement;

  const dropzoneBacks = document.getElementById('dropzone-backs') as HTMLElement;
  const inputBacks = document.getElementById('input-backs') as HTMLInputElement;
  const labelBacksTitle = document.getElementById('label-backs-title') as HTMLElement;
  const labelBacksMeta = document.getElementById('label-backs-meta') as HTMLElement;

  const optReverseBacksScan = document.getElementById('opt-reverse-backs-scan') as HTMLInputElement;
  const btnRunInterleave = document.getElementById('btn-run-interleave') as HTMLButtonElement;
  const btnInterleaveText = document.getElementById('btn-interleave-text') as HTMLElement;

  // Tab switching
  tabBtnPrint?.addEventListener('click', () => switchTab('print'));
  tabBtnInterleave?.addEventListener('click', () => switchTab('interleave'));

  function switchTab(mode: 'print' | 'interleave') {
    currentMode = mode;
    if (mode === 'print') {
      tabBtnPrint.classList.add('bg-white', 'text-indigo-700', 'shadow-sm');
      tabBtnPrint.classList.remove('text-slate-600');
      tabBtnInterleave.classList.remove('bg-white', 'text-indigo-700', 'shadow-sm');
      tabBtnInterleave.classList.add('text-slate-600');
      sectionPrint.classList.remove('hidden');
      sectionInterleave.classList.add('hidden');
    } else {
      tabBtnInterleave.classList.add('bg-white', 'text-indigo-700', 'shadow-sm');
      tabBtnInterleave.classList.remove('text-slate-600');
      tabBtnPrint.classList.remove('bg-white', 'text-indigo-700', 'shadow-sm');
      tabBtnPrint.classList.add('text-slate-600');
      sectionInterleave.classList.remove('hidden');
      sectionPrint.classList.add('hidden');
    }
  }

  // Print Mode Dropzone
  printDropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    printDropzone.classList.add('border-indigo-500', 'bg-indigo-50/20');
  });

  printDropzone?.addEventListener('dragleave', () => {
    printDropzone.classList.remove('border-indigo-500', 'bg-indigo-50/20');
  });

  printDropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    printDropzone.classList.remove('border-indigo-500', 'bg-indigo-50/20');
    if (e.dataTransfer?.files?.[0]) {
      handlePrintFile(e.dataTransfer.files[0]);
    }
  });

  printFileInput?.addEventListener('change', () => {
    if (printFileInput.files?.[0]) {
      handlePrintFile(printFileInput.files[0]);
    }
  });

  changePrintFileBtn?.addEventListener('click', () => {
    printResults.classList.add('hidden');
    printDropzone.classList.remove('hidden');
    printFileInput.value = '';
    printPdfBytes = null;
    splitResult = null;
  });

  optReverseEvens?.addEventListener('change', recalculateDuplex);
  optPadBlank?.addEventListener('change', recalculateDuplex);

  async function handlePrintFile(file: File) {
    if (!file.name.toLowerCase().endsWith('.pdf')) {
      alert('Please upload a PDF document.');
      return;
    }
    printFilename = file.name;
    printDropzone.classList.add('hidden');
    printLoading.classList.remove('hidden');

    try {
      const buffer = await file.arrayBuffer();
      printPdfBytes = new Uint8Array(buffer);
      await recalculateDuplex();
      printLoading.classList.add('hidden');
      printResults.classList.remove('hidden');
    } catch (err: any) {
      console.error(err);
      alert('Error parsing PDF: ' + err.message);
      printLoading.classList.add('hidden');
      printDropzone.classList.remove('hidden');
    }
  }

  async function recalculateDuplex() {
    if (!printPdfBytes) return;
    splitResult = await splitForManualDuplex(printPdfBytes, {
      reverseEvenStack: optReverseEvens.checked,
      padOddPageCount: optPadBlank.checked
    });

    printFilenameEl.textContent = printFilename;
    const sheetsNeeded = Math.ceil(splitResult.totalOriginalPages / 2);
    printMetaEl.textContent = `${splitResult.totalOriginalPages} pages • Requires ${sheetsNeeded} paper sheet${sheetsNeeded === 1 ? '' : 's'}`;

    step1PageCount.textContent = `${splitResult.oddPagesCount} pages`;
    step2PageCount.textContent = `${splitResult.evenPagesCount} pages`;

    if (splitResult.wasPadded) {
      paddingNotice.classList.remove('hidden');
    } else {
      paddingNotice.classList.add('hidden');
    }

    if (splitResult.reverseEvenStack) {
      step2ReverseLabel.textContent = 'Calibrated with reversed page order for face-down output.';
    } else {
      step2ReverseLabel.textContent = 'Standard forward page order for face-up output.';
    }
  }

  // Print Download Buttons
  btnDownloadStep1?.addEventListener('click', () => {
    if (!splitResult) return;
    downloadBlob(splitResult.step1OddBytes, `${getCleanName(printFilename)}_Step1_FRONTS.pdf`);
  });

  btnDownloadStep2?.addEventListener('click', () => {
    if (!splitResult) return;
    downloadBlob(splitResult.step2EvenBytes, `${getCleanName(printFilename)}_Step2_BACKS.pdf`);
  });

  btnDownloadBothZip?.addEventListener('click', async () => {
    if (!splitResult) return;
    btnDownloadBothZip.disabled = true;
    const origHtml = btnDownloadBothZip.innerHTML;
    btnDownloadBothZip.innerHTML = `<span class="animate-spin mr-1">⏳</span> Zipping...`;
    try {
      const zipBytes = await bundleDuplexZip(splitResult, printFilename);
      downloadBlob(zipBytes, `${getCleanName(printFilename)}_Duplex_Print_Bundle.zip`, 'application/zip');
    } catch (err: any) {
      alert('Error bundling ZIP: ' + err.message);
    } finally {
      btnDownloadBothZip.disabled = false;
      btnDownloadBothZip.innerHTML = origHtml;
    }
  });

  // Interleave Mode Handlers
  inputFronts?.addEventListener('change', async () => {
    if (inputFronts.files?.[0]) {
      const f = inputFronts.files[0];
      scanFrontName = f.name;
      const buf = await f.arrayBuffer();
      scanFrontBytes = new Uint8Array(buf);
      labelFrontsTitle.textContent = `✓ ${f.name}`;
      labelFrontsMeta.textContent = `${(f.size / 1024).toFixed(1)} KB loaded`;
      dropzoneFronts.classList.add('border-emerald-500', 'bg-emerald-50/20');
      checkInterleaveReady();
    }
  });

  inputBacks?.addEventListener('change', async () => {
    if (inputBacks.files?.[0]) {
      const f = inputBacks.files[0];
      const buf = await f.arrayBuffer();
      scanBackBytes = new Uint8Array(buf);
      labelBacksTitle.textContent = `✓ ${f.name}`;
      labelBacksMeta.textContent = `${(f.size / 1024).toFixed(1)} KB loaded`;
      dropzoneBacks.classList.add('border-emerald-500', 'bg-emerald-50/20');
      checkInterleaveReady();
    }
  });

  function checkInterleaveReady() {
    btnRunInterleave.disabled = !(scanFrontBytes && scanBackBytes);
  }

  btnRunInterleave?.addEventListener('click', async () => {
    if (!scanFrontBytes || !scanBackBytes) return;
    btnRunInterleave.disabled = true;
    const origText = btnInterleaveText.textContent;
    btnInterleaveText.textContent = 'Interleaving pages...';

    try {
      const outBytes = await interleavePdfStreams(scanFrontBytes, scanBackBytes, {
        reverseSecondStack: optReverseBacksScan.checked
      });
      downloadBlob(outBytes, `${getCleanName(scanFrontName)}_interleaved.pdf`);
    } catch (err: any) {
      alert('Error interleaving PDFs: ' + err.message);
    } finally {
      btnRunInterleave.disabled = false;
      btnInterleaveText.textContent = origText;
    }
  });

  function downloadBlob(data: Uint8Array, filename: string, mime: string = 'application/pdf') {
    const blob = new Blob([data as unknown as BlobPart], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function getCleanName(filename: string): string {
    return filename.replace(/\.pdf$/i, '').replace(/[^a-zA-Z0-9_-]/g, '_');
  }
</script>
