---
// src/components/tools/OrganizePdfIsland.astro
---

<div class="w-full max-w-5xl mx-auto">
  <!-- 1. Dropzone Section -->
  <div
    id="organize-dropzone"
    class="relative border-2 border-dashed border-slate-300 hover:border-blue-500 bg-white/80 hover:bg-blue-50/20 transition-all rounded-3xl p-8 sm:p-12 text-center cursor-pointer shadow-sm group"
  >
    <input
      type="file"
      id="organize-file-input"
      accept="application/pdf"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
    />
    <div class="flex flex-col items-center justify-center pointer-events-none">
      <div class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-blue-100 transition-all shadow-inner">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
      </div>
      <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2">
        Drop your PDF to visually reorder &amp; organize pages
      </h3>
      <p class="text-xs sm:text-sm text-slate-500 max-w-md mb-4">
        Drag and drop thumbnails to rearrange, 1-click reverse scanner duplex order, rotate pages, duplicate, or delete unwanted sheets.
      </p>
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">
        <svg class="w-4 h-4 text-blue-600" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        100% Vector Quality • Zero Server Upload • Instant Drag &amp; Drop
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400">
      <span>100% In-Browser</span>
      <span>•</span>
      <span>Duplex Reverse</span>
      <span>•</span>
      <span>Insert Dividers</span>
      <span>•</span>
      <span>No File Size Limits</span>
    </div>
  </div>

  <!-- 2. Loading State -->
  <div id="organize-loading" class="hidden bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm text-center space-y-4">
    <div class="w-12 h-12 border-4 border-blue-200 border-t-blue-600 rounded-full animate-spin mx-auto"></div>
    <h3 class="text-base font-bold text-slate-900" id="organize-loading-status">
      Rendering interactive page grid...
    </h3>
    <p class="text-xs text-slate-500 max-w-md mx-auto">
      Generating high-resolution canvas thumbnails in local browser memory.
    </p>
  </div>

  <!-- 3. Workbench Panel -->
  <div id="organize-workbench" class="hidden bg-white rounded-3xl border border-slate-200 p-5 sm:p-8 shadow-sm space-y-6 text-left">
    <!-- Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm shrink-0">
          PDF
        </div>
        <div>
          <h4 id="organize-filename" class="font-bold text-slate-900 text-sm truncate max-w-xs sm:max-w-md">
            document.pdf
          </h4>
          <p id="organize-meta" class="text-xs text-slate-500">
            0 pages loaded
          </p>
        </div>
      </div>
      <button type="button" id="organize-change-file-btn" class="text-xs font-medium text-slate-500 hover:text-slate-800 hover:underline cursor-pointer">
        Change File
      </button>
    </div>

    <!-- Batch Action Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 p-3 rounded-2xl bg-slate-50 border border-slate-200/80">
      <div class="flex flex-wrap items-center gap-2">
        <!-- Reverse Order -->
        <button
          type="button"
          id="btn-reverse-order"
          class="px-3 py-1.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200 shadow-sm transition flex items-center gap-1.5 cursor-pointer"
          title="Invert page order (flips backwards scanner duplex scans)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="17 1 21 5 17 9"></polyline>
            <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
            <polyline points="7 23 3 19 7 15"></polyline>
            <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
          </svg>
          Reverse Order
        </button>

        <!-- Rotate All -->
        <button
          type="button"
          id="btn-rotate-all"
          class="px-3 py-1.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200 shadow-sm transition flex items-center gap-1.5 cursor-pointer"
          title="Rotate all pages clockwise 90 degrees"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          Rotate All (+90°)
        </button>

        <!-- Insert Blank Page -->
        <button
          type="button"
          id="btn-insert-blank"
          class="px-3 py-1.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold border border-slate-200 shadow-sm transition flex items-center gap-1.5 cursor-pointer"
          title="Insert a clean blank divider page at the end"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Insert Blank Page
        </button>

        <!-- Reset -->
        <button
          type="button"
          id="btn-reset-order"
          class="px-3 py-1.5 rounded-xl bg-white hover:bg-slate-100 text-slate-500 hover:text-slate-800 text-xs font-medium border border-slate-200 shadow-sm transition cursor-pointer"
        >
          Reset Layout
        </button>
      </div>

      <!-- Live Page Count Status -->
      <span class="text-xs font-mono text-slate-500 px-2" id="workbench-page-status">
        0 Pages
      </span>
    </div>

    <!-- Interactive Thumbnail Grid -->
    <div
      id="thumbnail-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 min-h-[220px] p-2"
    >
      <!-- Cards dynamically rendered via JavaScript -->
    </div>

    <!-- Export Action Banner -->
    <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-slate-500">
        Tip: Drag any card to reorder. Use card action buttons to rotate, duplicate, or delete.
      </div>
      <button
        type="button"
        id="btn-export-pdf"
        class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-8 rounded-2xl shadow-lg shadow-blue-600/25 transition-all flex items-center justify-center gap-2 group cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span id="btn-export-text">Download Organized PDF</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { reorganizePdfDocument, type PagePlan } from '../../lib/pdf/organizeEngine';

  interface PageItem {
    id: string;
    sourceIndex: number; // -1 for blank page
    rotation: number; // 0, 90, 180, 270
    canvasDataUrl?: string;
  }

  let rawPdfBytes: Uint8Array | null = null;
  let originalFilename = 'document.pdf';
  let pdfDocProxy: any = null;
  let pageItems: PageItem[] = [];
  let originalItemsBackup: PageItem[] = [];
  let draggedCardId: string | null = null;

  // DOM Elements
  const dropzone = document.getElementById('organize-dropzone') as HTMLElement;
  const fileInput = document.getElementById('organize-file-input') as HTMLInputElement;
  const loading = document.getElementById('organize-loading') as HTMLElement;
  const workbench = document.getElementById('organize-workbench') as HTMLElement;
  const filenameEl = document.getElementById('organize-filename') as HTMLElement;
  const metaEl = document.getElementById('organize-meta') as HTMLElement;
  const pageStatusEl = document.getElementById('workbench-page-status') as HTMLElement;
  const thumbnailGrid = document.getElementById('thumbnail-grid') as HTMLElement;
  const changeFileBtn = document.getElementById('organize-change-file-btn') as HTMLButtonElement;
  const reverseBtn = document.getElementById('btn-reverse-order') as HTMLButtonElement;
  const rotateAllBtn = document.getElementById('btn-rotate-all') as HTMLButtonElement;
  const insertBlankBtn = document.getElementById('btn-insert-blank') as HTMLButtonElement;
  const resetBtn = document.getElementById('btn-reset-order') as HTMLButtonElement;
  const exportBtn = document.getElementById('btn-export-pdf') as HTMLButtonElement;
  const exportBtnText = document.getElementById('btn-export-text') as HTMLElement;

  // Drag and Drop files onto dropzone
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-blue-500', 'bg-blue-50/20');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-blue-500', 'bg-blue-50/20');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-blue-500', 'bg-blue-50/20');
    if (e.dataTransfer?.files?.[0]) {
      handleFile(e.dataTransfer.files[0]);
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.[0]) {
      handleFile(fileInput.files[0]);
    }
  });

  changeFileBtn?.addEventListener('click', () => {
    workbench.classList.add('hidden');
    dropzone.classList.remove('hidden');
    fileInput.value = '';
    rawPdfBytes = null;
    pageItems = [];
  });

  async function handleFile(file: File) {
    if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
      alert('Please upload a valid PDF document.');
      return;
    }

    originalFilename = file.name;
    dropzone.classList.add('hidden');
    loading.classList.remove('hidden');

    try {
      const buffer = await file.arrayBuffer();
      rawPdfBytes = new Uint8Array(buffer);

      // @ts-ignore
      const pdfjsLib = window.pdfjsLib || await import('pdfjs-dist');
      if (pdfjsLib.GlobalWorkerOptions && !pdfjsLib.GlobalWorkerOptions.workerSrc) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }

      pdfDocProxy = await pdfjsLib.getDocument({ data: rawPdfBytes.slice(0) }).promise;
      const numPages = pdfDocProxy.numPages;

      pageItems = [];
      for (let i = 1; i <= numPages; i++) {
        const page = await pdfDocProxy.getPage(i);
        const viewport = page.getViewport({ scale: 0.35 });

        const canvas = document.createElement('canvas');
        canvas.width = Math.round(viewport.width);
        canvas.height = Math.round(viewport.height);
        const ctx = canvas.getContext('2d');
        if (ctx) {
          await page.render({ canvasContext: ctx, viewport }).promise;
        }

        pageItems.push({
          id: 'page-' + Math.random().toString(36).substring(2, 9),
          sourceIndex: i - 1,
          rotation: 0,
          canvasDataUrl: canvas.toDataURL('image/jpeg', 0.8),
        });
      }

      originalItemsBackup = JSON.parse(JSON.stringify(pageItems));

      renderGrid();

      loading.classList.add('hidden');
      workbench.classList.remove('hidden');
      filenameEl.textContent = originalFilename;
      metaEl.textContent = `${numPages} page${numPages > 1 ? 's' : ''} • ${(file.size / 1024 / 1024).toFixed(2)} MB`;
    } catch (err: any) {
      console.error(err);
      alert('Error parsing PDF: ' + (err.message || err));
      loading.classList.add('hidden');
      dropzone.classList.remove('hidden');
    }
  }

  function renderGrid() {
    thumbnailGrid.innerHTML = '';
    pageStatusEl.textContent = `${pageItems.length} Page${pageItems.length !== 1 ? 's' : ''}`;

    pageItems.forEach((item, index) => {
      const card = document.createElement('div');
      card.className = 'relative group border-2 border-slate-200 hover:border-blue-500 rounded-2xl bg-white p-2.5 shadow-sm transition-all flex flex-col items-center justify-between cursor-grab active:cursor-grabbing select-none';
      card.draggable = true;
      card.dataset.id = item.id;

      // Header Tag: Sequence Index & Source
      const header = document.createElement('div');
      header.className = 'w-full flex items-center justify-between text-[11px] font-mono mb-2 px-1';
      
      const newIndexBadge = document.createElement('span');
      newIndexBadge.className = 'font-bold text-slate-800 bg-slate-100 px-1.5 py-0.5 rounded';
      newIndexBadge.textContent = `#${index + 1}`;
      header.appendChild(newIndexBadge);

      if (item.sourceIndex === -1) {
        const blankBadge = document.createElement('span');
        blankBadge.className = 'text-[10px] text-emerald-600 bg-emerald-50 px-1 rounded font-semibold';
        blankBadge.textContent = 'BLANK';
        header.appendChild(blankBadge);
      } else if (item.sourceIndex !== index) {
        const origBadge = document.createElement('span');
        origBadge.className = 'text-[10px] text-slate-400';
        origBadge.textContent = `(was #${item.sourceIndex + 1})`;
        header.appendChild(origBadge);
      }
      card.appendChild(header);

      // Thumbnail Image with CSS rotation
      const thumbWrap = document.createElement('div');
      thumbWrap.className = 'w-full h-36 flex items-center justify-center overflow-hidden rounded-lg bg-slate-50 border border-slate-100 p-1 mb-2';

      if (item.sourceIndex === -1) {
        const blankBox = document.createElement('div');
        blankBox.className = 'w-full h-full border-2 border-dashed border-slate-300 rounded flex items-center justify-center text-xs text-slate-400 font-medium';
        blankBox.textContent = 'Blank Sheet';
        thumbWrap.appendChild(blankBox);
      } else if (item.canvasDataUrl) {
        const img = document.createElement('img');
        img.src = item.canvasDataUrl;
        img.className = 'max-w-full max-h-full object-contain transition-transform duration-200';
        img.style.transform = `rotate(${item.rotation}deg)`;
        thumbWrap.appendChild(img);
      }
      card.appendChild(thumbWrap);

      // Bottom Toolbar Actions (Rotate, Duplicate, Delete)
      const actions = document.createElement('div');
      actions.className = 'w-full flex items-center justify-around pt-1 border-t border-slate-100 text-slate-500';

      // Rotate Button
      const rotBtn = document.createElement('button');
      rotBtn.type = 'button';
      rotBtn.title = 'Rotate 90 degrees';
      rotBtn.className = 'p-1.5 rounded-lg hover:bg-slate-100 hover:text-blue-600 transition';
      rotBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 4 23 10 17 10"></polyline>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
        </svg>
      `;
      rotBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        item.rotation = (item.rotation + 90) % 360;
        renderGrid();
      });
      actions.appendChild(rotBtn);

      // Duplicate Button
      const dupBtn = document.createElement('button');
      dupBtn.type = 'button';
      dupBtn.title = 'Duplicate this page';
      dupBtn.className = 'p-1.5 rounded-lg hover:bg-slate-100 hover:text-emerald-600 transition';
      dupBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      `;
      dupBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const copy: PageItem = {
          ...item,
          id: 'page-' + Math.random().toString(36).substring(2, 9),
        };
        pageItems.splice(index + 1, 0, copy);
        renderGrid();
      });
      actions.appendChild(dupBtn);

      // Delete Button
      const delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.title = 'Delete this page';
      delBtn.className = 'p-1.5 rounded-lg hover:bg-rose-50 hover:text-rose-600 transition';
      delBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
      `;
      delBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (pageItems.length <= 1) {
          alert('You must keep at least one page in the document.');
          return;
        }
        pageItems.splice(index, 1);
        renderGrid();
      });
      actions.appendChild(delBtn);

      card.appendChild(actions);

      // HTML5 Drag Events
      card.addEventListener('dragstart', (e) => {
        draggedCardId = item.id;
        card.classList.add('opacity-40', 'border-blue-600');
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', item.id);
        }
      });

      card.addEventListener('dragend', () => {
        draggedCardId = null;
        card.classList.remove('opacity-40', 'border-blue-600');
      });

      card.addEventListener('dragover', (e) => {
        e.preventDefault();
        card.classList.add('scale-105', 'border-blue-500');
      });

      card.addEventListener('dragleave', () => {
        card.classList.remove('scale-105', 'border-blue-500');
      });

      card.addEventListener('drop', (e) => {
        e.preventDefault();
        card.classList.remove('scale-105', 'border-blue-500');
        if (!draggedCardId || draggedCardId === item.id) return;

        const fromIdx = pageItems.findIndex((p) => p.id === draggedCardId);
        const toIdx = index;
        if (fromIdx !== -1 && toIdx !== -1) {
          const [moved] = pageItems.splice(fromIdx, 1);
          pageItems.splice(toIdx, 0, moved);
          renderGrid();
        }
      });

      thumbnailGrid.appendChild(card);
    });
  }

  // Batch actions
  reverseBtn?.addEventListener('click', () => {
    pageItems.reverse();
    renderGrid();
  });

  rotateAllBtn?.addEventListener('click', () => {
    pageItems.forEach((p) => {
      p.rotation = (p.rotation + 90) % 360;
    });
    renderGrid();
  });

  insertBlankBtn?.addEventListener('click', () => {
    pageItems.push({
      id: 'blank-' + Math.random().toString(36).substring(2, 9),
      sourceIndex: -1,
      rotation: 0,
    });
    renderGrid();
  });

  resetBtn?.addEventListener('click', () => {
    pageItems = JSON.parse(JSON.stringify(originalItemsBackup));
    renderGrid();
  });

  // Export Organized PDF
  exportBtn?.addEventListener('click', async () => {
    if (!rawPdfBytes || pageItems.length === 0) return;

    exportBtn.disabled = true;
    exportBtnText.textContent = 'Assembling Vector PDF...';

    try {
      const plan: PagePlan[] = pageItems.map((p) => ({
        sourcePageIndex: p.sourceIndex,
        rotationDegrees: p.rotation,
      }));

      const outputBytes = await reorganizePdfDocument(rawPdfBytes, plan);

      const blob = new Blob([outputBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = originalFilename.replace(/\.pdf$/i, '') + '-organized.pdf';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    } catch (err: any) {
      console.error(err);
      alert('Error organizing PDF: ' + (err.message || err));
    } finally {
      exportBtn.disabled = false;
      exportBtnText.textContent = 'Download Organized PDF';
    }
  });
</script>
