---
// JpgToPdfIsland.astro - Interactive client-side image to PDF converter
---

<div id="jpgtopdf-island-app" class="w-full max-w-4xl mx-auto my-8 font-sans">
  

  <!-- Error Alert Container -->
  <div id="img-error-banner" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">Image Conversion Error</h4>
      <p id="img-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-img-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active before files selected) -->
  <div
    id="img-drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition shadow-sm hover:shadow-md cursor-pointer group"
  >
    <input
      type="file"
      id="img-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
      multiple
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-slate-100 group-hover:bg-slate-900 flex items-center justify-center text-slate-700 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-brand-600 transition">
      Select images to convert
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop JPG, PNG, or WebP images here, or click to choose from your device.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose Image Files
    </div>

    <div class="mt-6 flex items-center justify-center gap-4 text-xs text-slate-400">
      <span>Cap: Max 100MB</span>
      <span>•</span>
      <span>Multi-image compile</span>
      <span>•</span>
      <span>Reorderable</span>
    </div>
  </div>

  <!-- 2. Settings & Queue Section -->
  <div id="img-settings-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm text-left">
    <!-- Queue Header & Quick Add -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-200 mb-6">
      <div>
        <h3 class="text-base font-bold text-slate-900">Image Queue</h3>
        <p class="text-xs text-slate-500">
          <span id="img-queue-count" class="font-bold text-slate-700">0 images</span>
          <span>•</span>
          <span id="img-queue-size">0 KB</span> total
        </p>
      </div>

      <div class="flex items-center gap-2">
        <label class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 cursor-pointer transition flex items-center gap-1.5">
          <span>+ Add More Images</span>
          <input
            type="file"
            id="img-add-more-input"
            class="hidden"
            accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
            multiple
          />
        </label>
        <button
          type="button"
          id="img-clear-all-btn"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-red-600 bg-slate-100 hover:bg-red-50 border border-slate-200 transition"
        >
          Clear All
        </button>
      </div>
    </div>

    <!-- Image Cards List -->
    <div id="img-queue-list" class="space-y-2 mb-8 max-h-[350px] overflow-y-auto pr-1">
      <!-- Dynamically generated image items -->
    </div>

    <!-- Layout & Formatting Controls -->
    <div class="pt-6 border-t border-slate-200">
      <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-4">PDF Page Layout</h4>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Page Size -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Page Size</label>
          <select
            id="img-page-size-select"
            class="w-full px-3 py-2 text-xs font-medium border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-brand-500 outline-none"
          >
            <option value="fit" selected>Fit to Image (Natural)</option>
            <option value="a4">A4 (Standard 210 × 297mm)</option>
            <option value="letter">US Letter (8.5 × 11 in)</option>
          </select>
        </div>

        <!-- Orientation -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Orientation</label>
          <select
            id="img-orientation-select"
            class="w-full px-3 py-2 text-xs font-medium border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-brand-500 outline-none"
          >
            <option value="auto" selected>Auto (Per Image Ratio)</option>
            <option value="portrait">Portrait (Vertical)</option>
            <option value="landscape">Landscape (Horizontal)</option>
          </select>
        </div>

        <!-- Margins -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Margins</label>
          <select
            id="img-margin-select"
            class="w-full px-3 py-2 text-xs font-medium border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-brand-500 outline-none"
          >
            <option value="none" selected>No Margin (Edge-to-Edge)</option>
            <option value="small">Small Margin (20pt)</option>
            <option value="large">Large Margin (40pt)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Action Bar -->
    <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-end">
      <button
        type="button"
        id="start-img-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-xs text-white bg-slate-900 hover:bg-slate-800 active:scale-[0.98] shadow-button transition flex items-center justify-center gap-2"
      >
        <span>Convert to PDF & Download</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 3. Progress State -->
  <div id="img-progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600">
      <svg class="animate-spin w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
    </div>

    <h3 class="text-lg font-bold text-slate-800 mb-1">Converting Images to PDF...</h3>
    <p id="img-progress-message" class="text-xs text-slate-500 mb-6 font-medium">Encoding image pages into PDF document...</p>

    <!-- Progress Bar -->
    <div class="w-full max-w-md mx-auto bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200">
      <div id="img-progress-bar-fill" class="bg-blue-600 h-full w-0 rounded-full transition-all duration-300"></div>
    </div>
    <span id="img-progress-percent" class="block text-xs font-semibold text-slate-700 mt-2">0%</span>
  </div>

  <!-- 4. Success State -->
  <div id="img-success-section" class="hidden bg-white rounded-2xl border border-emerald-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
    </div>

    <h3 class="text-2xl font-extrabold text-slate-900 mb-2">Images Converted to PDF!</h3>
    <p class="text-sm text-slate-600 mb-6">
      File ready for download: <span id="img-output-info" class="font-bold text-slate-800">--</span>
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <button
        type="button"
        id="img-download-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 shadow-md shadow-emerald-500/20 transition flex items-center justify-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download PDF</span>
      </button>

      <button
        type="button"
        id="img-reset-btn"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition"
      >
        Convert More Images
      </button>
    </div>
  </div>
</div>

<script>
  import { imagesToPdf, type ImagePdfOptions, type ImagePageOrientation, type ImagePageSize, type ImageMargin } from '../../lib/pdf/imagesToPdf';
  import { MAX_FILE_SIZE_BYTES } from '../../lib/pdf/merge';

  interface QueuedImage {
    id: string;
    file: File;
    previewUrl: string;
  }

  let queue: QueuedImage[] = [];
  let downloadedBlobUrl: string | null = null;

  // DOM Elements
  const dropZone = document.getElementById('img-drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('img-file-input') as HTMLInputElement;
  const addMoreInput = document.getElementById('img-add-more-input') as HTMLInputElement;
  const settingsSection = document.getElementById('img-settings-section') as HTMLDivElement;
  const queueCountEl = document.getElementById('img-queue-count') as HTMLSpanElement;
  const queueSizeEl = document.getElementById('img-queue-size') as HTMLSpanElement;
  const queueList = document.getElementById('img-queue-list') as HTMLDivElement;
  const clearAllBtn = document.getElementById('img-clear-all-btn') as HTMLButtonElement;

  const pageSizeSelect = document.getElementById('img-page-size-select') as HTMLSelectElement;
  const orientationSelect = document.getElementById('img-orientation-select') as HTMLSelectElement;
  const marginSelect = document.getElementById('img-margin-select') as HTMLSelectElement;
  const startImgBtn = document.getElementById('start-img-btn') as HTMLButtonElement;

  const errorBanner = document.getElementById('img-error-banner') as HTMLDivElement;
  const errorMessage = document.getElementById('img-error-message') as HTMLParagraphElement;
  const dismissErrorBtn = document.getElementById('dismiss-img-error') as HTMLButtonElement;

  const progressSection = document.getElementById('img-progress-section') as HTMLDivElement;
  const progressMessage = document.getElementById('img-progress-message') as HTMLParagraphElement;
  const progressBarFill = document.getElementById('img-progress-bar-fill') as HTMLDivElement;
  const progressPercent = document.getElementById('img-progress-percent') as HTMLSpanElement;

  const successSection = document.getElementById('img-success-section') as HTMLDivElement;
  const outputInfoEl = document.getElementById('img-output-info') as HTMLSpanElement;
  const downloadBtn = document.getElementById('img-download-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('img-reset-btn') as HTMLButtonElement;

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function showError(msg: string) {
    if (errorMessage && errorBanner) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function clearError() {
    if (errorBanner) errorBanner.classList.add('hidden');
  }

  dismissErrorBtn?.addEventListener('click', clearError);

  function renderQueue() {
    queueList.innerHTML = '';
    const totalBytes = queue.reduce((sum, item) => sum + item.file.size, 0);

    queueCountEl.textContent = `${queue.length} ${queue.length === 1 ? 'image' : 'images'}`;
    queueSizeEl.textContent = formatBytes(totalBytes);

    if (queue.length === 0) {
      settingsSection.classList.add('hidden');
      dropZone.classList.remove('hidden');
      return;
    }

    queue.forEach((item, index) => {
      const card = document.createElement('div');
      card.className = 'img-item flex items-center justify-between p-2.5 bg-slate-50 border border-slate-200 rounded-xl hover:border-brand-300 transition text-xs';
      card.dataset.id = item.id;

      card.innerHTML = `
        <div class="flex items-center gap-3 min-w-0 pr-2">
          <span class="w-5 text-center font-bold text-slate-400">${index + 1}</span>
          <img src="${item.previewUrl}" alt="${item.file.name}" class="w-12 h-12 object-cover rounded-lg border border-slate-200 bg-white flex-shrink-0" />
          <div class="min-w-0">
            <p class="font-bold text-slate-800 truncate">${item.file.name}</p>
            <p class="text-slate-500 text-[11px]">${formatBytes(item.file.size)}</p>
          </div>
        </div>

        <div class="flex items-center gap-1 flex-shrink-0">
          <button type="button" class="move-up-btn p-1.5 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-200 disabled:opacity-30 disabled:pointer-events-none transition" ${index === 0 ? 'disabled' : ''} title="Move Up">
            ▲
          </button>
          <button type="button" class="move-down-btn p-1.5 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-200 disabled:opacity-30 disabled:pointer-events-none transition" ${index === queue.length - 1 ? 'disabled' : ''} title="Move Down">
            ▼
          </button>
          <button type="button" class="delete-btn p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition ml-1" title="Remove">
            ✕
          </button>
        </div>
      `;

      card.querySelector('.move-up-btn')?.addEventListener('click', () => {
        if (index > 0) {
          const temp = queue[index];
          queue[index] = queue[index - 1];
          queue[index - 1] = temp;
          renderQueue();
        }
      });

      card.querySelector('.move-down-btn')?.addEventListener('click', () => {
        if (index < queue.length - 1) {
          const temp = queue[index];
          queue[index] = queue[index + 1];
          queue[index + 1] = temp;
          renderQueue();
        }
      });

      card.querySelector('.delete-btn')?.addEventListener('click', () => {
        URL.revokeObjectURL(item.previewUrl);
        queue = queue.filter((q) => q.id !== item.id);
        renderQueue();
      });

      queueList.appendChild(card);
    });
  }

  function handleFilesAdded(files: FileList | File[]) {
    clearError();
    const newItems: QueuedImage[] = [];
    let currentTotal = queue.reduce((sum, item) => sum + item.file.size, 0);

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      if (currentTotal + file.size > MAX_FILE_SIZE_BYTES) {
        showError(`Adding "${file.name}" would exceed the 100MB limit.`);
        break;
      }
      currentTotal += file.size;
      newItems.push({
        id: Math.random().toString(36).substring(2, 9),
        file,
        previewUrl: URL.createObjectURL(file),
      });
    }

    if (newItems.length > 0) {
      queue.push(...newItems);
      dropZone.classList.add('hidden');
      settingsSection.classList.remove('hidden');
      renderQueue();
    }
  }

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFilesAdded(target.files);
      target.value = '';
    }
  });

  addMoreInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFilesAdded(target.files);
      target.value = '';
    }
  });

  clearAllBtn?.addEventListener('click', () => {
    queue.forEach((item) => URL.revokeObjectURL(item.previewUrl));
    queue = [];
    renderQueue();
  });

  // Drag and drop handlers
  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.add('border-brand-500', 'bg-brand-50/40');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-brand-500', 'bg-brand-50/40');
    });
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      handleFilesAdded(e.dataTransfer.files);
    }
  });

  // Execute Conversion
  startImgBtn?.addEventListener('click', async () => {
    if (queue.length === 0) return;

    settingsSection.classList.add('hidden');
    progressSection.classList.remove('hidden');
    clearError();

    const options: ImagePdfOptions = {
      orientation: orientationSelect.value as ImagePageOrientation,
      pageSize: pageSizeSelect.value as ImagePageSize,
      margin: marginSelect.value as ImageMargin,
    };

    const filesToConvert = queue.map((q) => q.file);
    const filename = 'images-converted.pdf';

    try {
      const pdfBytes = await imagesToPdf(filesToConvert, options, (prog) => {
        progressMessage.textContent = prog.message;
        progressBarFill.style.width = `${prog.percent}%`;
        progressPercent.textContent = `${prog.percent}%`;
      });

      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      if (downloadedBlobUrl) URL.revokeObjectURL(downloadedBlobUrl);
      downloadedBlobUrl = URL.createObjectURL(blob);

      outputInfoEl.textContent = `${filename} (${formatBytes(pdfBytes.byteLength)})`;

      // Auto trigger download
      triggerDownload();

      progressSection.classList.add('hidden');
      successSection.classList.remove('hidden');
    } catch (err: any) {
      progressSection.classList.add('hidden');
      settingsSection.classList.remove('hidden');
      showError(err.message || 'An error occurred during conversion.');
    }
  });

  function triggerDownload() {
    if (!downloadedBlobUrl) return;
    const a = document.createElement('a');
    a.href = downloadedBlobUrl;
    a.download = 'images-converted.pdf';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  downloadBtn?.addEventListener('click', triggerDownload);

  resetBtn?.addEventListener('click', () => {
    queue.forEach((item) => URL.revokeObjectURL(item.previewUrl));
    queue = [];
    if (downloadedBlobUrl) {
      URL.revokeObjectURL(downloadedBlobUrl);
      downloadedBlobUrl = null;
    }
    successSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });
</script>
