---
// ProtectPdfIsland.astro - Interactive client-side PDF password protection tool
---

<div id="protect-island-app" class="w-full max-w-4xl mx-auto my-8 font-sans">
  

  <!-- Error Alert Container -->
  <div id="protect-error-banner" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">Protection Error</h4>
      <p id="protect-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-protect-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active before file selection) -->
  <div
    id="protect-drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition shadow-sm hover:shadow-md cursor-pointer group"
  >
    <input
      type="file"
      id="protect-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-slate-100 group-hover:bg-slate-900 flex items-center justify-center text-slate-700 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-brand-600 transition">
      Select PDF to protect with password
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop your PDF file here, or click to choose from your device.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose PDF File
    </div>

    <div class="mt-6 flex items-center justify-center gap-4 text-xs text-slate-400">
      <span>Cap: Max 100MB</span>
      <span>•</span>
      <span>128/256-bit encryption</span>
      <span>•</span>
      <span>Zero cloud uploads</span>
    </div>
  </div>

  <!-- 2. Password Settings Section -->
  <div id="protect-settings-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm text-left">
    <!-- Selected File Header -->
    <div class="flex items-center justify-between pb-6 border-b border-slate-200 mb-6">
      <div class="flex items-center gap-3 min-w-0 pr-2">
        <div class="w-10 h-10 rounded-lg bg-brand-100 text-slate-700 flex items-center justify-center flex-shrink-0 font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p id="protect-file-name" class="text-sm font-bold text-slate-900 truncate">document.pdf</p>
          <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-500">
            <span id="protect-file-size">0 KB</span>
            <span>•</span>
            <span id="protect-page-count" class="font-semibold text-slate-700 bg-brand-50 px-2 py-0.5 rounded border border-brand-200">
              0 pages
            </span>
          </div>
        </div>
      </div>

      <button
        type="button"
        id="protect-change-file-btn"
        class="text-xs font-semibold text-slate-500 hover:text-red-600 transition flex-shrink-0"
      >
        Change File
      </button>
    </div>

    <!-- Password Inputs Grid -->
    <div class="space-y-5 max-w-lg mx-auto">
      <div>
        <label for="protect-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Enter Password
        </label>
        <div class="relative">
          <input
            type="password"
            id="protect-password"
            placeholder="Type your password"
            class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none pr-10"
          />
          <button
            type="button"
            id="toggle-pwd-vis-btn"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs font-semibold"
          >
            Show
          </button>
        </div>

        <!-- Password Strength Meter -->
        <div class="mt-2 flex items-center gap-2">
          <div class="flex-grow bg-slate-100 rounded-full h-1.5 overflow-hidden">
            <div id="pwd-strength-bar" class="h-full w-0 transition-all duration-200 rounded-full bg-slate-300"></div>
          </div>
          <span id="pwd-strength-text" class="text-[11px] font-medium text-slate-400">Empty</span>
        </div>
      </div>

      <div>
        <label for="protect-confirm-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Confirm Password
        </label>
        <input
          type="password"
          id="protect-confirm-password"
          placeholder="Repeat your password"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none"
        />
        <p id="pwd-match-error" class="hidden text-[11px] text-red-600 mt-1 font-medium">Passwords do not match.</p>
      </div>

      <!-- Security Notice -->
      <div class="p-3.5 bg-blue-50/70 border border-blue-200 rounded-xl text-xs text-blue-900 flex items-start gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
        </svg>
        <span>
          <strong>Important:</strong> Because encryption is strictly client-side, AirPDF cannot recover forgotten passwords. Please save a record of your password.
        </span>
      </div>
    </div>

    <!-- Action Bar -->
    <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-end">
      <button
        type="button"
        id="start-protect-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-xs text-white bg-slate-900 hover:bg-slate-800 active:scale-[0.98] shadow-button transition flex items-center justify-center gap-2"
      >
        <span>Protect PDF & Download</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 3. Progress State -->
  <div id="protect-progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600">
      <svg class="animate-spin w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
    </div>

    <h3 class="text-lg font-bold text-slate-800 mb-1">Encrypting PDF Document...</h3>
    <p id="protect-progress-message" class="text-xs text-slate-500 mb-6 font-medium">Applying security encryption in browser memory...</p>

    <!-- Progress Bar -->
    <div class="w-full max-w-md mx-auto bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200">
      <div id="protect-progress-bar-fill" class="bg-blue-600 h-full w-0 rounded-full transition-all duration-300"></div>
    </div>
    <span id="protect-progress-percent" class="block text-xs font-semibold text-slate-700 mt-2">0%</span>
  </div>

  <!-- 4. Success State -->
  <div id="protect-success-section" class="hidden bg-white rounded-2xl border border-emerald-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 2a5 5 0 00-5 5v2a2 2 0 00-2 2v5a2 2 0 002 2h10a2 2 0 002-2v-5a2 2 0 00-2-2H7V7a3 3 0 015.905-.75 1 1 0 001.937-.5A5.002 5.002 0 0010 2z" clip-rule="evenodd" />
      </svg>
    </div>

    <h3 class="text-2xl font-extrabold text-slate-900 mb-2">PDF Protected Successfully!</h3>
    <p class="text-sm text-slate-600 mb-6">
      File ready for download: <span id="protect-output-info" class="font-bold text-slate-800">--</span>
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <button
        type="button"
        id="protect-download-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 shadow-md shadow-emerald-500/20 transition flex items-center justify-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download Protected PDF</span>
      </button>

      <button
        type="button"
        id="protect-reset-btn"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition"
      >
        Protect Another Document
      </button>
    </div>
  </div>
</div>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { protectPdf } from '../../lib/pdf/protect';
  import { MAX_FILE_SIZE_BYTES } from '../../lib/pdf/merge';

  let selectedFile: File | null = null;
  let downloadedBlobUrl: string | null = null;
  let activeFilename = 'document-protected.pdf';

  // DOM Elements
  const dropZone = document.getElementById('protect-drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('protect-file-input') as HTMLInputElement;
  const settingsSection = document.getElementById('protect-settings-section') as HTMLDivElement;
  const fileNameEl = document.getElementById('protect-file-name') as HTMLParagraphElement;
  const fileSizeEl = document.getElementById('protect-file-size') as HTMLSpanElement;
  const pageCountEl = document.getElementById('protect-page-count') as HTMLSpanElement;
  const changeFileBtn = document.getElementById('protect-change-file-btn') as HTMLButtonElement;

  const passwordInput = document.getElementById('protect-password') as HTMLInputElement;
  const confirmPasswordInput = document.getElementById('protect-confirm-password') as HTMLInputElement;
  const togglePwdBtn = document.getElementById('toggle-pwd-vis-btn') as HTMLButtonElement;
  const strengthBar = document.getElementById('pwd-strength-bar') as HTMLDivElement;
  const strengthText = document.getElementById('pwd-strength-text') as HTMLSpanElement;
  const matchError = document.getElementById('pwd-match-error') as HTMLParagraphElement;
  const startBtn = document.getElementById('start-protect-btn') as HTMLButtonElement;

  const errorBanner = document.getElementById('protect-error-banner') as HTMLDivElement;
  const errorMessage = document.getElementById('protect-error-message') as HTMLParagraphElement;
  const dismissErrorBtn = document.getElementById('dismiss-protect-error') as HTMLButtonElement;

  const progressSection = document.getElementById('protect-progress-section') as HTMLDivElement;
  const progressMessage = document.getElementById('protect-progress-message') as HTMLParagraphElement;
  const progressBarFill = document.getElementById('protect-progress-bar-fill') as HTMLDivElement;
  const progressPercent = document.getElementById('protect-progress-percent') as HTMLSpanElement;

  const successSection = document.getElementById('protect-success-section') as HTMLDivElement;
  const outputInfoEl = document.getElementById('protect-output-info') as HTMLSpanElement;
  const downloadBtn = document.getElementById('protect-download-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('protect-reset-btn') as HTMLButtonElement;

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function showError(msg: string) {
    if (errorMessage && errorBanner) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function clearError() {
    if (errorBanner) errorBanner.classList.add('hidden');
  }

  dismissErrorBtn?.addEventListener('click', clearError);

  // Toggle password visibility
  togglePwdBtn?.addEventListener('click', () => {
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      togglePwdBtn.textContent = 'Hide';
    } else {
      passwordInput.type = 'password';
      togglePwdBtn.textContent = 'Show';
    }
  });

  // Calculate password strength
  passwordInput?.addEventListener('input', () => {
    const val = passwordInput.value;
    if (val.length === 0) {
      strengthBar.style.width = '0%';
      strengthBar.className = 'h-full w-0 transition-all duration-200 rounded-full bg-slate-300';
      strengthText.textContent = 'Empty';
      return;
    }

    let score = 0;
    if (val.length >= 6) score += 1;
    if (val.length >= 10) score += 1;
    if (/[A-Z]/.test(val)) score += 1;
    if (/[0-9]/.test(val)) score += 1;
    if (/[^A-Za-z0-9]/.test(val)) score += 1;

    if (score <= 2) {
      strengthBar.style.width = '33%';
      strengthBar.className = 'h-full transition-all duration-200 rounded-full bg-red-500';
      strengthText.textContent = 'Weak';
      strengthText.className = 'text-[11px] font-medium text-red-600';
    } else if (score <= 3) {
      strengthBar.style.width = '66%';
      strengthBar.className = 'h-full transition-all duration-200 rounded-full bg-amber-500';
      strengthText.textContent = 'Fair';
      strengthText.className = 'text-[11px] font-medium text-amber-600';
    } else {
      strengthBar.style.width = '100%';
      strengthBar.className = 'h-full transition-all duration-200 rounded-full bg-emerald-500';
      strengthText.textContent = 'Strong';
      strengthText.className = 'text-[11px] font-medium text-emerald-600';
    }
  });

  async function handleFileSelected(file: File) {
    clearError();
    if (file.size > MAX_FILE_SIZE_BYTES) {
      showError(`The file "${file.name}" (${formatBytes(file.size)}) exceeds the 100MB in-browser limit.`);
      return;
    }

    selectedFile = file;
    fileNameEl.textContent = file.name;
    fileSizeEl.textContent = formatBytes(file.size);

    try {
      const buffer = await file.arrayBuffer();
      const pdfDoc = await PDFDocument.load(buffer);
      const totalPages = pdfDoc.getPageCount();

      pageCountEl.textContent = `${totalPages} ${totalPages === 1 ? 'page' : 'pages'}`;

      dropZone.classList.add('hidden');
      settingsSection.classList.remove('hidden');
    } catch (err: any) {
      showError(`Could not read PDF document: ${err.message}`);
    }
  }

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFileSelected(target.files[0]);
      target.value = '';
    }
  });

  changeFileBtn?.addEventListener('click', () => {
    selectedFile = null;
    passwordInput.value = '';
    confirmPasswordInput.value = '';
    settingsSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  // Drag and drop handlers
  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.add('border-brand-500', 'bg-brand-50/40');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-brand-500', 'bg-brand-50/40');
    });
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      handleFileSelected(e.dataTransfer.files[0]);
    }
  });

  // Execute Protection
  startBtn?.addEventListener('click', async () => {
    if (!selectedFile) return;

    const pwd = passwordInput.value;
    const confirmPwd = confirmPasswordInput.value;

    if (!pwd || pwd.trim().length === 0) {
      showError('Please enter a password.');
      return;
    }

    if (pwd !== confirmPwd) {
      matchError.classList.remove('hidden');
      return;
    } else {
      matchError.classList.add('hidden');
    }

    settingsSection.classList.add('hidden');
    progressSection.classList.remove('hidden');
    clearError();

    const baseName = selectedFile.name.replace(/\.[^/.]+$/, '');
    activeFilename = `${baseName}-protected.pdf`;

    try {
      const encryptedBytes = await protectPdf(selectedFile, pwd, undefined, (prog) => {
        progressMessage.textContent = prog.message;
        progressBarFill.style.width = `${prog.percent}%`;
        progressPercent.textContent = `${prog.percent}%`;
      });

      const blob = new Blob([encryptedBytes], { type: 'application/pdf' });
      if (downloadedBlobUrl) URL.revokeObjectURL(downloadedBlobUrl);
      downloadedBlobUrl = URL.createObjectURL(blob);

      outputInfoEl.textContent = `${activeFilename} (${formatBytes(encryptedBytes.byteLength)})`;

      // Auto trigger download
      triggerDownload();

      progressSection.classList.add('hidden');
      successSection.classList.remove('hidden');
    } catch (err: any) {
      progressSection.classList.add('hidden');
      settingsSection.classList.remove('hidden');
      showError(err.message || 'An error occurred during encryption.');
    }
  });

  function triggerDownload() {
    if (!downloadedBlobUrl) return;
    const a = document.createElement('a');
    a.href = downloadedBlobUrl;
    a.download = activeFilename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  downloadBtn?.addEventListener('click', triggerDownload);

  resetBtn?.addEventListener('click', () => {
    selectedFile = null;
    passwordInput.value = '';
    confirmPasswordInput.value = '';
    if (downloadedBlobUrl) {
      URL.revokeObjectURL(downloadedBlobUrl);
      downloadedBlobUrl = null;
    }
    successSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });
</script>
