  function initSigPad() {
    const ctx = sigPadCanvas.getContext('2d');
    if (!ctx) return;
    ctx.clearRect(0, 0, sigPadCanvas.width, sigPadCanvas.height);
    capturedSignaturePoints = [];

    let isSigning = false;

    sigPadCanvas.onmousedown = (e) => {
      isSigning = true;
      currentDrawingStroke = [];
      const rect = sigPadCanvas.getBoundingClientRect();
      const pt = { x: e.clientX - rect.left, y: e.clientY - rect.top };
      currentDrawingStroke.push(pt);
      ctx.beginPath();
      ctx.moveTo(pt.x, pt.y);
    };

    sigPadCanvas.onmousemove = (e) => {
      if (!isSigning) return;
      const rect = sigPadCanvas.getBoundingClientRect();
      const pt = { x: e.clientX - rect.left, y: e.clientY - rect.top };
      const lastPt = currentDrawingStroke[currentDrawingStroke.length - 1];
      if (lastPt) {
        const dist = Math.hypot(pt.x - lastPt.x, pt.y - lastPt.y);
        if (dist < 2) return; // 2px decimation to avoid overloading vector stream
        const midX = (lastPt.x + pt.x) / 2;
        const midY = (lastPt.y + pt.y) / 2;
        ctx.quadraticCurveTo(lastPt.x, lastPt.y, midX, midY);
        ctx.lineWidth = 2;
        ctx.strokeStyle = '#000000';
        ctx.stroke();
      }
      currentDrawingStroke.push(pt);
    };

    window.onmouseup = () => {
      if (isSigning) {
        isSigning = false;
        if (currentDrawingStroke.length > 0) {
          capturedSignaturePoints.push([...currentDrawingStroke]);
        }
      }
    };
  }

