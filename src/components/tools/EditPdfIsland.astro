  replaceCurrentBtn?.addEventListener('click', () => {
    if (activeMatchIndex >= 0 && activeMatchIndex < currentFindMatches.length) {
      saveHistory();
      const match = currentFindMatches[activeMatchIndex];
      const replacementText = replaceQueryInput.value;

      // 1. Whiteout match box
      annotations.push({
        type: 'whiteout',
        id: `whiteout-${Date.now()}`,
        pageIndex: currentPageIndex,
        x: match.box.x,
        y: match.box.y,
        width: match.box.width + 2,
        height: match.box.height + 2,
      });

      // 2. Place replacement text
      annotations.push({
        type: 'text',
        id: `text-${Date.now()}`,
        pageIndex: currentPageIndex,
        x: match.box.x,
        y: match.box.y,
        text: replacementText,
        fontSize: match.item.fontSize,
        color: '#000000',
      });

      renderAnnotationsOverlay();
    }
  });

  // --- GLOBAL KEYBOARD SHORTCUTS ---
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    const activeEl = document.activeElement;
    const isEditingText = activeEl && (
      activeEl.tagName === 'INPUT' ||
      activeEl.tagName === 'TEXTAREA' ||
      (activeEl as HTMLElement).isContentEditable
    );

    // Delete / Backspace
    if ((e.key === 'Delete' || e.key === 'Backspace') && !isEditingText && selectedAnnotationId) {
      e.preventDefault();
      btnDeleteElement?.click();
    }

    // Ctrl+Z / Cmd+Z (Undo)
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !e.shiftKey && !isEditingText) {
      e.preventDefault();
      btnUndo?.click();
    }

    // Ctrl+Y / Cmd+Shift+Z (Redo)
    if (
      (((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y') ||
       ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 'z')) &&
      !isEditingText
    ) {
      e.preventDefault();
      btnRedo?.click();
    }

    // Escape (Deselect / Close Modals)
    if (e.key === 'Escape') {
      if (selectedAnnotationId) {
        cleanupEmptyTextAnnotations();
        selectedAnnotationId = null;
        renderAnnotationsOverlay();
      }
      sigModal.classList.add('hidden');
    }

    // Arrow keys nudge
    if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key) && !isEditingText && selectedAnnotationId) {
      e.preventDefault();
      const annot = annotations.find(a => a.id === selectedAnnotationId);
      if (annot) {
        const step = e.shiftKey ? 10 : 1;
        if (e.key === 'ArrowUp') annot.y -= step;
        if (e.key === 'ArrowDown') annot.y += step;
        if (e.key === 'ArrowLeft') annot.x -= step;
        if (e.key === 'ArrowRight') annot.x += step;
        renderAnnotationsOverlay();
      }
    }
  });

  // Ctrl + Mouse Wheel Zoom
  viewportContainer?.addEventListener('wheel', async (e: WheelEvent) => {
    if (e.ctrlKey) {
      e.preventDefault();
      if (e.deltaY < 0 && currentZoom < 2.5) {
        currentZoom = Math.min(2.5, currentZoom + 0.15);
        zoomLevelText.textContent = `${Math.round(currentZoom * 100)}%`;
        await renderActivePage();
      } else if (e.deltaY > 0 && currentZoom > 0.5) {
        currentZoom = Math.max(0.5, currentZoom - 0.15);
        zoomLevelText.textContent = `${Math.round(currentZoom * 100)}%`;
        await renderActivePage();
      }
    }
  }, { passive: false });

  // --- APPLY CHANGES (COMPILATION & EXPORT) ---
  btnApplyChanges?.addEventListener('click', async () => {
    if (!originalBytes) return;

    compileModal.classList.remove('hidden');
    compileProgressBar.style.width = '10%';
    compileStatusText.textContent = 'Initializing vector compiler...';

    try {
      const state: DocumentEditState = {
        pages: pageConfigs,
        annotations,
      };

      const editedBytes = await applyPdfEdits(originalBytes.slice(0), state, (progress, statusText) => {
        compileProgressBar.style.width = `${progress}%`;
        compileStatusText.textContent = statusText;
      });

      compileStatusText.textContent = 'Preparing download...';
      compileProgressBar.style.width = '100%';

      // Instant download blob
      const blob = new Blob([editedBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      const originalBaseName = originalFile ? originalFile.name.replace(/\.[^/.]+$/, '') : 'document';
      a.download = `${originalBaseName}_edited.pdf`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      setTimeout(() => {
        compileModal.classList.add('hidden');
        URL.revokeObjectURL(url);
      }, 800);
    } catch (err: any) {
      compileModal.classList.add('hidden');
      showError('Failed to apply edits: ' + (err?.message || 'Unknown error'));
    }
  });
</script>
