  // Render text click targets for Edit Text and Find & Replace
  function renderTextClickTargets() {
    textClickLayer.innerHTML = '';
    const activeConfig = pageConfigs[currentPageIndex];
    if (!activeConfig) return;

    const items = pageTextItemsCache.get(activeConfig.originalIndex + 1) || [];

    if (activeTool === 'editText') {
      textClickLayer.style.pointerEvents = 'auto';
      items.forEach((item) => {
        const target = document.createElement('div');
        target.className = 'absolute cursor-pointer border border-transparent hover:border-blue-400 hover:bg-blue-50/20';
        target.style.left = `${item.x * currentZoom}px`;
        target.style.top = `${item.y * currentZoom}px`;
        target.style.width = `${item.width * currentZoom}px`;
        target.style.height = `${item.height * currentZoom}px`;

        target.addEventListener('click', () => {
          saveHistory();
          // 1. Create whiteout covering the original line with 2px margin
          annotations.push({
            type: 'whiteout',
            id: `whiteout-${Date.now()}`,
            pageIndex: currentPageIndex,
            x: Math.max(0, item.x - 2),
            y: Math.max(0, item.y - 1),
            width: item.width + 4,
            height: item.height + 3,
          });

          // 2. Overlay editable replacement text at same position and font size
          const textId = `text-${Date.now()}`;
          annotations.push({
            type: 'text',
            id: textId,
            pageIndex: currentPageIndex,
            x: item.x,
            y: item.y,
            text: item.str,
            fontSize: item.fontSize,
            color: '#000000',
            bold: isTextBold,
            italic: isTextItalic,
          });

          selectedAnnotationId = textId;
          renderAnnotationsOverlay();

          // 3. Auto-focus and select all text immediately
          setTimeout(() => {
            const textEl = annotationLayer.querySelector(`[data-annot-id="${textId}"] .editable-text`) as HTMLElement;
            if (textEl) {
              textEl.focus();
              const range = document.createRange();
              range.selectNodeContents(textEl);
              const sel = window.getSelection();
              if (sel) {
                sel.removeAllRanges();
                sel.addRange(range);
              }
            }
          }, 50);
        });

        textClickLayer.appendChild(target);
      });
    } else {
      textClickLayer.style.pointerEvents = 'none';
    }
  }

