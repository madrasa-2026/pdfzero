  const findSearchBtn = document.getElementById('find-search-btn') as HTMLButtonElement;
  const findMatchesCount = document.getElementById('find-matches-count') as HTMLSpanElement;
  const replaceCurrentBtn = document.getElementById('replace-current-btn') as HTMLButtonElement;

  function renderFindMatches() {
    textClickLayer.innerHTML = '';
    currentFindMatches.forEach((match, idx) => {
      const el = document.createElement('div');
      el.className = `absolute rounded pointer-events-none transition-all ${
        idx === activeMatchIndex
          ? 'bg-amber-400/60 border-2 border-amber-600 shadow-sm z-10'
          : 'bg-yellow-300/40 border border-yellow-400'
      }`;
      el.style.left = `${match.box.x * currentZoom}px`;
      el.style.top = `${match.box.y * currentZoom}px`;
      el.style.width = `${match.box.width * currentZoom}px`;
      el.style.height = `${match.box.height * currentZoom}px`;
      textClickLayer.appendChild(el);

      if (idx === activeMatchIndex) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }

  findSearchBtn?.addEventListener('click', () => {
    const query = findQueryInput.value.trim();
    if (!query) {
      currentFindMatches = [];
      findMatchesCount.textContent = '0 matches';
      renderFindMatches();
      return;
    }

    const activeConfig = pageConfigs[currentPageIndex];
    if (!activeConfig) return;

    const items = pageTextItemsCache.get(activeConfig.originalIndex + 1) || [];
    currentFindMatches = findTextMatches(items, query);
    findMatchesCount.textContent = `${currentFindMatches.length} matches`;
    activeMatchIndex = currentFindMatches.length > 0 ? 0 : -1;
    renderFindMatches();
  });

  findPrevBtn?.addEventListener('click', () => {
    if (currentFindMatches.length === 0) return;
    activeMatchIndex = (activeMatchIndex - 1 + currentFindMatches.length) % currentFindMatches.length;
