---
// EditPdfIsland.astro - 100% Client-Side Sejda-Style PDF Editor Workbench
---

<div id="edit-island-app" class="w-full max-w-7xl mx-auto my-6 font-sans select-none">
  <!-- 1. Top Privacy Headline Banner -->
  <div class="mb-4 px-4 py-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm font-medium flex items-center justify-between shadow-sm">
    <div class="flex items-center gap-2">
      <span class="text-base">🔒</span>
      <span><strong>100% private</strong> — your file never leaves this device. Nothing uploaded, nothing stored.</span>
    </div>
    <span class="hidden md:inline-block text-emerald-700 text-xs bg-emerald-100/70 px-2 py-0.5 rounded font-mono">Zero Server Uploads</span>
  </div>

  <!-- Error Alert Container -->
  <div id="edit-error-banner" class="hidden mb-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">Editor Error</h4>
      <p id="edit-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-edit-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 2. Drop Zone (Active before file selection) -->
  <div
    id="edit-drop-zone"
    class="relative rounded-2xl border-2 border-dashed border-slate-300 hover:border-slate-400 bg-white shadow-sm hover:shadow-md p-8 sm:p-14 text-center transition cursor-pointer group"
  >
    <input
      type="file"
      id="edit-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
    />

    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-slate-100 group-hover:bg-slate-900 flex items-center justify-center text-slate-700 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
    </div>

    <h3 class="text-2xl font-bold text-slate-900 mb-2">
      Select PDF to Edit
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-md mx-auto">
      Drag & drop your PDF here, or click to open. Add text, edit text, whiteout, shapes, signatures & organize pages client-side.
    </p>

    <div class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition">
      Choose PDF Document
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-400">
      <span>Cap: Max 100MB</span>
      <span>•</span>
      <span>Bengali (বাংলা) typography supported</span>
      <span>•</span>
      <span>100% Client-Side Vector Engine</span>
    </div>
  </div>

  <!-- 3. Workbench Main Interface (Visible once PDF loaded) -->
  <div id="edit-workbench" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden text-left">
    <!-- Top Header: File info, Whiteout Warning, CTA -->
    <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <span class="p-1.5 rounded-lg bg-red-100 text-red-700 text-xs font-bold uppercase">PDF</span>
        <div class="min-w-0">
          <p id="edit-file-name" class="text-sm font-semibold text-slate-800 truncate max-w-xs sm:max-w-md">document.pdf</p>
          <p class="text-xs text-slate-500">
            <span id="edit-file-size">0 KB</span> • <span id="edit-page-counter">Page 1 of 1</span>
          </p>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-undo"
          title="Undo (Ctrl+Z)"
          class="p-2 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-medium"
        >
          ↩ Undo
        </button>
        <button
          type="button"
          id="btn-redo"
          title="Redo (Ctrl+Y)"
          class="p-2 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-medium"
        >
          ↪ Redo
        </button>
        <button
          type="button"
          id="btn-delete-element"
          title="Delete selected element (Delete key)"
          class="p-2 rounded-lg border border-slate-300 text-red-600 hover:bg-red-50 disabled:opacity-40 disabled:cursor-not-allowed text-xs font-medium"
        >
          🗑️ Delete
        </button>
        <button
          type="button"
          id="btn-apply-changes"
          class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-button transition flex items-center gap-1.5"
        >
          <span>✓</span>
          <span>Apply changes</span>
        </button>
      </div>
    </div>

    <!-- Sejda 11-Tool Top Toolbar -->
    <div class="bg-white border-b border-slate-200 px-3 py-2 flex flex-wrap items-center justify-between gap-2 overflow-x-auto">
      <div class="flex items-center gap-1" id="toolbar-buttons">
        <button type="button" data-tool="text" class="tool-btn active-tool px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>🔤</span><span>Text</span>
        </button>
        <button type="button" data-tool="editText" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>✏️</span><span>Edit Text</span>
        </button>
        <button type="button" data-tool="images" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>🖼️</span><span>Images</span>
        </button>
        <button type="button" data-tool="annotate" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>🖍️</span><span>Annotate</span>
        </button>
        <button type="button" data-tool="shapes" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>⬛</span><span>Shapes</span>
        </button>
        <button type="button" data-tool="whiteout" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>⬜</span><span>Whiteout</span>
        </button>
        <button type="button" data-tool="forms" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>📝</span><span>Forms</span>
        </button>
        <button type="button" data-tool="links" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>🔗</span><span>Links</span>
        </button>
        <button type="button" data-tool="sign" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>✒️</span><span>Sign</span>
        </button>
        <button type="button" data-tool="find" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>🔍</span><span>Find</span>
        </button>
        <button type="button" data-tool="pages" class="tool-btn px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
          <span>📄</span><span>Pages</span>
        </button>
      </div>

      <!-- Zoom and Display Controls -->
      <div class="flex items-center gap-2 text-xs">
        <button type="button" id="prev-page-top-btn" class="px-2 py-1 rounded border border-slate-200 hover:bg-slate-100 font-semibold text-slate-700" title="Previous Page">◀</button>
        <span id="page-indicator-top" class="text-slate-600 font-medium">1 / 1</span>
        <button type="button" id="next-page-top-btn" class="px-2 py-1 rounded border border-slate-200 hover:bg-slate-100 font-semibold text-slate-700" title="Next Page">▶</button>
        <div class="h-4 w-[1px] bg-slate-200 mx-1"></div>
        <button type="button" id="zoom-out-btn" class="w-7 h-7 rounded border border-slate-200 hover:bg-slate-100 flex items-center justify-center font-bold" title="Zoom Out">−</button>
        <span id="zoom-level-text" class="font-mono text-slate-600 w-10 text-center">100%</span>
        <button type="button" id="zoom-in-btn" class="w-7 h-7 rounded border border-slate-200 hover:bg-slate-100 flex items-center justify-center font-bold" title="Zoom In">+</button>
        <button type="button" id="zoom-fit-width-btn" class="px-2 py-1 rounded border border-slate-200 hover:bg-slate-100 text-slate-700 font-medium" title="Fit to Width">Fit Width</button>
      </div>
    </div>

    <!-- Tool Options Secondary Sub-bar (dynamic per selected tool) -->
    <div id="sub-tool-bar" class="px-4 py-2 bg-slate-50/70 border-b border-slate-200 flex flex-wrap items-center gap-3 text-xs">
      <!-- Options for Text tool -->
      <div id="sub-opts-text" class="flex items-center gap-2">
        <label class="flex items-center gap-1 font-medium text-slate-700">
          <span>Size:</span>
          <select id="text-size-select" class="rounded border border-slate-300 px-2 py-1 text-xs bg-white">
            <option value="12">12pt</option>
            <option value="14" selected>14pt</option>
            <option value="18">18pt</option>
            <option value="24">24pt</option>
            <option value="32">32pt</option>
          </select>
        </label>
        <button type="button" id="text-bold-btn" class="w-6 h-6 rounded border border-slate-300 font-bold hover:bg-slate-100 flex items-center justify-center text-xs" title="Bold (B)">B</button>
        <button type="button" id="text-italic-btn" class="w-6 h-6 rounded border border-slate-300 italic font-serif hover:bg-slate-100 flex items-center justify-center text-xs" title="Italic (I)">I</button>
        <label class="flex items-center gap-1 font-medium text-slate-700">
          <span>Color:</span>
          <select id="text-color-select" class="rounded border border-slate-300 px-2 py-1 text-xs bg-white">
            <option value="#000000" selected>Obsidian Black</option>
            <option value="#2563eb">Deep Blue</option>
            <option value="#dc2626">Crimson Red</option>
            <option value="#16a34a">Forest Green</option>
            <option value="#ffffff">Crisp White</option>
          </select>
        </label>
        <span class="text-slate-400">|</span>
        <span class="text-slate-500 italic hidden sm:inline">Click document to place text box. Bengali (বাংলা) supported.</span>
      </div>

      <!-- Options for Edit Text tool -->
      <div id="sub-opts-editText" class="hidden flex items-center gap-3">
        <span class="text-amber-800 bg-amber-100 px-2 py-0.5 rounded font-medium">Visual Cover Mode</span>
        <span class="text-slate-600">Click any text line on the page to overlay an auto-whiteout box and edit replacement text in-place.</span>
      </div>

      <!-- Options for Images tool -->
      <div id="sub-opts-images" class="hidden flex items-center gap-3">
        <label class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-slate-300 rounded hover:bg-slate-50 cursor-pointer font-medium text-slate-700">
          <span>Upload Image</span>
          <input type="file" id="image-upload-input" accept="image/png,image/jpeg" class="hidden" />
        </label>
        <span class="text-slate-500">PNG and JPG supported. Click to place after selecting.</span>
      </div>

      <!-- Options for Annotate tool -->
      <div id="sub-opts-annotate" class="hidden flex items-center gap-2">
        <button type="button" id="annot-pen-btn" class="px-2.5 py-1 bg-white border border-slate-300 rounded font-medium text-slate-700 hover:bg-slate-100">🖊️ Freehand Pen</button>
        <button type="button" id="annot-highlight-btn" class="px-2.5 py-1 bg-yellow-100 text-yellow-900 border border-yellow-300 rounded font-medium">Highlight (35%)</button>
        <button type="button" id="annot-strike-btn" class="px-2.5 py-1 bg-white border border-slate-300 rounded font-medium text-slate-700">Strikethrough</button>
        <label class="flex items-center gap-1 font-medium text-slate-700 ml-1">
          <span>Color:</span>
          <input type="color" id="annot-pen-color" value="#dc2626" class="w-6 h-6 p-0 border border-slate-300 rounded cursor-pointer" title="Pen Color" />
        </label>
        <span class="text-slate-500 hidden sm:inline">Draw or highlight on document page.</span>
      </div>

      <!-- Options for Shapes tool -->
      <div id="sub-opts-shapes" class="hidden flex items-center gap-3">
        <label class="flex items-center gap-1 font-medium text-slate-700">
          <span>Shape:</span>
          <select id="shape-type-select" class="rounded border border-slate-300 px-2 py-1 text-xs bg-white">
            <option value="rect" selected>Rectangle</option>
            <option value="circle">Circle / Ellipse</option>
            <option value="line">Straight Line</option>
            <option value="arrow">Arrow</option>
          </select>
        </label>
        <label class="flex items-center gap-1 font-medium text-slate-700">
          <span>Stroke:</span>
          <input type="color" id="shape-stroke-color" value="#2563eb" class="w-6 h-6 p-0 border border-slate-300 rounded" />
        </label>
        <label class="flex items-center gap-1 font-medium text-slate-700">
          <span>Width:</span>
          <select id="shape-width-select" class="rounded border border-slate-300 px-2 py-1 text-xs bg-white">
            <option value="1">1px</option>
            <option value="2" selected>2px</option>
            <option value="4">4px</option>
            <option value="8">8px</option>
          </select>
        </label>
        <span class="text-slate-500">Drag on page to draw shape.</span>
      </div>

      <!-- Options for Whiteout tool -->
      <div id="sub-opts-whiteout" class="hidden flex items-center gap-3">
        <span class="text-amber-800 font-semibold">⚠️ Visual Cover Only:</span>
        <span class="text-amber-700">Covered text remains extractable from the file — not true redaction.</span>
        <span class="text-slate-400">|</span>
        <span class="text-slate-500">Drag to draw whiteout rectangle.</span>
      </div>

      <!-- Options for Forms tool -->
      <div id="sub-opts-forms" class="hidden flex items-center gap-3">
        <button type="button" id="add-form-text-btn" class="px-2.5 py-1 bg-white border border-slate-300 rounded font-medium text-slate-700">+ Text Field</button>
        <button type="button" id="add-form-check-btn" class="px-2.5 py-1 bg-white border border-slate-300 rounded font-medium text-slate-700">+ Checkbox</button>
        <span class="text-slate-500">Click button then click page to place interactive form field.</span>
      </div>

      <!-- Options for Links tool -->
      <div id="sub-opts-links" class="hidden flex items-center gap-3">
        <span class="text-slate-700 font-medium">Link Destination:</span>
        <input type="url" id="link-url-input" placeholder="https://example.com" class="rounded border border-slate-300 px-2.5 py-1 text-xs bg-white w-56" />
        <span class="text-slate-500">Drag region on page to create clickable hyperlink.</span>
      </div>

      <!-- Options for Sign tool -->
      <div id="sub-opts-sign" class="hidden flex items-center gap-3">
        <button type="button" id="open-sign-modal-btn" class="px-3 py-1 bg-slate-900 text-white rounded font-medium">+ Create Signature</button>
        <span id="active-signature-status" class="text-slate-500 italic">No signature created yet. Click "+ Create Signature".</span>
      </div>

      <!-- Options for Find tool -->
      <div id="sub-opts-find" class="hidden flex items-center gap-2">
        <input type="text" id="find-query-input" placeholder="Find in document..." class="rounded border border-slate-300 px-2.5 py-1 text-xs bg-white w-40" />
        <input type="text" id="replace-query-input" placeholder="Replace with..." class="rounded border border-slate-300 px-2.5 py-1 text-xs bg-white w-40" />
        <button type="button" id="find-search-btn" class="px-2 py-1 bg-slate-100 border border-slate-300 rounded font-medium text-slate-700 hover:bg-slate-200">Search</button>
        <button type="button" id="find-prev-btn" class="px-2 py-1 bg-slate-100 border border-slate-300 rounded font-medium text-slate-700 hover:bg-slate-200" title="Previous Match">◀</button>
        <button type="button" id="find-next-btn" class="px-2 py-1 bg-slate-100 border border-slate-300 rounded font-medium text-slate-700 hover:bg-slate-200" title="Next Match">▶</button>
        <span id="find-matches-count" class="font-mono text-slate-600 text-[11px]">0 matches</span>
        <button type="button" id="replace-current-btn" class="px-2 py-1 bg-amber-100 text-amber-900 border border-amber-300 rounded font-medium hover:bg-amber-200">Replace</button>
      </div>

      <!-- Options for Pages tool -->
      <div id="sub-opts-pages" class="hidden flex items-center gap-3">
        <span class="text-slate-700 font-medium">Page Management:</span>
        <span class="text-slate-500">Use the left thumbnail sidebar to reorder (▲/▼), rotate (↻), or delete (🗑️) pages.</span>
      </div>
    </div>

    <!-- Whiteout Warning Notice (Omnipresent callout) -->
    <div id="persistent-whiteout-banner" class="hidden px-4 py-1.5 bg-amber-50 border-b border-amber-200 text-amber-800 text-xs flex items-center gap-2">
      <span class="font-bold">⚠️ Notice:</span>
      <span>Whiteout is visual cover only. Underlying PDF text remains extractable — not true cryptographic redaction.</span>
    </div>

    <!-- Main Workspace Split: Left Thumbnail Strip & Center Viewport Canvas -->
    <div class="flex flex-col lg:flex-row h-[700px] bg-slate-100">
      <!-- Left Thumbnail Strip -->
      <div class="w-full lg:w-64 bg-slate-50 border-r border-slate-200 p-3 overflow-y-auto flex-shrink-0 flex lg:flex-col gap-3">
        <div class="flex items-center justify-between pb-2 border-b border-slate-200 text-xs font-semibold text-slate-700">
          <span>Pages (<span id="total-pages-badge">1</span>)</span>
          <span class="text-slate-400">Reorder / Rotate</span>
        </div>
        <div id="thumbnail-list" class="flex lg:flex-col gap-3">
          <!-- Dynamically populated page cards -->
        </div>
      </div>

      <!-- Center Viewport Area -->
      <div id="viewport-container" class="flex-grow overflow-auto p-4 flex items-center justify-center relative bg-slate-200/60">
        <!-- Document page paper container -->
        <div id="page-paper" class="relative bg-white shadow-lg mx-auto transition-transform origin-top">
          <!-- Base PDF.js Canvas -->
          <canvas id="pdf-page-canvas" class="block"></canvas>

          <!-- Interactive Annotation SVG / DOM Layer -->
          <div id="annotation-layer" class="absolute inset-0 overflow-hidden cursor-crosshair"></div>

          <!-- Text Layer extraction click targets (for Edit Text & Find) -->
          <div id="text-click-layer" class="absolute inset-0 pointer-events-none"></div>

          <!-- Freehand Drawing Canvas for Signatures / Annotations -->
          <canvas id="freehand-canvas" class="absolute inset-0 pointer-events-none"></canvas>

          <!-- Rubber-band Drag-to-Draw Preview Box -->
          <div id="drag-preview-box" class="hidden absolute pointer-events-none border-2 border-dashed border-blue-500 bg-blue-500/20 z-20"></div>

          <!-- Floating In-Place Formatting Toolbar on Selected Annotation -->
          <div id="floating-annot-bar" class="hidden absolute z-30 bg-slate-900 text-white rounded-xl shadow-2xl px-2 py-1.5 flex items-center gap-1.5 text-xs -translate-x-1/2 pointer-events-auto"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. Signature Creation Modal -->
  <div id="signature-modal" class="hidden fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 text-left">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
        <h3 class="text-lg font-bold text-slate-900">Create Signature</h3>
        <button type="button" id="close-sig-modal" class="text-slate-400 hover:text-slate-700 font-bold">✕</button>
      </div>

      <!-- Signature mode tabs -->
      <div class="flex border-b border-slate-200 mb-4 text-xs font-semibold">
        <button type="button" id="sig-tab-draw" class="px-4 py-2 border-b-2 border-slate-900 text-slate-900">Draw (Vector)</button>
        <button type="button" id="sig-tab-type" class="px-4 py-2 text-slate-500 hover:text-slate-700">Type Name</button>
        <button type="button" id="sig-tab-upload" class="px-4 py-2 text-slate-500 hover:text-slate-700">Upload Image</button>
      </div>

      <!-- Tab Content: Draw Mode -->
      <div id="sig-content-draw" class="block">
        <div class="border border-slate-300 rounded-xl bg-slate-50 overflow-hidden mb-3 relative">
          <canvas id="sig-pad-canvas" width="450" height="160" class="w-full h-40 bg-white cursor-crosshair block"></canvas>
          <span class="absolute bottom-2 right-2 text-[10px] text-slate-400">Sign above the line</span>
        </div>
        <div class="flex justify-between items-center text-xs">
          <button type="button" id="clear-sig-pad" class="text-slate-500 hover:text-red-600 font-medium">Clear Canvas</button>
          <span class="text-slate-400">Vector Line Segments</span>
        </div>
      </div>

      <!-- Tab Content: Type Mode -->
      <div id="sig-content-type" class="hidden">
        <input type="text" id="sig-type-input" placeholder="Type your full name..." class="w-full px-3 py-2 border border-slate-300 rounded-xl mb-3 text-sm" />
        <div id="sig-type-preview" class="h-28 border border-slate-200 rounded-xl flex items-center justify-center text-2xl font-serif italic text-slate-800 bg-slate-50">
          Signature Preview
        </div>
      </div>

      <!-- Tab Content: Upload Mode -->
      <div id="sig-content-upload" class="hidden">
        <input type="file" id="sig-upload-input" accept="image/png,image/jpeg" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-900 file:text-white mb-3" />
        <div id="sig-upload-preview" class="h-28 border border-dashed border-slate-300 rounded-xl flex items-center justify-center text-xs text-slate-400">
          Image preview
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="mt-6 flex justify-end gap-3 pt-3 border-t border-slate-200">
        <button type="button" id="cancel-sig-btn" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl">Cancel</button>
        <button type="button" id="save-sig-btn" class="px-5 py-2 text-xs font-semibold bg-slate-900 text-white rounded-xl shadow-button hover:bg-slate-800">Use Signature</button>
      </div>
    </div>
  </div>

  <!-- 5. Compilation & Progress Modal -->
  <div id="compile-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 text-center shadow-2xl border border-slate-200">
      <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-slate-100 flex items-center justify-center text-slate-900">
        <svg class="animate-spin h-6 w-6 text-slate-900" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900 mb-1">Applying Changes</h3>
      <p id="compile-status-text" class="text-xs text-slate-500 mb-4">Compiling vector annotations...</p>
      <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden mb-3">
        <div id="compile-progress-bar" class="bg-slate-900 h-2.5 rounded-full transition-all duration-300" style="width: 10%"></div>
      </div>
      <p class="text-[11px] text-slate-400">100% Client-Side Processing • No file leaves your device</p>
    </div>
  </div>
</div>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap');

  .font-signature {
    font-family: 'Caveat', 'Dancing Script', 'Brush Script MT', cursive;
  }
  .tool-btn {
    color: #475569;
    background-color: transparent;
  }
  .tool-btn:hover {
    background-color: #f1f5f9;
    color: #0f172a;
  }
  .active-tool {
    background-color: #0f172a !important;
    color: #ffffff !important;
  }
  .selected-annot {
    outline: 2px solid #2563eb !important;
    outline-offset: 1px;
  }
  .hover-annot:hover:not(.selected-annot) {
    outline: 1px dashed #60a5fa !important;
    outline-offset: 1px;
  }
  .resize-handle {
    position: absolute;
    width: 8px;
    height: 8px;
    background-color: #ffffff;
    border: 2px solid #2563eb;
    border-radius: 2px;
    z-index: 25;
  }
  .handle-nw { top: -4px; left: -4px; cursor: nwse-resize; }
  .handle-ne { top: -4px; right: -4px; cursor: nesw-resize; }
  .handle-se { bottom: -4px; right: -4px; cursor: nwse-resize; }
  .handle-sw { bottom: -4px; left: -4px; cursor: nesw-resize; }
  .handle-n  { top: -4px; left: calc(50% - 4px); cursor: ns-resize; }
  .handle-s  { bottom: -4px; left: calc(50% - 4px); cursor: ns-resize; }
  .handle-e  { top: calc(50% - 4px); right: -4px; cursor: ew-resize; }
  .handle-w  { top: calc(50% - 4px); left: -4px; cursor: ew-resize; }
</style>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  import { applyPdfEdits, type DocumentEditState, type Annotation, type PageConfig } from '../../lib/pdf/edit';
  import { extractPageTextItems, findTextMatches, type ExtractedTextItem, type TextMatch } from '../../lib/pdf/textExtraction';
  import { MAX_FILE_SIZE_BYTES } from '../../lib/pdf/merge';

  if (typeof window !== 'undefined' && !pdfjsLib.GlobalWorkerOptions.workerSrc) {
    pdfjsLib.GlobalWorkerOptions.workerSrc = '/pdf.worker.min.mjs';
  }

  // --- STATE ---
  let originalFile: File | null = null;
  let originalBytes: Uint8Array | null = null;
  let pdfDocProxy: any = null;
  let totalOriginalPages = 0;
  let currentPageIndex = 0; // 0-based active visual page
  let currentZoom = 1.0;
  let activeTool: string = 'text';

  // Page management state
  let pageConfigs: PageConfig[] = []; // index -> { originalIndex, rotation, isDeleted }

  // Annotations list
  let annotations: Annotation[] = [];
  let selectedAnnotationId: string | null = null;

  // History stack for Undo / Redo
  let undoStack: Annotation[][] = [];
  let redoStack: Annotation[][] = [];

  // Signature state
  let currentSignatureType: 'draw' | 'type' | 'upload' = 'draw';
  let capturedSignaturePoints: { x: number; y: number }[][] = [];
  let currentDrawingStroke: { x: number; y: number }[] = [];
  let activeSignatureData: { points?: { x: number; y: number }[][]; text?: string; imageBytes?: Uint8Array; format?: 'png' | 'jpeg' } | null = null;

  // Active Image & Form states
  let activeImageData: { imageBytes: Uint8Array; format: 'png' | 'jpeg'; width: number; height: number } | null = null;
  let activeFormType: 'text' | 'checkbox' = 'text';
  let currentRenderTask: any = null;

  // Text layer cache: pageNumber (1-based) -> ExtractedTextItem[]
  const pageTextItemsCache = new Map<number, ExtractedTextItem[]>();
  let currentFindMatches: TextMatch[] = [];
  let activeMatchIndex = -1;

  // DOM Elements
  const dropZone = document.getElementById('edit-drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('edit-file-input') as HTMLInputElement;
  const workbench = document.getElementById('edit-workbench') as HTMLDivElement;
  const fileNameEl = document.getElementById('edit-file-name') as HTMLParagraphElement;
  const fileSizeEl = document.getElementById('edit-file-size') as HTMLSpanElement;
  const pageCounterEl = document.getElementById('edit-page-counter') as HTMLSpanElement;
  const totalPagesBadge = document.getElementById('total-pages-badge') as HTMLSpanElement;
  const thumbnailList = document.getElementById('thumbnail-list') as HTMLDivElement;

  const pdfCanvas = document.getElementById('pdf-page-canvas') as HTMLCanvasElement;
  const annotationLayer = document.getElementById('annotation-layer') as HTMLDivElement;
  const textClickLayer = document.getElementById('text-click-layer') as HTMLDivElement;
  const freehandCanvas = document.getElementById('freehand-canvas') as HTMLCanvasElement;

  const errorBanner = document.getElementById('edit-error-banner') as HTMLDivElement;
  const errorMessage = document.getElementById('edit-error-message') as HTMLParagraphElement;
  const dismissErrorBtn = document.getElementById('dismiss-edit-error') as HTMLButtonElement;

  const btnUndo = document.getElementById('btn-undo') as HTMLButtonElement;
  const btnRedo = document.getElementById('btn-redo') as HTMLButtonElement;
  const btnDeleteElement = document.getElementById('btn-delete-element') as HTMLButtonElement;
  const btnApplyChanges = document.getElementById('btn-apply-changes') as HTMLButtonElement;

  const zoomInBtn = document.getElementById('zoom-in-btn') as HTMLButtonElement;
  const zoomOutBtn = document.getElementById('zoom-out-btn') as HTMLButtonElement;
  const zoomLevelText = document.getElementById('zoom-level-text') as HTMLSpanElement;

  // Tool buttons
  const toolBtns = document.querySelectorAll('.tool-btn');
  const subOptsMap: Record<string, HTMLElement | null> = {
    text: document.getElementById('sub-opts-text'),
    editText: document.getElementById('sub-opts-editText'),
    images: document.getElementById('sub-opts-images'),
    annotate: document.getElementById('sub-opts-annotate'),
    shapes: document.getElementById('sub-opts-shapes'),
    whiteout: document.getElementById('sub-opts-whiteout'),
    forms: document.getElementById('sub-opts-forms'),
    links: document.getElementById('sub-opts-links'),
    sign: document.getElementById('sub-opts-sign'),
    find: document.getElementById('sub-opts-find'),
    pages: document.getElementById('sub-opts-pages'),
  };

  const persistentWhiteoutBanner = document.getElementById('persistent-whiteout-banner') as HTMLDivElement;

  // Signature modal elements
  const sigModal = document.getElementById('signature-modal') as HTMLDivElement;
  const openSigModalBtn = document.getElementById('open-sign-modal-btn') as HTMLButtonElement;
  const closeSigModalBtn = document.getElementById('close-sig-modal') as HTMLButtonElement;
  const cancelSigBtn = document.getElementById('cancel-sig-btn') as HTMLButtonElement;
  const saveSigBtn = document.getElementById('save-sig-btn') as HTMLButtonElement;
  const sigPadCanvas = document.getElementById('sig-pad-canvas') as HTMLCanvasElement;
  const clearSigPadBtn = document.getElementById('clear-sig-pad') as HTMLButtonElement;
  const sigTypeInput = document.getElementById('sig-type-input') as HTMLInputElement;
  const sigTypePreview = document.getElementById('sig-type-preview') as HTMLDivElement;
  const sigUploadInput = document.getElementById('sig-upload-input') as HTMLInputElement;
  const sigUploadPreview = document.getElementById('sig-upload-preview') as HTMLDivElement;
  const activeSignatureStatus = document.getElementById('active-signature-status') as HTMLSpanElement;

  // Additional Toolbar Controls
  const imageUploadInput = document.getElementById('image-upload-input') as HTMLInputElement;
  const textBoldBtn = document.getElementById('text-bold-btn') as HTMLButtonElement;
  const textItalicBtn = document.getElementById('text-italic-btn') as HTMLButtonElement;
  let isTextBold = false;
  let isTextItalic = false;

  const annotPenBtn = document.getElementById('annot-pen-btn') as HTMLButtonElement;
  const annotHighlightBtn = document.getElementById('annot-highlight-btn') as HTMLButtonElement;
  const annotStrikeBtn = document.getElementById('annot-strike-btn') as HTMLButtonElement;
  const annotPenColor = document.getElementById('annot-pen-color') as HTMLInputElement;
  const dragPreviewBox = document.getElementById('drag-preview-box') as HTMLDivElement;
  const addFormTextBtn = document.getElementById('add-form-text-btn') as HTMLButtonElement;
  const addFormCheckBtn = document.getElementById('add-form-check-btn') as HTMLButtonElement;
  const floatingAnnotBar = document.getElementById('floating-annot-bar') as HTMLDivElement;
  const prevPageTopBtn = document.getElementById('prev-page-top-btn') as HTMLButtonElement;
  const nextPageTopBtn = document.getElementById('next-page-top-btn') as HTMLButtonElement;
  const pageIndicatorTop = document.getElementById('page-indicator-top') as HTMLSpanElement;
  const zoomFitWidthBtn = document.getElementById('zoom-fit-width-btn') as HTMLButtonElement;
  const findPrevBtn = document.getElementById('find-prev-btn') as HTMLButtonElement;
  const findNextBtn = document.getElementById('find-next-btn') as HTMLButtonElement;
  const viewportContainer = document.getElementById('viewport-container') as HTMLDivElement;
  let activeAnnotMode: 'pen' | 'highlight' | 'strike' = 'highlight';

  // Compilation modal elements
  const compileModal = document.getElementById('compile-modal') as HTMLDivElement;
  const compileStatusText = document.getElementById('compile-status-text') as HTMLParagraphElement;
  const compileProgressBar = document.getElementById('compile-progress-bar') as HTMLDivElement;

  // Format bytes utility
  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  function showError(msg: string) {
    errorMessage.textContent = msg;
    errorBanner.classList.remove('hidden');
  }

  function clearError() {
    errorBanner.classList.add('hidden');
    errorMessage.textContent = '';
  }

  dismissErrorBtn?.addEventListener('click', clearError);

  // File Input handling
  fileInput?.addEventListener('change', async (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      await loadPdfDocument(target.files[0]);
    }
  });

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-slate-800');
  });

  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-slate-800');
  });

  dropZone?.addEventListener('drop', async (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-slate-800');
    if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
      await loadPdfDocument(e.dataTransfer.files[0]);
    }
  });

  async function loadPdfDocument(file: File) {
    if (file.size > MAX_FILE_SIZE_BYTES) {
      showError(`File exceeds the 100MB limit (${formatBytes(file.size)}). Please choose a file under 100MB.`);
      return;
    }

    clearError();
    if (pdfDocProxy) {
      try {
        await pdfDocProxy.destroy();
      } catch {}
    }
    originalFile = file;
    fileNameEl.textContent = file.name;
    fileSizeEl.textContent = formatBytes(file.size);

    try {
      const buffer = await file.arrayBuffer();
      originalBytes = new Uint8Array(buffer.slice(0));

      // Clone bytes for worker to prevent buffer detachment
      const workerBytes = new Uint8Array(buffer.slice(0));
      const loadingTask = pdfjsLib.getDocument({ data: workerBytes });
      pdfDocProxy = await loadingTask.promise;
      totalOriginalPages = pdfDocProxy.numPages;

      // Initialize page configs
      pageConfigs = [];
      for (let i = 0; i < totalOriginalPages; i++) {
        pageConfigs.push({ originalIndex: i, rotation: 0, isDeleted: false });
      }

      dropZone.classList.add('hidden');
      workbench.classList.remove('hidden');

      renderThumbnails();
      await renderActivePage();
    } catch (err: any) {
      showError('Failed to parse PDF: ' + (err?.message || 'Invalid or encrypted file.'));
    }
  }

  // --- PAGE RENDERING ---
  async function renderActivePage() {
    if (!pdfDocProxy) return;

    const activeConfig = pageConfigs[currentPageIndex];
    if (!activeConfig) return;

    const originalPageNum = activeConfig.originalIndex + 1;
    const page = await pdfDocProxy.getPage(originalPageNum);
    const dpr = window.devicePixelRatio || 1;
    const displayViewport = page.getViewport({ scale: currentZoom, rotation: activeConfig.rotation });
    const renderViewport = page.getViewport({ scale: currentZoom * dpr, rotation: activeConfig.rotation });

    pdfCanvas.width = Math.floor(renderViewport.width);
    pdfCanvas.height = Math.floor(renderViewport.height);
    pdfCanvas.style.width = `${displayViewport.width}px`;
    pdfCanvas.style.height = `${displayViewport.height}px`;

    const canvasContext = pdfCanvas.getContext('2d');
    if (canvasContext) {
      if (currentRenderTask) {
        try {
          currentRenderTask.cancel();
        } catch {}
      }
      currentRenderTask = page.render({ canvasContext, viewport: renderViewport });
      try {
        await currentRenderTask.promise;
      } catch (rErr: any) {
        if (rErr?.name === 'RenderingCancelledException') return;
      }
    }

    // Update dimensions on annotation layer & freehand canvas
    annotationLayer.style.width = `${displayViewport.width}px`;
    annotationLayer.style.height = `${displayViewport.height}px`;
    textClickLayer.style.width = `${displayViewport.width}px`;
    textClickLayer.style.height = `${displayViewport.height}px`;
    freehandCanvas.width = Math.floor(renderViewport.width);
    freehandCanvas.height = Math.floor(renderViewport.height);
    freehandCanvas.style.width = `${displayViewport.width}px`;
    freehandCanvas.style.height = `${displayViewport.height}px`;

    const totalActive = pageConfigs.filter(p => !p.isDeleted).length;
    pageCounterEl.textContent = `Page ${currentPageIndex + 1} of ${totalActive}`;
    if (pageIndicatorTop) pageIndicatorTop.textContent = `${currentPageIndex + 1} / ${totalActive}`;
    if (prevPageTopBtn) prevPageTopBtn.disabled = currentPageIndex === 0;
    if (nextPageTopBtn) nextPageTopBtn.disabled = currentPageIndex >= totalActive - 1;

    // Extract text items for text layer
    if (!pageTextItemsCache.has(originalPageNum)) {
      const items = await extractPageTextItems(pdfDocProxy, originalPageNum);
      pageTextItemsCache.set(originalPageNum, items);
    }

    renderAnnotationsOverlay();
    renderTextClickTargets();
  }

  // Render left thumbnail sidebar
  function renderThumbnails() {
    thumbnailList.innerHTML = '';
    const activePages = pageConfigs.filter(p => !p.isDeleted);
    totalPagesBadge.textContent = String(activePages.length);

    activePages.forEach(async (pConfig, visualIdx) => {
      const card = document.createElement('div');
      card.className = `p-2 rounded-xl border transition cursor-pointer flex flex-col items-center gap-1.5 ${
        visualIdx === currentPageIndex ? 'border-slate-900 bg-slate-100 shadow-sm' : 'border-slate-200 bg-white hover:border-slate-300'
      }`;

      // Miniature visual canvas preview
      const thumbCanvas = document.createElement('canvas');
      thumbCanvas.className = 'w-full h-24 object-contain bg-white rounded border border-slate-200 shadow-xs block';
      card.appendChild(thumbCanvas);

      const infoDiv = document.createElement('div');
      infoDiv.className = 'text-center text-xs font-bold text-slate-700';
      infoDiv.innerHTML = `Page ${visualIdx + 1}<span class="text-[10px] text-slate-400 font-normal block">Orig #${pConfig.originalIndex + 1}${pConfig.rotation ? ` • ${pConfig.rotation}°` : ''}</span>`;
      card.appendChild(infoDiv);

      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'flex items-center justify-between w-full text-xs px-1';
      actionsDiv.innerHTML = `
        <button type="button" class="btn-page-up p-1 text-slate-400 hover:text-slate-800" title="Move Up" ${visualIdx === 0 ? 'disabled' : ''}>▲</button>
        <button type="button" class="btn-page-rotate p-1 text-slate-400 hover:text-slate-800" title="Rotate 90°">↻</button>
        <button type="button" class="btn-page-down p-1 text-slate-400 hover:text-slate-800" title="Move Down" ${visualIdx === activePages.length - 1 ? 'disabled' : ''}>▼</button>
        <button type="button" class="btn-page-delete p-1 text-red-400 hover:text-red-700" title="Delete Page" ${activePages.length <= 1 ? 'disabled' : ''}>🗑️</button>
      `;
      card.appendChild(actionsDiv);

      // Asynchronously render the miniature preview
      if (pdfDocProxy) {
        try {
          const origPage = await pdfDocProxy.getPage(pConfig.originalIndex + 1);
          const tViewport = origPage.getViewport({ scale: 0.22, rotation: pConfig.rotation });
          thumbCanvas.width = Math.floor(tViewport.width);
          thumbCanvas.height = Math.floor(tViewport.height);
          const tCtx = thumbCanvas.getContext('2d');
          if (tCtx) {
            origPage.render({ canvasContext: tCtx, viewport: tViewport });
          }
        } catch {}
      }

      card.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.btn-page-up') || target.closest('.btn-page-down') || target.closest('.btn-page-rotate') || target.closest('.btn-page-delete')) {
          return;
        }
        currentPageIndex = visualIdx;
        renderThumbnails();
        await renderActivePage();
      });

      // Actions
      card.querySelector('.btn-page-up')?.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (visualIdx > 0) {
          const prevConfig = activePages[visualIdx - 1];
          const currRealIdx = pageConfigs.indexOf(pConfig);
          const prevRealIdx = pageConfigs.indexOf(prevConfig);
          if (currRealIdx !== -1 && prevRealIdx !== -1) {
            const temp = pageConfigs[currRealIdx];
            pageConfigs[currRealIdx] = pageConfigs[prevRealIdx];
            pageConfigs[prevRealIdx] = temp;
          }
          annotations.forEach(a => {
            if (a.pageIndex === visualIdx) a.pageIndex = visualIdx - 1;
            else if (a.pageIndex === visualIdx - 1) a.pageIndex = visualIdx;
          });
          currentPageIndex = visualIdx - 1;
          renderThumbnails();
          await renderActivePage();
        }
      });

      card.querySelector('.btn-page-down')?.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (visualIdx < activePages.length - 1) {
          const nextConfig = activePages[visualIdx + 1];
          const currRealIdx = pageConfigs.indexOf(pConfig);
          const nextRealIdx = pageConfigs.indexOf(nextConfig);
          if (currRealIdx !== -1 && nextRealIdx !== -1) {
            const temp = pageConfigs[currRealIdx];
            pageConfigs[currRealIdx] = pageConfigs[nextRealIdx];
            pageConfigs[nextRealIdx] = temp;
          }
          annotations.forEach(a => {
            if (a.pageIndex === visualIdx) a.pageIndex = visualIdx + 1;
            else if (a.pageIndex === visualIdx + 1) a.pageIndex = visualIdx;
          });
          currentPageIndex = visualIdx + 1;
          renderThumbnails();
          await renderActivePage();
        }
      });

      card.querySelector('.btn-page-rotate')?.addEventListener('click', async (e) => {
        e.stopPropagation();
        pConfig.rotation = (pConfig.rotation + 90) % 360;
        renderThumbnails();
        await renderActivePage();
      });

      card.querySelector('.btn-page-delete')?.addEventListener('click', async (e) => {
        e.stopPropagation();
        pConfig.isDeleted = true;
        annotations = annotations.filter(a => a.pageIndex !== visualIdx);
        annotations.forEach(a => {
          if (a.pageIndex > visualIdx) a.pageIndex -= 1;
        });
        const remaining = pageConfigs.filter(p => !p.isDeleted).length;
        if (currentPageIndex >= remaining) {
          currentPageIndex = Math.max(0, remaining - 1);
        }
        renderThumbnails();
        await renderActivePage();
      });

      thumbnailList.appendChild(card);
    });
  }

  // --- TOOLBAR SWITCHER ---
  toolBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      toolBtns.forEach(b => b.classList.remove('active-tool'));
      btn.classList.add('active-tool');
      activeTool = (btn as HTMLElement).dataset.tool || 'text';

      // Switch options sub-bar
      Object.keys(subOptsMap).forEach((k) => {
        if (subOptsMap[k]) {
          if (k === activeTool) {
            subOptsMap[k]!.classList.remove('hidden');
          } else {
            subOptsMap[k]!.classList.add('hidden');
          }
        }
      });

      // Show/hide persistent whiteout warning banner
      if (activeTool === 'whiteout' || activeTool === 'editText') {
        persistentWhiteoutBanner.classList.remove('hidden');
      } else {
        persistentWhiteoutBanner.classList.add('hidden');
      }

      renderTextClickTargets();
    });
  });

  // Zoom controls
  zoomInBtn?.addEventListener('click', async () => {
    if (currentZoom < 2.5) {
      currentZoom = Math.min(2.5, currentZoom + 0.25);
      zoomLevelText.textContent = `${Math.round(currentZoom * 100)}%`;
      await renderActivePage();
    }
  });

  zoomOutBtn?.addEventListener('click', async () => {
    if (currentZoom > 0.5) {
      currentZoom = Math.max(0.5, currentZoom - 0.25);
      zoomLevelText.textContent = `${Math.round(currentZoom * 100)}%`;
      await renderActivePage();
    }
  });

  // --- ANNOTATION CREATION & RENDERING ---
  function saveHistory() {
    undoStack.push(JSON.parse(JSON.stringify(annotations)));
    redoStack = [];
    updateUndoRedoButtons();
  }

  function updateUndoRedoButtons() {
    btnUndo.disabled = undoStack.length === 0;
    btnRedo.disabled = redoStack.length === 0;
  }

  btnUndo?.addEventListener('click', () => {
    if (undoStack.length > 0) {
      redoStack.push(JSON.parse(JSON.stringify(annotations)));
      annotations = undoStack.pop() || [];
      renderAnnotationsOverlay();
      updateUndoRedoButtons();
    }
  });

  btnRedo?.addEventListener('click', () => {
    if (redoStack.length > 0) {
      undoStack.push(JSON.parse(JSON.stringify(annotations)));
      annotations = redoStack.pop() || [];
      renderAnnotationsOverlay();
      updateUndoRedoButtons();
    }
  });

  btnDeleteElement?.addEventListener('click', () => {
    if (selectedAnnotationId) {
      saveHistory();
      annotations = annotations.filter(a => a.id !== selectedAnnotationId);
      selectedAnnotationId = null;
      renderAnnotationsOverlay();
    }
  });

  function cleanupEmptyTextAnnotations() {
    const initialLen = annotations.length;
    annotations = annotations.filter(a => !(a.type === 'text' && a.text.trim() === ''));
    if (annotations.length !== initialLen && selectedAnnotationId) {
      if (!annotations.some(a => a.id === selectedAnnotationId)) {
        selectedAnnotationId = null;
      }
    }
  }

  // Handle click on canvas surface to spawn annotations
  annotationLayer?.addEventListener('click', (e) => {
    if (e.target !== annotationLayer) return;

    const rect = annotationLayer.getBoundingClientRect();
    const clickX = (e.clientX - rect.left) / currentZoom;
    const clickY = (e.clientY - rect.top) / currentZoom;

    if (activeTool === 'text') {
      cleanupEmptyTextAnnotations();
      saveHistory();
      const fontSize = parseInt((document.getElementById('text-size-select') as HTMLSelectElement).value, 10) || 14;
      const color = (document.getElementById('text-color-select') as HTMLSelectElement).value || '#000000';

      const newId = `text-${Date.now()}`;
      annotations.push({
        type: 'text',
        id: newId,
        pageIndex: currentPageIndex,
        x: clickX,
        y: clickY,
        text: '',
        fontSize,
        color,
        bold: isTextBold,
        italic: isTextItalic,
      });
      selectedAnnotationId = newId;
      renderAnnotationsOverlay();

      setTimeout(() => {
        const textEl = annotationLayer.querySelector(`[data-annot-id="${newId}"] .editable-text`) as HTMLElement;
        if (textEl) textEl.focus();
      }, 50);
    } else if (activeTool === 'sign' && activeSignatureData) {
      saveHistory();
      if (activeSignatureData.points && activeSignatureData.points.length > 0) {
        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        activeSignatureData.points.forEach(stroke => {
          stroke.forEach(pt => {
            if (pt.x < minX) minX = pt.x;
            if (pt.x > maxX) maxX = pt.x;
            if (pt.y < minY) minY = pt.y;
            if (pt.y > maxY) maxY = pt.y;
          });
        });
        const sigW = Math.max(40, maxX - minX);
        const sigH = Math.max(20, maxY - minY);
        const newPoints = activeSignatureData.points.map(stroke =>
          stroke.map(pt => ({ x: clickX + (pt.x - minX), y: clickY + (pt.y - minY) }))
        );
        const newId = `sig-${Date.now()}`;
        annotations.push({
          type: 'signature',
          id: newId,
          pageIndex: currentPageIndex,
          x: clickX,
          y: clickY,
          width: sigW,
          height: sigH,
          points: newPoints,
          strokeColor: '#000000',
          strokeWidth: 2,
        });
        selectedAnnotationId = newId;
      } else if (activeSignatureData.text) {
        const newId = `sig-text-${Date.now()}`;
        annotations.push({
          type: 'text',
          id: newId,
          pageIndex: currentPageIndex,
          x: clickX,
          y: clickY,
          text: activeSignatureData.text,
          fontSize: 28,
          color: '#000000',
        });
        selectedAnnotationId = newId;
      } else if (activeSignatureData.imageBytes) {
        const newId = `sig-img-${Date.now()}`;
        annotations.push({
          type: 'image',
          id: newId,
          pageIndex: currentPageIndex,
          x: clickX,
          y: clickY,
          width: 140,
          height: 60,
          imageBytes: activeSignatureData.imageBytes,
          format: activeSignatureData.format || 'png',
        });
        selectedAnnotationId = newId;
      }
      renderAnnotationsOverlay();
    } else if (activeTool === 'images' && activeImageData) {
      saveHistory();
      const newId = `img-${Date.now()}`;
      annotations.push({
        type: 'image',
        id: newId,
        pageIndex: currentPageIndex,
        x: clickX,
        y: clickY,
        width: activeImageData.width || 120,
        height: activeImageData.height || 80,
        imageBytes: activeImageData.imageBytes,
        format: activeImageData.format,
      });
      selectedAnnotationId = newId;
      renderAnnotationsOverlay();
    } else if (activeTool === 'forms') {
      saveHistory();
      const newId = `form-${Date.now()}`;
      annotations.push({
        type: 'formField',
        id: newId,
        pageIndex: currentPageIndex,
        fieldType: activeFormType,
        name: `field_${Date.now()}`,
        x: clickX,
        y: clickY,
        width: activeFormType === 'checkbox' ? 20 : 120,
        height: activeFormType === 'checkbox' ? 20 : 25,
        defaultValue: activeFormType === 'checkbox' ? false : '',
      });
      selectedAnnotationId = newId;
      renderAnnotationsOverlay();
    } else {
      if (selectedAnnotationId) {
        selectedAnnotationId = null;
        renderAnnotationsOverlay();
      }
    }
  });

  // Drag-to-draw for Whiteout, Shapes, Annotate, Links, plus Freehand Pen
  let isDragging = false;
  let isDrawingPen = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let penPoints: { x: number; y: number }[] = [];

  annotationLayer?.addEventListener('mousedown', (e) => {
    if (e.target !== annotationLayer) return;

    if (activeTool === 'annotate' && activeAnnotMode === 'pen') {
      isDrawingPen = true;
      const rect = annotationLayer.getBoundingClientRect();
      const pt = {
        x: (e.clientX - rect.left) / currentZoom,
        y: (e.clientY - rect.top) / currentZoom,
      };
      penPoints = [pt];
      return;
    }

    if (['whiteout', 'shapes', 'annotate', 'links'].includes(activeTool)) {
      isDragging = true;
      const rect = annotationLayer.getBoundingClientRect();
      dragStartX = (e.clientX - rect.left) / currentZoom;
      dragStartY = (e.clientY - rect.top) / currentZoom;
      if (dragPreviewBox) {
        dragPreviewBox.classList.remove('hidden');
        dragPreviewBox.style.left = `${dragStartX * currentZoom}px`;
        dragPreviewBox.style.top = `${dragStartY * currentZoom}px`;
        dragPreviewBox.style.width = '0px';
        dragPreviewBox.style.height = '0px';
      }
    }
  });

  window.addEventListener('mousemove', (e) => {
    const rect = annotationLayer.getBoundingClientRect();

    if (isDrawingPen && freehandCanvas) {
      const pt = {
        x: (e.clientX - rect.left) / currentZoom,
        y: (e.clientY - rect.top) / currentZoom,
      };
      const fCtx = freehandCanvas.getContext('2d');
      if (fCtx && penPoints.length > 0) {
        const dpr = window.devicePixelRatio || 1;
        const lastPt = penPoints[penPoints.length - 1];
        fCtx.beginPath();
        fCtx.strokeStyle = annotPenColor?.value || '#dc2626';
        fCtx.lineWidth = 2 * currentZoom * dpr;
        fCtx.lineCap = 'round';
        fCtx.lineJoin = 'round';
        fCtx.moveTo(lastPt.x * currentZoom * dpr, lastPt.y * currentZoom * dpr);
        fCtx.lineTo(pt.x * currentZoom * dpr, pt.y * currentZoom * dpr);
        fCtx.stroke();
      }
      penPoints.push(pt);
      return;
    }

    if (isDragging && dragPreviewBox) {
      const currX = (e.clientX - rect.left) / currentZoom;
      const currY = (e.clientY - rect.top) / currentZoom;

      const x = Math.min(dragStartX, currX);
      const y = Math.min(dragStartY, currY);
      const width = Math.abs(currX - dragStartX);
      const height = Math.abs(currY - dragStartY);

      dragPreviewBox.style.left = `${x * currentZoom}px`;
      dragPreviewBox.style.top = `${y * currentZoom}px`;
      dragPreviewBox.style.width = `${width * currentZoom}px`;
      dragPreviewBox.style.height = `${height * currentZoom}px`;
    }
  });

  window.addEventListener('mouseup', (e) => {
    if (dragPreviewBox) {
      dragPreviewBox.classList.add('hidden');
    }

    if (isDrawingPen) {
      isDrawingPen = false;
      const fCtx = freehandCanvas.getContext('2d');
      if (fCtx) {
        fCtx.clearRect(0, 0, freehandCanvas.width, freehandCanvas.height);
      }

      if (penPoints.length >= 2) {
        saveHistory();
        const minX = Math.min(...penPoints.map(p => p.x));
        const maxX = Math.max(...penPoints.map(p => p.x));
        const minY = Math.min(...penPoints.map(p => p.y));
        const maxY = Math.max(...penPoints.map(p => p.y));
        const newId = `pen-${Date.now()}`;
        annotations.push({
          type: 'signature',
          id: newId,
          pageIndex: currentPageIndex,
          x: minX,
          y: minY,
          width: Math.max(15, maxX - minX),
          height: Math.max(10, maxY - minY),
          points: [penPoints],
          strokeColor: annotPenColor?.value || '#dc2626',
          strokeWidth: 2,
        });
        selectedAnnotationId = newId;
        renderAnnotationsOverlay();
      }
      penPoints = [];
      return;
    }

    if (isDragging) {
      isDragging = false;
      const rect = annotationLayer.getBoundingClientRect();
      const endX = (e.clientX - rect.left) / currentZoom;
      const endY = (e.clientY - rect.top) / currentZoom;

      const x = Math.min(dragStartX, endX);
      const y = Math.min(dragStartY, endY);
      const width = Math.abs(endX - dragStartX);
      const height = Math.abs(endY - dragStartY);

      if (width > 5 && height > 5) {
        saveHistory();
        if (activeTool === 'whiteout') {
          annotations.push({
            type: 'whiteout',
            id: `whiteout-${Date.now()}`,
            pageIndex: currentPageIndex,
            x,
            y,
            width,
            height,
          });
        } else if (activeTool === 'shapes') {
          const shapeType = (document.getElementById('shape-type-select') as HTMLSelectElement).value as 'rect' | 'circle' | 'line' | 'arrow';
          const strokeColor = (document.getElementById('shape-stroke-color') as HTMLInputElement).value || '#2563eb';
          const strokeWidth = parseInt((document.getElementById('shape-width-select') as HTMLSelectElement).value, 10) || 2;
          annotations.push({
            type: 'shape',
            id: `shape-${Date.now()}`,
            pageIndex: currentPageIndex,
            shapeType,
            x,
            y,
            width,
            height,
            strokeColor,
            strokeWidth,
          });
        } else if (activeTool === 'annotate') {
          if (activeAnnotMode === 'strike') {
            annotations.push({
              type: 'shape',
              id: `strike-${Date.now()}`,
              pageIndex: currentPageIndex,
              shapeType: 'rect',
              x,
              y: y + height / 2 - 1,
              width,
              height: 2,
              strokeColor: '#dc2626',
              strokeWidth: 1,
              fillColor: '#dc2626',
            });
          } else {
            annotations.push({
              type: 'highlight',
              id: `highlight-${Date.now()}`,
              pageIndex: currentPageIndex,
              x,
              y,
              width,
              height,
              color: '#facc15',
            });
          }
        } else if (activeTool === 'links') {
          const url = (document.getElementById('link-url-input') as HTMLInputElement).value || 'https://airpdf.pages.dev';
          annotations.push({
            type: 'link',
            id: `link-${Date.now()}`,
            pageIndex: currentPageIndex,
            x,
            y,
            width,
            height,
            url,
          });
        }
        renderAnnotationsOverlay();
      }
    }
  });

  // Render annotations onto DOM overlay
  function renderAnnotationsOverlay() {
    annotationLayer.innerHTML = '';
    const pageAnnotations = annotations.filter(a => a.pageIndex === currentPageIndex);

    pageAnnotations.forEach((annot) => {
      const el = document.createElement('div');
      el.className = 'absolute cursor-move group hover-annot';
      el.dataset.annotId = annot.id;
      el.style.left = `${annot.x * currentZoom}px`;
      el.style.top = `${annot.y * currentZoom}px`;

      if (annot.id === selectedAnnotationId) {
        el.classList.add('selected-annot');
        if (annot.type === 'text') {
          if (textBoldBtn) {
            textBoldBtn.className = `w-6 h-6 rounded border font-bold flex items-center justify-center text-xs ${
              annot.bold ? 'bg-slate-900 text-white border-slate-900' : 'bg-white text-slate-700 border-slate-300 hover:bg-slate-100'
            }`;
          }
          if (textItalicBtn) {
            textItalicBtn.className = `w-6 h-6 rounded border italic font-serif flex items-center justify-center text-xs ${
              annot.italic ? 'bg-slate-900 text-white border-slate-900' : 'bg-white text-slate-700 border-slate-300 hover:bg-slate-100'
            }`;
          }
        }
      }

      el.addEventListener('click', (e) => {
        e.stopPropagation();
        if (selectedAnnotationId !== annot.id) {
          selectedAnnotationId = annot.id;
          renderAnnotationsOverlay();
        }
      });

      switch (annot.type) {
        case 'text': {
          el.style.minWidth = '50px';
          el.style.backgroundColor = 'rgba(255, 255, 255, 0.7)';
          el.style.border = '1px solid rgba(59, 130, 246, 0.4)';
          el.style.borderRadius = '3px';

          // Move handle on top
          const moveBar = document.createElement('div');
          moveBar.className = 'move-handle w-full h-3 bg-blue-500/20 hover:bg-blue-500/40 cursor-move rounded-t flex items-center justify-center';
          moveBar.innerHTML = '<span class="w-4 h-0.5 bg-blue-500/60 rounded block"></span>';

          const textSpan = document.createElement('div');
          textSpan.className = 'editable-text outline-none px-1.5 py-0.5 cursor-text whitespace-pre-wrap min-w-[30px]';
          if (annot.id.startsWith('sig-text')) {
            textSpan.className += ' font-signature text-2xl';
          }
          if (annot.bold) textSpan.classList.add('font-bold');
          if (annot.italic) textSpan.classList.add('italic');
          textSpan.contentEditable = 'true';
          textSpan.style.fontSize = `${annot.fontSize * currentZoom}px`;
          textSpan.style.color = annot.color || '#000000';
          textSpan.innerText = annot.text;

          textSpan.addEventListener('input', () => {
            annot.text = textSpan.innerText || textSpan.textContent || '';
          });

          textSpan.addEventListener('blur', () => {
            if (annot.text.trim() === '') {
              cleanupEmptyTextAnnotations();
              renderAnnotationsOverlay();
            }
          });

          textSpan.addEventListener('focus', () => {
            if (selectedAnnotationId !== annot.id) {
              selectedAnnotationId = annot.id;
              updateFloatingToolbar();
            }
          });

          el.appendChild(moveBar);
          el.appendChild(textSpan);
          break;
        }

        case 'whiteout': {
          el.style.width = `${annot.width * currentZoom}px`;
          el.style.height = `${annot.height * currentZoom}px`;
          el.style.backgroundColor = '#ffffff';
          el.style.border = '1px dashed #cbd5e1';
          break;
        }

        case 'shape': {
          el.style.width = `${annot.width * currentZoom}px`;
          el.style.height = `${annot.height * currentZoom}px`;
          if (annot.shapeType === 'rect') {
            el.style.border = `${annot.strokeWidth}px solid ${annot.strokeColor}`;
            if (annot.fillColor) el.style.backgroundColor = annot.fillColor;
          } else if (annot.shapeType === 'circle') {
            el.style.border = `${annot.strokeWidth}px solid ${annot.strokeColor}`;
            el.style.borderRadius = '50%';
            if (annot.fillColor) el.style.backgroundColor = annot.fillColor;
          } else if (annot.shapeType === 'line' || annot.shapeType === 'arrow') {
            const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.style.width = '100%';
            svg.style.height = '100%';
            svg.style.overflow = 'visible';

            const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('x1', '0');
            line.setAttribute('y1', '0');
            line.setAttribute('x2', String(annot.width * currentZoom));
            line.setAttribute('y2', String(annot.height * currentZoom));
            line.setAttribute('stroke', annot.strokeColor);
            line.setAttribute('stroke-width', String((annot.strokeWidth || 2) * currentZoom));
            svg.appendChild(line);

            if (annot.shapeType === 'arrow') {
              const w = annot.width * currentZoom;
              const h = annot.height * currentZoom;
              const angle = Math.atan2(h, w);
              const hl = Math.max(10, (annot.strokeWidth || 2) * 4);
              const p1x = w - hl * Math.cos(angle - Math.PI / 6);
              const p1y = h - hl * Math.sin(angle - Math.PI / 6);
              const p2x = w - hl * Math.cos(angle + Math.PI / 6);
              const p2y = h - hl * Math.sin(angle + Math.PI / 6);

              const head = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
              head.setAttribute('points', `${w},${h} ${p1x},${p1y} ${p2x},${p2y}`);
              head.setAttribute('fill', annot.strokeColor);
              svg.appendChild(head);
            }
            el.appendChild(svg);
          }
          break;
        }

        case 'highlight': {
          el.style.width = `${annot.width * currentZoom}px`;
          el.style.height = `${annot.height * currentZoom}px`;
          el.style.backgroundColor = annot.color || '#facc15';
          el.style.opacity = '0.35';
          break;
        }

        case 'link': {
          el.style.width = `${annot.width * currentZoom}px`;
          el.style.height = `${annot.height * currentZoom}px`;
          el.style.backgroundColor = 'rgba(59, 130, 246, 0.15)';
          el.style.border = '1px solid #3b82f6';
          el.title = `Link to: ${annot.url}`;
          break;
        }

        case 'signature': {
          el.style.width = `${(annot.width || 120) * currentZoom}px`;
          el.style.height = `${(annot.height || 60) * currentZoom}px`;
          const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          svg.style.width = '100%';
          svg.style.height = '100%';
          svg.style.overflow = 'visible';

          const originX = annot.x || 0;
          const originY = annot.y || 0;

          annot.points.forEach((stroke) => {
            if (stroke.length < 2) return;
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            let d = `M ${(stroke[0].x - originX) * currentZoom} ${(stroke[0].y - originY) * currentZoom}`;
            for (let i = 1; i < stroke.length; i++) {
              d += ` L ${(stroke[i].x - originX) * currentZoom} ${(stroke[i].y - originY) * currentZoom}`;
            }
            path.setAttribute('d', d);
            path.setAttribute('stroke', annot.strokeColor || '#000000');
            path.setAttribute('stroke-width', String((annot.strokeWidth || 2) * currentZoom));
            path.setAttribute('fill', 'none');
            svg.appendChild(path);
          });
          el.appendChild(svg);
          break;
        }

        case 'image': {
          el.style.width = `${annot.width * currentZoom}px`;
          el.style.height = `${annot.height * currentZoom}px`;
          const img = document.createElement('img');
          const blob = new Blob([annot.imageBytes], { type: annot.format === 'jpeg' ? 'image/jpeg' : 'image/png' });
          img.src = URL.createObjectURL(blob);
          img.style.width = '100%';
          img.style.height = '100%';
          img.style.objectFit = 'contain';
          img.style.pointerEvents = 'none';
          el.appendChild(img);
          break;
        }

        case 'formField': {
          el.style.width = `${annot.width * currentZoom}px`;
          el.style.height = `${annot.height * currentZoom}px`;
          if (annot.fieldType === 'text') {
            const input = document.createElement('input');
            input.type = 'text';
            input.placeholder = annot.name;
            input.className = 'w-full h-full border border-blue-400 bg-blue-50/40 px-1 text-xs rounded';
            input.value = String(annot.defaultValue || '');
            input.addEventListener('input', () => {
              annot.defaultValue = input.value;
            });
            el.appendChild(input);
          } else {
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.className = 'w-4 h-4 text-blue-600 rounded';
            cb.checked = Boolean(annot.defaultValue);
            cb.addEventListener('change', () => {
              annot.defaultValue = cb.checked;
            });
            el.appendChild(cb);
          }
          break;
        }
      }

      // Drag to move annotation
      let isMoving = false;
      let moveStartX = 0;
      let moveStartY = 0;

      el.addEventListener('mousedown', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('resize-handle') || target.classList.contains('editable-text')) {
          return;
        }
        isMoving = true;
        moveStartX = e.clientX;
        moveStartY = e.clientY;

        const onMouseMove = (moveEvt: MouseEvent) => {
          if (!isMoving) return;
          const dx = (moveEvt.clientX - moveStartX) / currentZoom;
          const dy = (moveEvt.clientY - moveStartY) / currentZoom;
          annot.x += dx;
          annot.y += dy;
          moveStartX = moveEvt.clientX;
          moveStartY = moveEvt.clientY;
          el.style.left = `${annot.x * currentZoom}px`;
          el.style.top = `${annot.y * currentZoom}px`;
          updateFloatingToolbar();
        };

        const onMouseUp = () => {
          if (isMoving) {
            isMoving = false;
            saveHistory();
          }
          window.removeEventListener('mousemove', onMouseMove);
          window.removeEventListener('mouseup', onMouseUp);
        };

        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
      });

      // 8-Point Resize Handles when selected (for shapes, whiteout, images, signatures, links, form fields)
      if (annot.id === selectedAnnotationId && annot.type !== 'text') {
        const handles = ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'];
        handles.forEach((pos) => {
          const hEl = document.createElement('div');
          hEl.className = `resize-handle handle-${pos}`;
          hEl.addEventListener('mousedown', (hEvt) => {
            hEvt.stopPropagation();
            hEvt.preventDefault();
            let startClientX = hEvt.clientX;
            let startClientY = hEvt.clientY;
            const origX = annot.x;
            const origY = annot.y;
            const origW = (annot as any).width || 80;
            const origH = (annot as any).height || 40;

            const onHandleMove = (mEvt: MouseEvent) => {
              const dx = (mEvt.clientX - startClientX) / currentZoom;
              const dy = (mEvt.clientY - startClientY) / currentZoom;

              if (pos === 'se') {
                (annot as any).width = Math.max(15, origW + dx);
                (annot as any).height = Math.max(10, origH + dy);
              } else if (pos === 'sw') {
                const newW = Math.max(15, origW - dx);
                annot.x = origX + (origW - newW);
                (annot as any).width = newW;
                (annot as any).height = Math.max(10, origH + dy);
              } else if (pos === 'ne') {
                const newH = Math.max(10, origH - dy);
                annot.y = origY + (origH - newH);
                (annot as any).width = Math.max(15, origW + dx);
                (annot as any).height = newH;
              } else if (pos === 'nw') {
                const newW = Math.max(15, origW - dx);
                const newH = Math.max(10, origH - dy);
                annot.x = origX + (origW - newW);
                annot.y = origY + (origH - newH);
                (annot as any).width = newW;
                (annot as any).height = newH;
              } else if (pos === 'e') {
                (annot as any).width = Math.max(15, origW + dx);
              } else if (pos === 'w') {
                const newW = Math.max(15, origW - dx);
                annot.x = origX + (origW - newW);
                (annot as any).width = newW;
              } else if (pos === 's') {
                (annot as any).height = Math.max(10, origH + dy);
              } else if (pos === 'n') {
                const newH = Math.max(10, origH - dy);
                annot.y = origY + (origH - newH);
                (annot as any).height = newH;
              }

              el.style.left = `${annot.x * currentZoom}px`;
              el.style.top = `${annot.y * currentZoom}px`;
              el.style.width = `${((annot as any).width || 10) * currentZoom}px`;
              el.style.height = `${((annot as any).height || 10) * currentZoom}px`;
              updateFloatingToolbar();
            };

            const onHandleUp = () => {
              saveHistory();
              window.removeEventListener('mousemove', onHandleMove);
              window.removeEventListener('mouseup', onHandleUp);
              renderAnnotationsOverlay();
            };

            window.addEventListener('mousemove', onHandleMove);
            window.addEventListener('mouseup', onHandleUp);
          });
          el.appendChild(hEl);
        });
      }

      annotationLayer.appendChild(el);
    });

    updateFloatingToolbar();
  }

  // --- FLOATING CONTEXTUAL TOOLBAR ---
  function updateFloatingToolbar() {
    if (!floatingAnnotBar) return;
    if (!selectedAnnotationId) {
      floatingAnnotBar.classList.add('hidden');
      return;
    }

    const annot = annotations.find(a => a.id === selectedAnnotationId);
    if (!annot || annot.pageIndex !== currentPageIndex) {
      floatingAnnotBar.classList.add('hidden');
      return;
    }

    floatingAnnotBar.innerHTML = '';
    floatingAnnotBar.classList.remove('hidden');

    const annotX = annot.x * currentZoom;
    const annotY = annot.y * currentZoom;
    const annotW = ((annot as any).width || 80) * currentZoom;
    floatingAnnotBar.style.left = `${annotX + annotW / 2}px`;
    floatingAnnotBar.style.top = `${Math.max(8, annotY - 42)}px`;

    if (annot.type === 'text') {
