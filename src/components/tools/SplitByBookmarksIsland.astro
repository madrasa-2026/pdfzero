---
// SplitByBookmarksIsland.astro - 100% In-Browser PDF Split by Bookmarks / Chapters
---

<div id="splitbookmarks-island-app" class="w-full max-w-4xl mx-auto my-8 font-sans">
  <!-- Error Alert Container -->
  <div
    id="splitbookmarks-error-banner"
    class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">Chapter Splitting Notice</h4>
      <p id="splitbookmarks-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-splitbookmarks-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active before file selection) -->
  <div
    id="splitbookmarks-drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition cursor-pointer group"
  >
    <input
      type="file"
      id="splitbookmarks-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-sky-50 group-hover:bg-sky-600 flex items-center justify-center text-sky-600 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-sky-600 transition">
      Select PDF to Split by Bookmarks & Chapters
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop your multi-chapter PDF, ebook, or manual here.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose PDF Document
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-xs text-slate-400">
      <span>100% In-Browser</span>
      <span>•</span>
      <span>Automatic Chapter Detection</span>
      <span>•</span>
      <span>Instant ZIP Bundle</span>
    </div>
  </div>

  <!-- 2. Configure Chapters Card -->
  <div id="splitbookmarks-config-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6 text-left">
    <!-- File Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center font-bold text-sm">
          PDF
        </div>
        <div>
          <h4 id="sb-file-name" class="font-bold text-slate-900 text-sm truncate max-w-xs sm:max-w-md">document.pdf</h4>
          <p id="sb-file-meta" class="text-xs text-slate-500">Scanning outline bookmarks...</p>
        </div>
      </div>
      <button type="button" id="change-sb-file-btn" class="text-xs font-medium text-slate-500 hover:text-slate-800 hover:underline">
        Change File
      </button>
    </div>

    <!-- No Bookmarks Warning State -->
    <div id="no-bookmarks-alert" class="hidden p-5 rounded-xl border border-amber-200 bg-amber-50 text-amber-900 space-y-3">
      <div class="flex items-start gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <div>
          <h5 class="text-sm font-bold text-amber-950">No Embedded Bookmarks Detected</h5>
          <p class="text-xs text-amber-800 leading-relaxed mt-1">
            This PDF does not contain an embedded Table of Contents (outline bookmarks). To split by chapters, you can first add bookmarks using our free Bookmarks Editor, or use the standard Page Split tool.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a href="/tools/bookmarks-pdf" class="inline-flex items-center px-4 py-2 text-xs font-bold text-white bg-amber-800 hover:bg-amber-900 rounded-xl transition">
          Add Bookmarks with TOC Editor →
        </a>
        <a href="/tools/split-pdf" class="inline-flex items-center px-4 py-2 text-xs font-bold text-amber-900 bg-white border border-amber-300 hover:bg-amber-100/50 rounded-xl transition">
          Use Standard Page Range Splitter
        </a>
      </div>
    </div>

    <!-- Active Chapters Section -->
    <div id="active-chapters-container" class="space-y-4">
      <!-- Options Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-slate-700">
            <input type="checkbox" id="sb-include-frontmatter" checked class="w-4 h-4 text-sky-600 rounded border-slate-300 focus:ring-sky-500" />
            <span>Include Front Matter</span>
          </label>
        </div>

        <div class="flex items-center gap-2">
          <button type="button" id="sb-select-all-btn" class="text-xs text-sky-600 hover:text-sky-800 font-semibold px-2 py-1 rounded">Select All</button>
          <span class="text-slate-300">•</span>
          <button type="button" id="sb-deselect-all-btn" class="text-xs text-slate-500 hover:text-slate-700 font-semibold px-2 py-1 rounded">Deselect All</button>
        </div>
      </div>

      <!-- Chapter List -->
      <div class="border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100 max-h-80 overflow-y-auto" id="chapters-list-box">
        <!-- Injected dynamically -->
      </div>

      <!-- Action Button -->
      <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
        <button
          type="button"
          id="execute-splitbookmarks-btn"
          class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-button transition duration-150"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span id="execute-sb-label">Extract Chapters to ZIP Archive</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. Processing State -->
  <div id="splitbookmarks-progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 shadow-sm text-center space-y-5">
    <div class="w-16 h-16 mx-auto relative flex items-center justify-center">
      <div class="w-16 h-16 rounded-full border-4 border-sky-100 border-t-sky-600 animate-spin"></div>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-sky-600 absolute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
    </div>

    <div>
      <h3 class="text-base font-bold text-slate-900 mb-1">Splitting Chapters & Building ZIP...</h3>
      <p id="sb-progress-text" class="text-xs text-slate-500">
        Extracting vector pages losslessly and compressing archive...
      </p>
    </div>
  </div>

  <!-- 4. Success & Download State -->
  <div id="splitbookmarks-success-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm text-center space-y-6">
    <div class="w-14 h-14 mx-auto rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <div>
      <h3 class="text-lg font-bold text-slate-900 mb-1">Chapters Extracted Successfully!</h3>
      <p class="text-xs text-slate-500 max-w-md mx-auto">
        Your document has been cleanly split into separate chapter PDFs and bundled into a ZIP file.
      </p>
    </div>

    <!-- Primary Download: Complete ZIP -->
    <div class="p-5 rounded-2xl bg-sky-50/60 border border-sky-200/80 max-w-md mx-auto space-y-3">
      <div class="flex items-center justify-between text-xs">
        <span class="font-bold text-slate-800">Complete Chapters Package:</span>
        <span id="zip-size-label" class="font-mono text-sky-700 font-semibold">Calculating...</span>
      </div>

      <button
        type="button"
        id="download-zip-btn"
        class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-sky-600 hover:bg-sky-500 rounded-xl shadow-button transition duration-150"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download All Chapters (.ZIP)</span>
      </button>
    </div>

    <!-- Secondary: Individual Chapter Downloads List -->
    <div class="max-w-xl mx-auto text-left space-y-2">
      <h5 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Or Download Individual Chapter Files:</h5>
      <div id="individual-chapters-list" class="max-h-56 overflow-y-auto border border-slate-200 rounded-xl divide-y divide-slate-100 bg-white">
        <!-- Injected dynamically -->
      </div>
    </div>

    <div class="pt-2">
      <button
        type="button"
        id="sb-split-another-btn"
        class="px-5 py-3 text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition"
      >
        Split Another Document
      </button>
    </div>
  </div>
</div>

<script>
  import { extractBookmarks, type BookmarkItem } from '../../lib/pdf/bookmarks';
  import {
    calculateChapterRanges,
    splitPdfByBookmarks,
    type ChapterSplitItem,
    type ChapterFile,
  } from '../../lib/pdf/splitBookmarks';
  import { PDFDocument } from 'pdf-lib';

  let currentFile: File | null = null;
  let fileBuffer: ArrayBuffer | null = null;
  let detectedBookmarks: BookmarkItem[] = [];
  let totalDocPages = 1;
  let computedChapters: ChapterSplitItem[] = [];
  let generatedZipBytes: Uint8Array | null = null;
  let extractedChapterFiles: ChapterFile[] = [];

  const dropZone = document.getElementById('splitbookmarks-drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('splitbookmarks-file-input') as HTMLInputElement;
  const configSection = document.getElementById('splitbookmarks-config-section') as HTMLDivElement;
  const progressSection = document.getElementById('splitbookmarks-progress-section') as HTMLDivElement;
  const successSection = document.getElementById('splitbookmarks-success-section') as HTMLDivElement;

  const errorBanner = document.getElementById('splitbookmarks-error-banner') as HTMLDivElement;
  const errorMessage = document.getElementById('splitbookmarks-error-message') as HTMLElement;
  const dismissErrorBtn = document.getElementById('dismiss-splitbookmarks-error') as HTMLButtonElement;

  const fileNameLabel = document.getElementById('sb-file-name') as HTMLElement;
  const fileMetaLabel = document.getElementById('sb-file-meta') as HTMLElement;
  const changeFileBtn = document.getElementById('change-sb-file-btn') as HTMLButtonElement;
  const executeBtn = document.getElementById('execute-splitbookmarks-btn') as HTMLButtonElement;

  const noBookmarksAlert = document.getElementById('no-bookmarks-alert') as HTMLDivElement;
  const activeChaptersContainer = document.getElementById('active-chapters-container') as HTMLDivElement;
  const chaptersListBox = document.getElementById('chapters-list-box') as HTMLDivElement;
  const frontmatterCheckbox = document.getElementById('sb-include-frontmatter') as HTMLInputElement;
  const selectAllBtn = document.getElementById('sb-select-all-btn') as HTMLButtonElement;
  const deselectAllBtn = document.getElementById('sb-deselect-all-btn') as HTMLButtonElement;

  const zipSizeLabel = document.getElementById('zip-size-label') as HTMLElement;
  const downloadZipBtn = document.getElementById('download-zip-btn') as HTMLButtonElement;
  const individualChaptersList = document.getElementById('individual-chapters-list') as HTMLDivElement;
  const splitAnotherBtn = document.getElementById('sb-split-another-btn') as HTMLButtonElement;

  function showError(msg: string) {
    if (errorMessage && errorBanner) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function hideError() {
    if (errorBanner) {
      errorBanner.classList.add('hidden');
    }
  }

  dismissErrorBtn?.addEventListener('click', hideError);

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  // Render Chapter List
  function renderChapterList() {
    chaptersListBox.innerHTML = '';
    computedChapters = calculateChapterRanges(detectedBookmarks, totalDocPages, {
      includeFrontMatter: frontmatterCheckbox.checked,
      level: 'top-level',
    });

    if (computedChapters.length === 0) {
      chaptersListBox.innerHTML = `
        <div class="p-6 text-center text-xs text-slate-500">
          No valid chapter ranges could be mapped from the bookmarks.
        </div>
      `;
      return;
    }

    computedChapters.forEach((ch) => {
      const row = document.createElement('label');
      row.className = 'flex items-center justify-between p-3.5 hover:bg-slate-50 cursor-pointer transition';
      row.innerHTML = `
        <div class="flex items-center gap-3">
          <input type="checkbox" checked class="chapter-check w-4 h-4 text-sky-600 rounded border-slate-300 focus:ring-sky-500" data-index="${ch.index}" />
          <div>
            <span class="block text-xs font-bold text-slate-800">${ch.title}</span>
            <span class="block text-[11px] font-mono text-slate-400">${ch.filename}</span>
          </div>
        </div>
        <div class="text-right">
          <span class="block text-xs font-semibold text-slate-700">Pages ${ch.startPage}–${ch.endPage}</span>
          <span class="block text-[11px] text-slate-400">${ch.pageCount} page${ch.pageCount > 1 ? 's' : ''}</span>
        </div>
      `;
      chaptersListBox.appendChild(row);
    });
  }

  frontmatterCheckbox?.addEventListener('change', renderChapterList);

  selectAllBtn?.addEventListener('click', () => {
    document.querySelectorAll('.chapter-check').forEach((cb) => {
      (cb as HTMLInputElement).checked = true;
    });
  });

  deselectAllBtn?.addEventListener('click', () => {
    document.querySelectorAll('.chapter-check').forEach((cb) => {
      (cb as HTMLInputElement).checked = false;
    });
  });

  // Load File
  async function loadFile(file: File) {
    hideError();
    if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
      showError('Please upload a valid PDF document.');
      return;
    }

    try {
      currentFile = file;
      fileBuffer = await file.arrayBuffer();

      const doc = await PDFDocument.load(fileBuffer, { ignoreEncryption: true });
      totalDocPages = doc.getPageCount();

      const extraction = await extractBookmarks(new Uint8Array(fileBuffer));
      detectedBookmarks = extraction.bookmarks;

      fileNameLabel.textContent = file.name;
      fileMetaLabel.textContent = `${formatBytes(file.size)} • ${totalDocPages} total pages`;

      if (!extraction.hasBookmarks || detectedBookmarks.length === 0) {
        noBookmarksAlert.classList.remove('hidden');
        activeChaptersContainer.classList.add('hidden');
      } else {
        noBookmarksAlert.classList.add('hidden');
        activeChaptersContainer.classList.remove('hidden');
        renderChapterList();
      }

      dropZone.classList.add('hidden');
      configSection.classList.remove('hidden');
      progressSection.classList.add('hidden');
      successSection.classList.add('hidden');
    } catch (err: any) {
      showError('Failed to read PDF outline: ' + (err?.message || 'Invalid or corrupted file'));
    }
  }

  fileInput?.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files && files.length > 0) {
      loadFile(files[0]);
    }
  });

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-sky-500', 'bg-sky-50/30');
  });

  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-sky-500', 'bg-sky-50/30');
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-sky-500', 'bg-sky-50/30');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      loadFile(e.dataTransfer.files[0]);
    }
  });

  changeFileBtn?.addEventListener('click', () => {
    configSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
    fileInput.value = '';
    currentFile = null;
    fileBuffer = null;
  });

  splitAnotherBtn?.addEventListener('click', () => {
    successSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
    fileInput.value = '';
    currentFile = null;
    fileBuffer = null;
  });

  // Execute Split
  executeBtn?.addEventListener('click', async () => {
    if (!fileBuffer || !currentFile) {
      showError('No PDF loaded.');
      return;
    }

    const selectedIndices: number[] = [];
    document.querySelectorAll('.chapter-check').forEach((cb) => {
      const input = cb as HTMLInputElement;
      if (input.checked) {
        selectedIndices.push(parseInt(input.getAttribute('data-index') || '0', 10));
      }
    });

    if (selectedIndices.length === 0) {
      showError('Please select at least one chapter to extract.');
      return;
    }

    try {
      configSection.classList.add('hidden');
      progressSection.classList.remove('hidden');

      const result = await splitPdfByBookmarks(new Uint8Array(fileBuffer), {
        includeFrontMatter: frontmatterCheckbox.checked,
        selectedChapterIndices: selectedIndices,
      });

      generatedZipBytes = result.zipBytes;
      extractedChapterFiles = result.extractedChapters;

      zipSizeLabel.textContent = `${formatBytes(result.zipBytes.length)} (${result.extractedChapters.length} files)`;

      // Render individual download list
      individualChaptersList.innerHTML = '';
      result.extractedChapters.forEach((ch) => {
        const item = document.createElement('div');
        item.className = 'flex items-center justify-between p-3 hover:bg-slate-50 transition text-xs';
        item.innerHTML = `
          <div>
            <span class="font-bold text-slate-800">${ch.title}</span>
            <span class="block text-[11px] text-slate-400">Pages ${ch.startPage}–${ch.endPage} (${ch.pageCount} pgs) • ${formatBytes(ch.bytes.length)}</span>
          </div>
          <button type="button" class="download-chapter-btn px-3 py-1.5 text-xs font-semibold text-sky-700 bg-sky-50 hover:bg-sky-100 rounded-lg border border-sky-200 transition" data-index="${ch.index}">
            Download PDF
          </button>
        `;
        individualChaptersList.appendChild(item);
      });

      // Attach download triggers for individual files
      document.querySelectorAll('.download-chapter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
          const ch = extractedChapterFiles.find((c) => c.index === idx);
          if (ch) {
            const blob = new Blob([ch.bytes], { type: 'application/pdf' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = ch.filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(url), 1000);
          }
        });
      });

      progressSection.classList.add('hidden');
      successSection.classList.remove('hidden');
    } catch (err: any) {
      progressSection.classList.add('hidden');
      configSection.classList.remove('hidden');
      showError('Failed to split chapters: ' + (err?.message || 'Unknown processing error'));
    }
  });

  // Download Bulk ZIP
  downloadZipBtn?.addEventListener('click', () => {
    if (!generatedZipBytes || !currentFile) return;

    const baseName = currentFile.name.replace(/\.pdf$/i, '');
    const downloadFileName = `${baseName}-chapters.zip`;

    const blob = new Blob([generatedZipBytes], { type: 'application/zip' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = downloadFileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
</script>
