---
// CompressPdfIsland.astro - Interactive client-side PDF compressor
---

<div id="compress-island-app" class="w-full max-w-3xl mx-auto my-8 font-sans">
  

  <!-- Error Alert Container -->
  <div id="compress-error-banner" class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm text-left flex items-start gap-3 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
    </svg>
    <div class="flex-grow">
      <h4 class="font-bold text-red-900 mb-0.5">Compression Error</h4>
      <p id="compress-error-message" class="text-xs text-red-700 leading-relaxed"></p>
    </div>
    <button type="button" id="dismiss-compress-error" class="text-red-400 hover:text-red-700 text-sm font-bold">✕</button>
  </div>

  <!-- 1. Drop Zone (Active before file selection) -->
  <div
    id="compress-drop-zone"
    class="relative rounded-2xl border border-slate-200/90 hover:border-slate-300 bg-white shadow-sm hover:shadow-panel-hover p-8 sm:p-12 text-center transition shadow-sm hover:shadow-md cursor-pointer group"
  >
    <input
      type="file"
      id="compress-file-input"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
      accept=".pdf,application/pdf"
    />

    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-slate-100 group-hover:bg-slate-900 flex items-center justify-center text-slate-700 group-hover:text-white shadow-sm transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 group-hover:scale-110 transition duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-1.5 group-hover:text-brand-600 transition">
      Select PDF to compress
    </h3>
    <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">
      Drag & drop your PDF file here, or click to choose from your device.
    </p>

    <div class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 group-hover:bg-slate-800 rounded-xl shadow-button transition duration-150">
      Choose PDF File
    </div>

    <div class="mt-6 flex items-center justify-center gap-4 text-xs text-slate-400">
      <span>Cap: Max 100MB</span>
      <span>•</span>
      <span>100% In-Browser</span>
    </div>
  </div>

  <!-- 2. Selected File & Settings Configuration -->
  <div id="compress-settings-section" class="hidden bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm text-left">
    <!-- Selected File Header -->
    <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-200 mb-6">
      <div class="flex items-center gap-3 min-w-0 pr-2">
        <div class="w-10 h-10 rounded-lg bg-brand-100 text-slate-700 flex items-center justify-center flex-shrink-0 font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="min-w-0">
          <p id="selected-file-name" class="text-sm font-bold text-slate-900 truncate">document.pdf</p>
          <p id="selected-file-size" class="text-xs text-slate-500">0 KB</p>
        </div>
      </div>
      <button
        type="button"
        id="change-file-btn"
        class="text-xs font-semibold text-slate-500 hover:text-red-600 px-3 py-1.5 rounded-lg border border-slate-200 hover:border-red-200 transition"
      >
        Change File
      </button>
    </div>

    <!-- Mandatory Honesty Disclaimer (Part 4 of Project Pack) -->
    <div class="mb-6 p-3.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-800 flex items-start gap-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      <div>
        <span class="font-bold">Image-based compression:</span> Pages are re-rendered and downscaled into optimized images. Embedded text in the compressed output will not remain selectable.
      </div>
    </div>

    <!-- Compression Presets -->
    <h4 class="text-sm font-bold text-slate-900 mb-3">Select Compression Level</h4>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
      <!-- Extreme -->
      <label class="preset-card cursor-pointer p-4 rounded-xl border-2 border-slate-200 hover:border-brand-400 bg-white transition flex flex-col justify-between">
        <input type="radio" name="compression-level" value="extreme" class="sr-only" />
        <div>
          <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 mb-2">
            Extreme
          </span>
          <h5 class="text-sm font-bold text-slate-800 mb-1">Max Reduction</h5>
          <p class="text-xs text-slate-500 leading-relaxed">Lowest file size, standard image resolution.</p>
        </div>
      </label>

      <!-- Recommended (Active by default) -->
      <label class="preset-card cursor-pointer p-4 rounded-xl border-2 border-brand-500 bg-brand-50/30 transition flex flex-col justify-between relative shadow-sm">
        <input type="radio" name="compression-level" value="recommended" class="sr-only" checked />
        <div>
          <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-brand-100 text-brand-800 mb-2">
            Recommended
          </span>
          <h5 class="text-sm font-bold text-slate-900 mb-1">Balanced</h5>
          <p class="text-xs text-slate-500 leading-relaxed">Optimal trade-off between clarity and size.</p>
        </div>
      </label>

      <!-- Light -->
      <label class="preset-card cursor-pointer p-4 rounded-xl border-2 border-slate-200 hover:border-brand-400 bg-white transition flex flex-col justify-between">
        <input type="radio" name="compression-level" value="light" class="sr-only" />
        <div>
          <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-700 mb-2">
            Light
          </span>
          <h5 class="text-sm font-bold text-slate-800 mb-1">High Quality</h5>
          <p class="text-xs text-slate-500 leading-relaxed">Sharpest artwork with moderate file savings.</p>
        </div>
      </label>
    </div>

    <!-- Action Button -->
    <div class="flex items-center justify-end">
      <button
        type="button"
        id="start-compress-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-semibold text-xs text-white bg-slate-900 hover:bg-slate-800 active:scale-[0.98] shadow-button transition flex items-center justify-center gap-2"
      >
        <span>Compress PDF Now</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 3. Progress State -->
  <div id="compress-progress-section" class="hidden bg-white rounded-2xl border border-slate-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-brand-50 flex items-center justify-center text-brand-600">
      <svg class="animate-spin w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
    </div>

    <h3 class="text-lg font-bold text-slate-800 mb-1">Compressing PDF...</h3>
    <p id="compress-progress-message" class="text-xs text-slate-500 mb-6 font-medium">Rendering pages in browser memory...</p>

    <!-- Progress Bar -->
    <div class="w-full max-w-md mx-auto bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200">
      <div id="compress-progress-bar-fill" class="bg-blue-600 h-full w-0 rounded-full transition-all duration-300"></div>
    </div>
    <span id="compress-progress-percent" class="block text-xs font-semibold text-slate-700 mt-2">0%</span>
  </div>

  <!-- 4. Success State -->
  <div id="compress-success-section" class="hidden bg-white rounded-2xl border border-emerald-200 p-8 sm:p-12 text-center shadow-sm">
    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
    </div>

    <h3 class="text-2xl font-extrabold text-slate-900 mb-2">PDF Compressed Successfully!</h3>
    
    <!-- Savings Summary Card -->
    <div class="max-w-md mx-auto my-6 p-4 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-around text-center">
      <div>
        <span class="block text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Original</span>
        <span id="stat-original-size" class="text-sm font-bold text-slate-700">0 KB</span>
      </div>
      <div class="text-slate-300 text-xl font-light">→</div>
      <div>
        <span class="block text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Compressed</span>
        <span id="stat-compressed-size" class="text-sm font-bold text-emerald-600">0 KB</span>
      </div>
      <div class="pl-2 border-l border-slate-200">
        <span id="stat-saved-percent" class="inline-block px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
          -0%
        </span>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <button
        type="button"
        id="compress-download-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 shadow-md shadow-emerald-500/20 transition flex items-center justify-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Download Compressed PDF</span>
      </button>

      <button
        type="button"
        id="compress-reset-btn"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition"
      >
        Compress Another File
      </button>
    </div>
  </div>
</div>

<script>
  import { compressPdfFile, type CompressionLevel } from '../../lib/pdf/compress';
  import { MAX_FILE_SIZE_BYTES } from '../../lib/pdf/merge';

  let selectedFile: File | null = null;
  let compressedBlobUrl: string | null = null;

  // DOM elements
  const dropZone = document.getElementById('compress-drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('compress-file-input') as HTMLInputElement;
  const settingsSection = document.getElementById('compress-settings-section') as HTMLDivElement;
  const selectedFileNameEl = document.getElementById('selected-file-name') as HTMLParagraphElement;
  const selectedFileSizeEl = document.getElementById('selected-file-size') as HTMLParagraphElement;
  const changeFileBtn = document.getElementById('change-file-btn') as HTMLButtonElement;
  const startCompressBtn = document.getElementById('start-compress-btn') as HTMLButtonElement;

  const errorBanner = document.getElementById('compress-error-banner') as HTMLDivElement;
  const errorMessage = document.getElementById('compress-error-message') as HTMLParagraphElement;
  const dismissErrorBtn = document.getElementById('dismiss-compress-error') as HTMLButtonElement;

  const progressSection = document.getElementById('compress-progress-section') as HTMLDivElement;
  const progressMessage = document.getElementById('compress-progress-message') as HTMLParagraphElement;
  const progressBarFill = document.getElementById('compress-progress-bar-fill') as HTMLDivElement;
  const progressPercent = document.getElementById('compress-progress-percent') as HTMLSpanElement;

  const successSection = document.getElementById('compress-success-section') as HTMLDivElement;
  const statOriginalEl = document.getElementById('stat-original-size') as HTMLSpanElement;
  const statCompressedEl = document.getElementById('stat-compressed-size') as HTMLSpanElement;
  const statSavedPercentEl = document.getElementById('stat-saved-percent') as HTMLSpanElement;
  const downloadBtn = document.getElementById('compress-download-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('compress-reset-btn') as HTMLButtonElement;

  const presetLabels = document.querySelectorAll<HTMLLabelElement>('.preset-card');

  function formatBytes(bytes: number): string {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function showError(msg: string) {
    if (errorMessage && errorBanner) {
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function clearError() {
    if (errorBanner) errorBanner.classList.add('hidden');
  }

  dismissErrorBtn?.addEventListener('click', clearError);

  // Preset Card Highlighting
  presetLabels.forEach((label) => {
    label.addEventListener('click', () => {
      presetLabels.forEach((l) => {
        l.classList.remove('border-brand-500', 'bg-brand-50/30', 'shadow-sm');
        l.classList.add('border-slate-200', 'bg-white');
      });
      label.classList.remove('border-slate-200', 'bg-white');
      label.classList.add('border-brand-500', 'bg-brand-50/30', 'shadow-sm');
    });
  });

  function handleFileSelected(file: File) {
    clearError();
    if (file.size > MAX_FILE_SIZE_BYTES) {
      showError(
        `The file "${file.name}" (${formatBytes(file.size)}) exceeds the 100MB in-browser limit. Please select a file under 100MB.`
      );
      return;
    }

    selectedFile = file;
    selectedFileNameEl.textContent = file.name;
    selectedFileSizeEl.textContent = formatBytes(file.size);

    dropZone.classList.add('hidden');
    settingsSection.classList.remove('hidden');
  }

  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFileSelected(target.files[0]);
      target.value = '';
    }
  });

  changeFileBtn?.addEventListener('click', () => {
    selectedFile = null;
    settingsSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });

  // Drag and Drop handlers
  ['dragenter', 'dragover'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.add('border-brand-500', 'bg-brand-50/40');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    dropZone?.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-brand-500', 'bg-brand-50/40');
    });
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      handleFileSelected(e.dataTransfer.files[0]);
    }
  });

  // Start Compression
  startCompressBtn?.addEventListener('click', async () => {
    if (!selectedFile) return;

    const checkedRadio = document.querySelector<HTMLInputElement>('input[name="compression-level"]:checked');
    const level = (checkedRadio?.value || 'recommended') as CompressionLevel;

    settingsSection.classList.add('hidden');
    progressSection.classList.remove('hidden');
    clearError();

    try {
      const result = await compressPdfFile(selectedFile, level, (prog) => {
        progressMessage.textContent = prog.message;
        progressBarFill.style.width = `${prog.percent}%`;
        progressPercent.textContent = `${prog.percent}%`;
      });

      const blob = new Blob([result.bytes], { type: 'application/pdf' });
      if (compressedBlobUrl) URL.revokeObjectURL(compressedBlobUrl);
      compressedBlobUrl = URL.createObjectURL(blob);

      statOriginalEl.textContent = formatBytes(result.originalSize);
      statCompressedEl.textContent = formatBytes(result.compressedSize);
      statSavedPercentEl.textContent = `-${result.savedPercentage}%`;

      // Auto trigger download
      triggerDownload();

      progressSection.classList.add('hidden');
      successSection.classList.remove('hidden');
    } catch (err: any) {
      progressSection.classList.add('hidden');
      settingsSection.classList.remove('hidden');
      showError(err.message || 'An error occurred during PDF compression.');
    }
  });

  function triggerDownload() {
    if (!compressedBlobUrl || !selectedFile) return;
    const a = document.createElement('a');
    a.href = compressedBlobUrl;
    const baseName = selectedFile.name.replace(/\.[^/.]+$/, '');
    a.download = `${baseName}-compressed.pdf`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  downloadBtn?.addEventListener('click', triggerDownload);

  resetBtn?.addEventListener('click', () => {
    selectedFile = null;
    if (compressedBlobUrl) {
      URL.revokeObjectURL(compressedBlobUrl);
      compressedBlobUrl = null;
    }
    successSection.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });
</script>
