---
const currentYear = new Date().getFullYear();
---

<footer class="bg-obsidian-950 text-slate-400 border-t border-slate-800/80 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand & Security Guarantee -->
      <div class="md:col-span-2 pr-0 md:pr-10">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-7 h-7 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-xs shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <span class="text-base font-bold text-white tracking-tight">PDF<span class="text-blue-500">Zero</span></span>
        </div>
        <p class="text-xs text-slate-400 mb-5 leading-relaxed max-w-sm">
          High-performance, privacy-first PDF utilities engineered entirely with client-side WebAssembly and modern JavaScript. Your files are processed locally in your browser memory and never uploaded to any server.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-[11px] text-emerald-400 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>100% In-Browser Engine · Air-Gap Capable</span>
        </div>
      </div>

      <!-- Col 2: Core Tools -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.15em] text-slate-300 font-semibold mb-4">Core Tools</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/tools/merge-pdf" class="hover:text-white transition">Merge PDF</a></li>
          <li><a href="/tools/compress-pdf" class="hover:text-white transition">Compress PDF</a></li>
          <li><a href="/tools/split-pdf" class="hover:text-white transition">Split PDF</a></li>
          <li><a href="/tools/rotate-pdf" class="hover:text-white transition">Rotate PDF</a></li>
          <li><a href="/tools/protect-pdf" class="hover:text-white transition">Protect PDF</a></li>
          <li><a href="/tools/unlock-pdf" class="hover:text-white transition">Unlock PDF</a></li>
          <li><a href="/tools/jpg-to-pdf" class="hover:text-white transition">JPG to PDF</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Support -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.15em] text-slate-300 font-semibold mb-4">Legal & Support</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/about" class="hover:text-white transition">About PDFZero</a></li>
          <li><a href="/privacy" class="hover:text-white transition">Privacy Policy & Cookies</a></li>
          <li><a href="/terms" class="hover:text-white transition">Terms of Service</a></li>
          <li><a href="/contact" class="hover:text-white transition">Contact Us</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} PDFZero. Built for privacy, speed, and simplicity.</p>
      <p>Free online tools for everyone. No registration required.</p>
    </div>
  </div>
</footer>
