---
const currentYear = new Date().getFullYear();
---

<footer class="bg-obsidian-950 text-slate-400 border-t border-slate-800/80 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      <!-- Col 1: Brand & Security Guarantee -->
      <div class="sm:col-span-2 lg:col-span-1 pr-0 lg:pr-4">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-7 h-7 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-xs shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <span class="text-base font-bold text-white tracking-tight">Air<span class="text-blue-500">PDF</span></span>
        </div>
        <p class="text-xs text-slate-400 mb-5 leading-relaxed">
          High-performance, privacy-first PDF utilities engineered entirely with client-side WebAssembly and JavaScript. Zero cloud uploads.
        </p>
        <p class="text-[11px] font-mono text-slate-500">
          Local engine · Zero server storage · Offline ready
        </p>
      </div>

      <!-- Col 2: Organize & Layout -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.15em] text-slate-300 font-semibold mb-4">Organize & Layout</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/tools/merge-pdf" class="hover:text-white transition">Merge PDF</a></li>
          <li><a href="/tools/edit-pdf" class="hover:text-white transition">Edit PDF Online</a></li>
          <li><a href="/tools/split-pdf" class="hover:text-white transition">Split PDF</a></li>
          <li><a href="/tools/rotate-pdf" class="hover:text-white transition">Rotate PDF</a></li>
          <li><a href="/tools/page-numbers" class="hover:text-white transition">Page Numbers</a></li>
          <li><a href="/tools/booklet-pdf" class="hover:text-white transition">Booklet Creator</a></li>
          <li><a href="/tools/nup-pdf" class="hover:text-white transition">N-Up Imposer (2/4/8/16-Up)</a></li>
          <li><a href="/tools/crop-pdf" class="hover:text-white transition">Crop & Trim</a></li>
          <li><a href="/tools/bookmarks-pdf" class="hover:text-white transition">Bookmarks / TOC</a></li>
          <li><a href="/tools/split-by-bookmarks" class="hover:text-white transition">Split by Chapters</a></li>
          <li><a href="/tools/header-footer-pdf" class="hover:text-white transition">Headers & Footers</a></li>
          <li><a href="/tools/overlay-pdf" class="hover:text-white transition">Overlay & Letterhead</a></li>
          <li><a href="/tools/bates-numbering" class="hover:text-white transition">Bates Numbering</a></li>
          <li><a href="/tools/flatten-pdf" class="hover:text-white transition">Flatten Forms</a></li>
          <li><a href="/tools/split-spread-pdf" class="hover:text-white transition">Two-Page Spread Cutter</a></li>
          <li><a href="/tools/poster-pdf" class="hover:text-white transition">Poster Maker (Home Tiler)</a></li>
          <li><a href="/tools/auto-crop-pdf" class="hover:text-white transition">Auto-Crop White Margins</a></li>
        </ul>
      </div>

      <!-- Col 3: Optimize & Repair -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.15em] text-slate-300 font-semibold mb-4">Optimize & Repair</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/tools/compress-pdf" class="hover:text-white transition">Compress PDF</a></li>
          <li><a href="/tools/repair-pdf" class="hover:text-white transition">Repair Corrupt PDF</a></li>
          <li><a href="/tools/remove-watermark" class="hover:text-white transition">Remove Watermark</a></li>
          <li><a href="/tools/ocr-pdf" class="hover:text-white transition">Privacy OCR (Searchable)</a></li>
          <li><a href="/tools/grayscale-pdf" class="hover:text-white transition">Grayscale & Ink Saver</a></li>
          <li><a href="/tools/resize-pdf" class="hover:text-white transition">Resize & Expand Margins</a></li>
          <li><a href="/tools/linearize-pdf" class="hover:text-white transition">Fast Web View (Linearize)</a></li>
          <li><a href="/tools/deskew-pdf" class="hover:text-white transition">Deskew & Straighten</a></li>
          <li><a href="/tools/measure-pdf" class="hover:text-white transition">Blueprint Scale & Measure</a></li>
          <li><a href="/tools/downsample-pdf" class="hover:text-white transition">DPI Downsampler (72/150/300)</a></li>
        </ul>
      </div>

      <!-- Col 4: Security & Convert -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.15em] text-slate-300 font-semibold mb-4">Security & Convert</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/tools/protect-pdf" class="hover:text-white transition">Password Protect</a></li>
          <li><a href="/tools/unlock-pdf" class="hover:text-white transition">Unlock PDF</a></li>
          <li><a href="/tools/recover-pdf-password" class="hover:text-white transition">Recover Password</a></li>
          <li><a href="/tools/redact-pdf" class="hover:text-white transition">True PDF Redactor</a></li>
          <li><a href="/tools/metadata-pdf" class="hover:text-white transition">Metadata Sanitizer</a></li>
          <li><a href="/tools/sign-pkcs-pdf" class="hover:text-white transition">Digital Signature (PKCS#7)</a></li>
          <li><a href="/tools/reader-pdf" class="hover:text-white transition">PDF Audio Reader (TTS)</a></li>
          <li><a href="/tools/dark-mode-pdf" class="hover:text-white transition">Dark Mode Inverter</a></li>
          <li><a href="/tools/compare-pdf" class="hover:text-white transition">Visual Diff Comparator</a></li>
          <li><a href="/tools/pdf-to-jpg" class="hover:text-white transition">PDF to JPG</a></li>
          <li><a href="/tools/jpg-to-pdf" class="hover:text-white transition">JPG to PDF</a></li>
          <li><a href="/tools/pdf-to-word" class="hover:text-white transition">PDF to Word</a></li>
          <li><a href="/tools/pdf-to-csv" class="hover:text-white transition">PDF to CSV (Tables)</a></li>
        </ul>
      </div>

      <!-- Col 5: Legal & Support -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.15em] text-slate-300 font-semibold mb-4">Company & Legal</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/about" class="hover:text-white transition">About AirPDF</a></li>
          <li><a href="/privacy" class="hover:text-white transition">Privacy Architecture</a></li>
          <li><a href="/terms" class="hover:text-white transition">Terms of Service</a></li>
          <li><a href="/contact" class="hover:text-white transition">Contact Us</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} AirPDF. Built for privacy, speed, and simplicity.</p>
      <p>33 Free In-Browser PDF utilities for everyone. No registration required.</p>
    </div>
  </div>
</footer>
